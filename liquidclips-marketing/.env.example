# v0.7.59 — Clerk env required for native /sign-in, /sign-up, /connect-desktop.
# Mirror the values that account-app uses (same Clerk project, primary
# domain = liquidclips.app, satellites = account.liquidclips.app).
#
# Set in Vercel for the marketing project before redeploying v0.7.59:
#   vercel env add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY production
#   vercel env add CLERK_SECRET_KEY production
#
# Local dev: copy this file to .env.local and fill in the real values
# (don't commit .env.local).

# Publishable key (safe to expose).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_…

# Secret key (server-side only — never commit, never expose).
CLERK_SECRET_KEY=sk_live_…

# Path overrides — keep in lockstep with the native pages in
# src/app/sign-in, src/app/sign-up, src/app/connect-desktop.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/connect-desktop
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/connect-desktop

# Sentry — already wired in next.config.ts. Optional; leave unset locally.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Domain config (consumed by src/lib/env.ts) ──────────────────────────
# Every URL on the site reads through these. Change here, deploy, done.
# Defaults baked into env.ts cover prod (liquidclips.app); set these on
# Vercel only when you point at a different host (preview / staging).
# NEXT_PUBLIC_SITE_URL=https://liquidclips.app
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@liquidclips.app
# NEXT_PUBLIC_PRODUCT_HUNT_URL=https://www.producthunt.com/posts/liquid-clips
# NEXT_PUBLIC_GITHUB_REPO=Powstit/liquidclips
# NEXT_PUBLIC_PARTNER_URL=https://partner.jnremployee.com

# ── Postgres (Neon via Vercel Marketplace · Phase 2) ────────────────────
# Auto-injected by the Vercel Neon integration when you connect a database
# in Storage. Local dev: pull with `vercel env pull .env.local`.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# ── Analytics (Phase 6) ─────────────────────────────────────────────────
# Vercel Analytics needs no env vars (auto-enabled when @vercel/analytics
# is mounted). PostHog needs project key + host:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
