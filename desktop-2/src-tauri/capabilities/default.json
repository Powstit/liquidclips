{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capabilities for the 2.0 shell. IRON GATE IG-CAPS-AUDIT · LOCKED 2026-07-20 · every imported @tauri-apps/plugin-* MUST have a matching :default (or narrower) grant here. lint-tauri-capabilities-audit.sh + tauriCapabilitiesAudit.test.ts enforce this.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-close",
    "deep-link:default",
    "fs:default",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:allow-exists",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "process:default",
    "process:allow-restart",
    "shell:default",
    "shell:allow-open",
    "updater:default",
    "updater:allow-check"
  ]
}
