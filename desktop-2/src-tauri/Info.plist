<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-08-18 · required for Community's voice calls (getUserMedia).
	     Without this key macOS never shows the mic permission prompt at
	     all — it just silently denies, which is exactly what shipped in
	     2.3.32 and is why "Join voice" failed with no system dialog.
	     Tauri auto-merges this file into the bundled Info.plist. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Liquid Clips needs microphone access so you can talk in Community voice channels.</string>
	<!-- Phase 2 · macOS native Contacts migration (2026-09-07). Only the
	     helper process spawned by contacts_picker.rs touches Contacts,
	     and only via CNContactPicker — a picker UI that hands back one
	     explicitly-selected contact, not bulk address-book access. -->
	<key>NSContactsUsageDescription</key>
	<string>Liquid Clips needs access to your contacts so you can choose people to invite.</string>
</dict>
</plist>
