{
  "$schema": "liquid-clips/motion-loop@1",
  "name": "loader-ayrshare-handoff",
  "use": "publish queued to Ayrshare — platform glyph pulses with signal beam to destination",
  "type": "loop",
  "duration_ms": 1500,
  "easing": "cubic-bezier(.4,0,.6,1)",
  "renderable": ["lottie", "css-overlay"],
  "variants": {
    "youtube":   { "tint": "#FF0000", "glyph": "platform/youtube.svg" },
    "tiktok":    { "tint": "#FFFFFF", "glyph": "platform/tiktok.svg" },
    "instagram": { "tint": "#E4405F", "glyph": "platform/instagram.svg" },
    "x":         { "tint": "#FFFFFF", "glyph": "platform/x.svg" }
  },
  "layers": [
    {
      "name": "platform-glyph",
      "size_px": 56,
      "anchor_xy_rel": [0.5, 0.5],
      "alpha_curve": [0.65, 1.0, 0.65],
      "scale_curve": [1.0, 1.08, 1.0]
    },
    {
      "name": "signal-beam",
      "shape": "beam",
      "from_xy_rel": [0.5, 0.5],
      "to_xy_rel":   [0.5, 0.08],
      "color_mix": { "rgb(255,26,140)": 0.55, "rgb(255,143,203)": 0.45 },
      "stroke_width_px": 4,
      "blend": "screen",
      "alpha_curve": [0.3, 0.9, 0.3]
    },
    {
      "name": "ring-pulse",
      "shape": "ring",
      "outer_radius_rel": [0.5, 0.78],
      "inner_radius_rel": [0.48, 0.74],
      "tint": "#FF66B8",
      "alpha_curve": [0.0, 0.6, 0.0]
    }
  ],
  "copy_anchor": "SENDING TO {platform}…",
  "respects_reduced_motion": "static_glyph_with_dim_beam",
  "pause_when_hidden": true
}
