{
  "name": "liquid-clips-shell",
  "private": true,
  "version": "2.3.31",
  "type": "module",
  "description": "Liquid Clips 2.0 shell — design-OS routes + real Python sidecar wire (BUG-017 clip_count, IG-001/002/010).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "guard": "bash scripts/assert-shell-contracts.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:user-lens": "playwright test",
    "test:user-lens:reaction": "playwright test reaction-journey",
    "verify-app": "playwright test && node scripts/verify-app.mjs",
    "verify-app:report": "node scripts/verify-app.mjs",
    "test:invariant": "tsc -b && bash scripts/assert-shell-contracts.sh && bash scripts/brand-kit-drift-check.sh && bash scripts/iron-gates/agency-preview-paywall.sh && npm run verify-app"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "@remotion/player": "^4.0.485",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@whop/checkout": "^0.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.471.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.485",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
