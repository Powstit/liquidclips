# Junior mono-repo — root gitignore. Per-project .gitignores layer on top.
# This file's job is the universal stuff: secrets, build artefacts, OS dust.

# --- Clip data (never commit — this is real user video output) -------------
# 2026-08-09 · CLIPS_HOME defaults to ~/LiquidClips. On this machine (and any
# machine where the repo checkout sits directly at ~/liquidclips) macOS's
# default case-insensitive filesystem makes ~/LiquidClips and ~/liquidclips
# the SAME directory, so every real clip run lands inside the repo working
# tree as untracked "projects/" here. Never committed so far, but this is a
# standing risk (`git add -A`/`git add .` would stage gigabytes of user
# video). Ignored regardless of the collision so it's never a live risk.
/projects/
# Same collision, different subdirectory — CLIPS_HOME/inbox is where source
# downloads land before ingest (e.g. the .mp4 pulled from a pasted YouTube
# URL). Same real-user-data, never-commit rule as /projects/ above.
/inbox/

# --- Secrets (NEVER commit) -------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc
env.md
ENV.md
*.env.md

# Keychain / credentials stores from this machine that may exist alongside.
.claude-credentials/
.claude/

# License signing keys generated locally on first backend boot.
.junior-keys/

# --- Node / Vite ------------------------------------------------------------
node_modules/
dist/
build/
.next/
.turbo/
out/
.vercel/
*.tsbuildinfo

# --- Rust / Tauri (the 11 GB beast) -----------------------------------------
target/
**/src-tauri/gen/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- ML models bundled at build time (75 MB faster-whisper) -----------------
# Pull these from the build script — don't commit the binaries.
desktop/python-sidecar/models/
desktop/python-sidecar/bin/ffmpeg
desktop/python-sidecar/bin/ffprobe

# Repo-root python-sidecar (separate tree from desktop/python-sidecar)
# v0.7.80 ship.sh blocker: the same bundled binaries live here too,
# fetched in CI by .github/workflows/release.yml — never commit.
python-sidecar/bin/
python-sidecar/models/
# Watermark + wordmark assets under python-sidecar/assets/ are bundled Tauri
# resources (tauri.conf.json bundle.resources). They MUST be tracked so CI
# builds include them. Do NOT re-add wildcards over assets/ — broad globs
# silently break the signed-release pipeline. Reference: ship 2.2.1 + 2.2.2
# failures (29 Jun 2026) caused by gitignored bundle resources.

# --- Test results / Playwright + Vitest artifacts ---------------------------
test-results/
**/test-results/
playwright-report/
**/playwright-report/
**/tests/e2e/boot-baseline-*.json

# --- Tauri build outputs ----------------------------------------------------
*.dmg
*.app.tar.gz
*.app.tar.gz.sig

# --- IDE / OS noise ---------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
Thumbs.db

# --- Local logs + sqlite ----------------------------------------------------
*.log
*.sqlite
*.sqlite3
*.db

# --- Project-specific local state -------------------------------------------
junior-backend/junior.db
junior-backend/.junior-keys/

# Cache from the desktop's user-data area in case anyone symlinks it in.
desktop/.cache/

