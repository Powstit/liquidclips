#!/usr/bin/env bash
# Pre-commit gate — runs every guardrail in sequence. Any single guard
# failing aborts the commit.
#
#   1. check-humanError         — `String(e)` / `String(err)` regression guard.
#   2. iron-gate-precommit      — refuses deletion of IRON GATE sentinels.
#   3. assert-no-passive-keychain — auth-keychain invariant (IG-014).
#   4. brand-kit-drift-check    — token parity between index.css + demo HTML.
#   5. lint-kade-decoupling     — Sprint G.5 · onboarding:milestone emitter-only rule.
#   6. assert-shell-contracts    — in-app navigation, shell, auth, and brand contracts.
#   7. assert-kade-anchor         — [data-kade-anchor] presence on every primary route so StickyKade's mini-mode transition works.
#   8. lint-session-reset-guard  — IG-014-B · locks the clearJwtKeychainForAuthAction contract (Promise<boolean> + lcDiag emission) so the "stuck keychain" bug never regresses.
#   9. lint-otp-observable       — IG-OTP-A/B/C · locks the observable OTP mailer + honest /start response + non-silent frontend advance so the "code arrived 5 min after login failed" bug never regresses.
#  10. lint-composer-miss-diag   — IG-COMPOSER-MISS-DIAG · miss telemetry visibility.
#  11. lint-no-silent-sidecar    — IG-SIDECAR-CATCH · high-stakes sidecar calls carry .catch / try.
#  12. lint-no-bare-unwrap-commands — IG-UNWRAP-CMD · no bare .unwrap() inside #[tauri::command] bodies.
#  13. lint-tauri-capabilities-audit — IG-CAPS-AUDIT · plugin import ↔ permission grant parity (ADVISORY).
#  14. lint-tauri-async-commands — IG-ASYNC-CMD · every #[tauri::command] is async fn.
#  15. lint-rust-panic-production — IG-RUST-PANIC · no bare panic sites outside command bodies.
#  16. lint-auth-broker — IG-AUTH-KEYCHAIN · single-broker invariant for secret_*_jwt.
#  17. lint-forbidden-shortcuts — IG-AUTH-KEYCHAIN L5 · no codesign --force / rsync /Applications / security del-generic-password shortcuts outside allowlist.
#  18. lint-runtime-hotswap — IG-RUNTIME-HOTSWAP · UpdateBeacon must reload on lc:runtime-staged within boot window so users see the newest bundle on FIRST relaunch, not the second.
#
# Hook lives at `.githooks/pre-commit`; `git config core.hooksPath .githooks`
# points the repo at it.
set -uo pipefail
# Resolve to ABSOLUTE paths up front so the per-guard `cd` doesn't break
# relative references when we hop into desktop/.
HOOK_DIR="$( cd "$(/usr/bin/dirname "$0")" && /bin/pwd )"
REPO_ROOT="$( cd "$HOOK_DIR/.." && /bin/pwd )"
DESKTOP_ROOT="$REPO_ROOT/desktop"
DESKTOP_SCRIPTS="$DESKTOP_ROOT/scripts"
# Sprint G.5 · desktop-2 lint scripts. Separate from `desktop/` (legacy)
# so a repo that only checks out desktop-2 still runs the Kade
# decoupling gate.
DESKTOP2_ROOT="$REPO_ROOT/desktop-2"
DESKTOP2_SCRIPTS="$DESKTOP2_ROOT/scripts"

run_guard() {
  local cwd=$1
  local script=$2
  shift 2
  if [ ! -x "$script" ]; then
    return 0   # guard missing on this branch — skip rather than block.
  fi
  ( cd "$cwd" && "$script" "$@" )
  local rc=$?
  if [ $rc -ne 0 ]; then
    /bin/echo "✗ pre-commit: $script failed (exit $rc)" >&2
    exit $rc
  fi
}

# check-humanError + iron-gate-precommit both walk staged diffs, so they
# can run from repo root. brand-kit-drift-check + assert-no-passive-keychain
# resolve paths relative to desktop/ — run them from there.
run_guard "$REPO_ROOT"    "$DESKTOP_SCRIPTS/check-humanError.sh" "$@"
run_guard "$REPO_ROOT"    "$DESKTOP_SCRIPTS/iron-gate-precommit.sh" "$@"
run_guard "$DESKTOP_ROOT" "$DESKTOP_SCRIPTS/assert-no-passive-keychain.sh" "$@"
run_guard "$DESKTOP_ROOT" "$DESKTOP_SCRIPTS/brand-kit-drift-check.sh" "$@"
# Sprint G.5 · Kade decoupling — refuses commits that emit
# `onboarding:milestone` outside `desktop-2/src/lib/onboardingEmitter.ts`.
# Skipped silently on branches where the desktop-2/ directory is absent
# (run_guard short-circuits on missing executables).
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-kade-decoupling.sh" "$@"
# Pre-push shell contract · catches direct target=_blank/window.open
# bypasses and the wider desktop-2 launch invariants.
run_guard "$DESKTOP2_ROOT" "$DESKTOP2_SCRIPTS/assert-shell-contracts.sh" "$@"
# Kade anchor coverage · asserts every primary route surface declares
# [data-kade-anchor] so StickyKade's IntersectionObserver flips to
# top-right mini mode on scroll. Locked after 2026-07-03 regression
# where Home, Workstation, Community, and Campaign Builder all
# silently lacked the anchor.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/assert-kade-anchor.sh" "$@"
# IG-014-B · session-reset regression guard · locks the auth keychain
# purge helper's contract (Promise<boolean> + lcDiag emission) and the
# SessionResetButton mount inside SimpleLoginPanel. Reverts to the old
# silent-swallow void signature fail here.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-session-reset-guard.sh" "$@"
# IG-OTP-A/B/C · observable OTP send guard · locks the mailer + /start +
# frontend contract so the "code arrived 5 min after login failed" bug
# never reintroduces. Feedback memory reference: `feedback_never_regress
# _4_layer_defense.md` · this is the Layer-2 grep gate for that fix.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-otp-observable.sh" "$@"
# IG-COMPOSER-MISS-DIAG · Composer miss visibility guard · 2026-07-19.
# Locks the query_text payload on capability_route_miss + frame.hook not
# claiming aspect intents. Reference: /admin/bugs showing 22 opaque miss
# events in one morning (event=feature_failed, message=null) before this
# gate landed.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-composer-miss-diag.sh" "$@"
# IG-SIDECAR-CATCH · silent-sidecar-hang guard · 2026-07-19. Locks the
# 5-layer defense against `void sidecar.<method>(...)` / bare `void
# invoke(...)` / high-stakes sidecar calls with no .catch. Reference:
# Composer.tsx:559 shipped 5-minute silent hang · feedback_never_regress
# _4_layer_defense.md. Layers:
#   Layer 1 · desktop-2/src/lib/sidecarSafe.ts wrapper
#   Layer 2 · this grep-guard
#   Layer 3 · desktop-2/src/lib/sidecarCatchAudit.test.ts vitest
#   Layer 4 · AppShell.tsx onReject runtime observer
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-no-silent-sidecar.sh" "$@"
# IG-UNWRAP-CMD · no bare .unwrap() inside #[tauri::command] fn bodies ·
# 2026-07-20. Panics inside a command surface as "the app just quit"
# with no JS error, no lcDiag emission, no toast. The fence walks every
# #[tauri::command] body, flags any bare .unwrap(), and requires an
# UNWRAP-OK: sentinel escape for genuinely-infallible calls. Belt-and-
# braces vitest at desktop-2/src/lib/tauriCommandsUnwrapAudit.test.ts.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-no-bare-unwrap-commands.sh" "$@"
# IG-CAPS-AUDIT · Tauri v2 capabilities parity audit · 2026-07-20.
# ADVISORY only — prints a plugin/invoke parity table + never fails the
# commit (fixing an over-permissive grant needs human judgement on the
# security surface). Hard-fail belongs to the vitest at desktop-2/src/
# lib/tauriCapabilitiesAudit.test.ts which asserts every imported
# @tauri-apps/plugin-* has a matching permission grant.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-tauri-capabilities-audit.sh" "$@"
# IG-ASYNC-CMD · every #[tauri::command] is async fn · 2026-07-20.
# Sync commands run on the main thread; async siblings run on tokio.
# Mixing the two creates subtle deadlocks — GitButler standard is
# "async everything" for uniform dispatch semantics. Escape via
# SYNC-OK: sentinel comment above the attribute. Vitest twin at
# desktop-2/src/lib/tauriAsyncCommandsAudit.test.ts.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-tauri-async-commands.sh" "$@"
# IG-RUST-PANIC · no bare panic sites in production Rust · 2026-07-20.
# Sister of IG-UNWRAP-CMD but covers everything OUTSIDE #[tauri::command]
# bodies: setup closures, main(), helpers, HTTP handlers. Excludes #[test]
# and #[cfg(test)] mod blocks. Grandfathered sites live in
# desktop-2/scripts/rust-panic-baseline.txt. Vitest twin at
# desktop-2/src/lib/rustPanicProductionAudit.test.ts.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-rust-panic-production.sh" "$@"
# IG-AUTH-KEYCHAIN · single-broker invariant · 2026-07-20. No component
# may invoke("secret_{get,set,delete}_jwt") directly — all credential I/O
# must route through desktop-2/src/lib/authStorage.ts (which honours the
# kill-switch and enforces transactional presence-file order). The read-
# only invoke("secret_presence_get") is intentionally NOT gated because
# it never prompts and doesn't touch Keychain. Vitest twin at
# desktop-2/src/lib/authBrokerAudit.test.ts.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-auth-broker.sh" "$@"
# IG-AUTH-KEYCHAIN L5 · forbidden-shortcut scanner · 2026-07-20. Bans
# codesign --force --deep, rsync ... /Applications, and every
# `security *-generic-password` variant from shipping scripts / docs.
# Allowlist at the top of the script covers the release signing step
# and the SessionResetButton copy-paste affordance.
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-forbidden-shortcuts.sh" "$@"
# IG-RUNTIME-HOTSWAP · UpdateBeacon reload wire · 2026-07-20. Without
# the reload wire, users see the PREVIOUSLY-staged runtime bundle
# after quit + relaunch because the webview loaded index.html BEFORE
# the Rust background task flipped current.json to the new bundle.
# The reload triggers a re-fetch through the URI scheme handler which
# reads from a live RwLock already refreshed by the Rust side — so
# users pick up new bundles on the FIRST relaunch instead of the
# second. Boot-window guard preserves BUG-012 (no mid-session swap).
run_guard "$REPO_ROOT"    "$DESKTOP2_SCRIPTS/lint-runtime-hotswap.sh" "$@"
