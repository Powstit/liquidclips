, 102, 184, 0.18);\n  animation: lc-payouts-beta-pulse 2.4s ease-in-out infinite;\n}\n@keyframes lc-payouts-beta-pulse {\n  0%, 100% {\n    opacity: 0.6;\n    transform: scale(0.92);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1.06);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-payouts-beta-badge::before {\n    animation: none;\n  }\n}\nbody[data-app-mode=\"agency\"] {\n  --lc-accent: var(--lc-accent-cyan);\n  --lc-accent-deep: var(--lc-accent-cyan-deep);\n}\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\nhtml, body, #root {\n  height: 100%;\n}\nbody {\n  background: var(--color-paper);\n  color: var(--color-ink);\n  font-family: var(--font-sans);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  user-select: none;\n  cursor: default;\n  overflow: hidden;\n}\nh1, h2, h3 {\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n  line-height: 1.55;\n}\nbutton {\n  font: inherit;\n  color: inherit;\n  background: transparent;\n  border: 0;\n  cursor: pointer;\n}\nimg {\n  display: block;\n  -webkit-user-drag: none;\n  user-select: none;\n}\ninput, textarea, code, pre {\n  user-select: text;\n  font: inherit;\n  color: inherit;\n}\n.lc-aurora {\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  z-index: 0;\n  overflow: hidden;\n  background: var(--color-paper);\n}\n.lc-aurora-blobs {\n  position: absolute;\n  inset: -20%;\n  background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(255, 26, 140, 0.28), transparent 60%), radial-gradient(ellipse 70% 45% at 20% 110%, rgba(140, 40, 255, 0.22), transparent 60%), radial-gradient(ellipse 70% 45% at 90% 90%, rgba(255, 90, 80, 0.18), transparent 60%);\n  animation: lc-aurora-pulse 14s ease-in-out infinite alternate;\n}\n@keyframes lc-aurora-pulse {\n  0% {\n    transform: translate3d(-2%, -1%, 0) scale(1);\n    opacity: 1;\n  }\n  50% {\n    transform: translate3d(2%, 1%, 0) scale(1.05);\n    opacity: 0.9;\n  }\n  100% {\n    transform: translate3d(0%, -2%, 0) scale(1.02);\n    opacity: 1;\n  }\n}\n.lc-shell {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  height: 100vh;\n}\n.lc-sidenav {\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n  width: 112px;\n  height: 100%;\n  background: var(--color-paper);\n  border-right: 1px solid var(--color-line);\n  padding-bottom: 8px;\n  position: relative;\n  z-index: 30;\n  transition: width 240ms cubic-bezier(.34, 1.56, .64, 1);\n}\n.lc-sidenav[data-collapsed=\"true\"] {\n  width: 64px;\n}\n.lc-sidenav-logo {\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-bottom: 1px solid var(--color-line);\n}\n.lc-sidenav-brand-glyph {\n  width: 52px;\n  height: 52px;\n  image-rendering: pixelated;\n  animation: lc-brand-breathe 3.2s ease-in-out infinite;\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.5));\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-brand-glyph {\n  width: 32px;\n  height: 32px;\n}\n@keyframes lc-brand-breathe {\n  0%, 100% {\n    transform: translateY(0) scale(1);\n    filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.5));\n  }\n  50% {\n    transform: translateY(-2px) scale(1.05);\n    filter: drop-shadow(0 0 16px rgba(255, 26, 140, 0.9));\n  }\n}\n.lc-sidenav-collapse {\n  align-self: center;\n  margin: 4px 0 2px;\n  height: 22px;\n  width: 22px;\n  border-radius: 50%;\n  border: 1px solid var(--color-line);\n  background: var(--color-paper);\n  color: var(--color-text-tertiary);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: color 160ms ease, border-color 160ms ease, transform 220ms cubic-bezier(.34, 1.56, .64, 1);\n}\n.lc-sidenav-collapse:hover {\n  color: var(--color-fuchsia);\n  border-color: var(--color-fuchsia);\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-collapse {\n  transform: rotate(180deg);\n}\n.lc-sidenav-list {\n  display: flex;\n  flex-direction: column;\n  flex: 1 1 auto;\n  padding-top: 6px;\n  overflow-y: auto;\n}\n.lc-sidenav-divider {\n  height: 1px;\n  margin: 6px 12px;\n  background: var(--color-line);\n}\n.lc-sidenav-item {\n  appearance: none;\n  min-height: 80px;\n  padding: 12px 4px;\n  position: relative;\n  outline: none;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  color: var(--color-ink);\n  transition: opacity 160ms ease, color 160ms ease;\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-item {\n  min-height: 56px;\n  padding: 8px 4px;\n}\n.lc-sidenav-item:focus-visible {\n  box-shadow: inset 0 0 0 2px var(--color-fuchsia);\n}\n.lc-sidenav-halo {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 80px;\n  height: 80px;\n  margin: -40px 0 0 -40px;\n  border-radius: 50%;\n  background: radial-gradient(closest-side, rgba(255, 26, 140, 0.32), transparent 70%);\n  opacity: 0;\n  transform: scale(0.85);\n  transition: opacity 200ms ease, transform 240ms cubic-bezier(.34, 1.56, .64, 1);\n  pointer-events: none;\n  z-index: 0;\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-halo {\n  width: 56px;\n  height: 56px;\n  margin: -28px 0 0 -28px;\n}\n.lc-sidenav-item:hover .lc-sidenav-halo {\n  opacity: 1;\n  transform: scale(1);\n}\n.lc-sidenav-item[data-active=\"true\"] .lc-sidenav-halo {\n  opacity: 0.7;\n  transform: scale(1);\n}\n.lc-sidenav-bar {\n  position: absolute;\n  left: 0;\n  top: 8px;\n  bottom: 8px;\n  width: 3px;\n  border-radius: 0 2px 2px 0;\n  background: var(--color-fuchsia);\n  opacity: 0;\n  transition: opacity 160ms ease;\n  pointer-events: none;\n}\n.lc-sidenav-item[data-active=\"true\"] .lc-sidenav-bar {\n  opacity: 1;\n  animation: lc-bar-pulse 1.8s ease-in-out infinite;\n}\n@keyframes lc-bar-pulse {\n  0%, 100% {\n    box-shadow: 0 0 8px var(--color-fuchsia);\n    opacity: 0.85;\n  }\n  50% {\n    box-shadow: 0 0 22px var(--color-fuchsia);\n    opacity: 1;\n  }\n}\n.lc-sidenav-icon {\n  width: 56px;\n  height: 56px;\n  object-fit: contain;\n  position: relative;\n  z-index: 1;\n  opacity: 1 !important;\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.35));\n  transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1), filter 240ms ease;\n  animation: lc-badge-float 3s ease-in-out infinite;\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-icon {\n  width: 36px;\n  height: 36px;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(1) .lc-sidenav-icon {\n  animation-delay: 0s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(2) .lc-sidenav-icon {\n  animation-delay: -0.3s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(3) .lc-sidenav-icon {\n  animation-delay: -0.6s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(4) .lc-sidenav-icon {\n  animation-delay: -1.0s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(5) .lc-sidenav-icon {\n  animation-delay: -1.4s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(6) .lc-sidenav-icon {\n  animation-delay: -1.8s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(7) .lc-sidenav-icon {\n  animation-delay: -2.2s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(8) .lc-sidenav-icon {\n  animation-delay: -1.2s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(9) .lc-sidenav-icon {\n  animation-delay: -1.6s;\n}\n.lc-sidenav-list .lc-sidenav-item:nth-child(10) .lc-sidenav-icon {\n  animation-delay: -2.0s;\n}\n@keyframes lc-badge-float {\n  0%, 100% {\n    transform: translateY(0) rotate(-2deg) scale(1);\n    filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.35));\n  }\n  50% {\n    transform: translateY(-6px) rotate(3deg) scale(1.06);\n    filter: drop-shadow(0 0 16px rgba(255, 26, 140, 0.7));\n  }\n}\n.lc-sidenav-item:hover .lc-sidenav-icon {\n  animation-play-state: paused;\n  transform: translateY(-4px) scale(1.15) rotate(2deg);\n  filter: drop-shadow(0 0 18px rgba(255, 26, 140, 0.85));\n}\n.lc-sidenav-item[data-active=\"true\"] .lc-sidenav-icon {\n  animation: lc-badge-active 2.8s ease-in-out infinite;\n  filter: drop-shadow(0 0 16px rgba(255, 26, 140, 0.95));\n}\n@keyframes lc-badge-active {\n  0%, 100% {\n    transform: translateY(0) scale(1.05) rotate(-1deg);\n  }\n  50% {\n    transform: translateY(-3px) scale(1.10) rotate(2deg);\n  }\n}\n.lc-sidenav-label {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  line-height: 1;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  color: var(--color-ink);\n  max-width: 96px;\n  text-align: center;\n  position: relative;\n  z-index: 1;\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-sidenav-label {\n  display: none;\n}\n.lc-sidenav-item[data-active=\"true\"] .lc-sidenav-label {\n  color: var(--color-fuchsia-deep);\n}\n.lc-nav-user {\n  margin: 0 12px;\n  padding: 10px;\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.lc-sidenav[data-collapsed=\"true\"] .lc-nav-user-text {\n  display: none;\n}\n.lc-nav-user-avatar {\n  position: relative;\n  width: 32px;\n  height: 32px;\n  flex-shrink: 0;\n  border-radius: 50%;\n  background: linear-gradient(135deg, var(--color-fuchsia), #c8126c);\n  color: #fff;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-display);\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n  border: 2px solid var(--color-paper);\n  box-shadow: 0 0 12px rgba(255, 26, 140, 0.6);\n}\n.lc-nav-user-crown {\n  position: absolute;\n  top: -6px;\n  right: -6px;\n  width: 16px;\n  height: 16px;\n  image-rendering: pixelated;\n}\n.lc-nav-user-name {\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--color-ink);\n}\n.lc-nav-user-tier {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.14em;\n  color: var(--color-fuchsia-deep);\n}\n.lc-page {\n  flex: 1 1 auto;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  perspective: 1200px;\n  perspective-origin: 50% 35%;\n}\n.lc-topbar {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 14px 24px;\n  border-bottom: 1px solid var(--color-line);\n  background: rgba(11, 11, 16, 0.6);\n  backdrop-filter: blur(12px);\n  flex-shrink: 0;\n}\n.lc-topbar-title {\n  font-family: var(--font-display);\n  font-size: 18px;\n  font-weight: 700;\n  letter-spacing: -0.014em;\n  color: var(--color-ink);\n}\n.lc-topbar-pill {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  padding: 4px 9px;\n  border-radius: var(--radius-pill);\n}\n.lc-topbar-spacer {\n  flex: 1 1 auto;\n}\n.lc-topbar-watermark {\n  height: 18px;\n  opacity: 0.85;\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.45));\n  animation: lc-watermark-breathe 4.4s ease-in-out infinite;\n}\n@keyframes lc-watermark-breathe {\n  0%, 100% {\n    opacity: 0.85;\n    filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.4));\n  }\n  50% {\n    opacity: 1;\n    filter: drop-shadow(0 0 14px rgba(255, 26, 140, 0.75));\n  }\n}\n.lc-topbar-upgrade {\n  height: 32px;\n  padding: 0 14px;\n  margin-right: 4px;\n  border-radius: 9px;\n  border: 1px solid var(--color-fuchsia);\n  background: linear-gradient(135deg, rgba(255, 62, 165, 0.18), rgba(96, 216, 255, 0.10));\n  color: var(--color-ink, #f5f6fa);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  cursor: pointer;\n  transition: filter 160ms ease, transform 160ms ease;\n}\n.lc-topbar-upgrade:hover {\n  filter: brightness(1.12);\n  transform: translateY(-1px);\n}\n.lc-topbar-upgrade:active {\n  transform: translateY(0);\n}\n.lc-topbar-bell {\n  position: relative;\n  width: 36px;\n  height: 36px;\n  border-radius: 12px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--color-ink-soft);\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.lc-topbar-bell:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-topbar-bell-dot {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 10px var(--color-fuchsia);\n  animation: lc-live-dot 1.6s ease-in-out infinite;\n}\n@keyframes lc-live-dot {\n  0%, 100% {\n    box-shadow: 0 0 6px var(--color-fuchsia);\n    transform: scale(1);\n  }\n  50% {\n    box-shadow: 0 0 16px var(--color-fuchsia);\n    transform: scale(1.3);\n  }\n}\n.avatar-orbit {\n  position: relative;\n  cursor: pointer;\n  outline: none;\n  background: transparent;\n  border: 0;\n  padding: 0;\n}\n.avatar-orbit-ring {\n  position: absolute;\n  inset: -3px;\n  border-radius: 50%;\n  border: 1.5px solid var(--color-fuchsia);\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.55));\n  pointer-events: none;\n  animation: lc-avatar-glow 3s ease-in-out infinite;\n}\n@keyframes lc-avatar-glow {\n  0%, 100% {\n    filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.5));\n  }\n  50% {\n    filter: drop-shadow(0 0 18px rgba(255, 26, 140, 0.9));\n  }\n}\n.avatar-orbit-face {\n  position: relative;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  overflow: hidden;\n  background: linear-gradient(135deg, var(--color-fuchsia), #c8126c);\n  border: 2px solid var(--color-paper);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-family: var(--font-display);\n  font-size: 13px;\n  font-weight: 700;\n}\n.avatar-orbit-crown {\n  position: absolute;\n  top: -6px;\n  right: -6px;\n  width: 18px;\n  height: 18px;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.7));\n}\n.avatar-orbit-badge {\n  position: absolute;\n  top: -2px;\n  left: -4px;\n  min-width: 16px;\n  height: 16px;\n  padding: 0 4px;\n  border-radius: 999px;\n  background: var(--color-fuchsia);\n  color: #fff;\n  font-family: var(--font-mono);\n  font-size: 9px;\n  font-weight: 700;\n  border: 1.5px solid var(--color-paper);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n.lc-canvas {\n  flex: 1 1 auto;\n  overflow: auto;\n  padding: 32px 40px 80px;\n  position: relative;\n  scrollbar-width: thin;\n}\n.lc-canvas::-webkit-scrollbar {\n  width: 8px;\n}\n.lc-canvas::-webkit-scrollbar-thumb {\n  background: var(--color-line-strong);\n  border-radius: 8px;\n}\n.lc-canvas::-webkit-scrollbar-track {\n  background: transparent;\n}\n.lc-deck-atmosphere {\n  position: fixed;\n  top: 58px;\n  left: 112px;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  background-size: cover;\n  background-position: center;\n  mix-blend-mode: screen;\n  filter: saturate(1.1);\n  transition: opacity 320ms ease, background-image 320ms ease;\n}\n.lc-sidenav[data-collapsed=\"true\"] ~ .lc-page .lc-deck-atmosphere {\n  left: 64px;\n}\n.lc-section {\n  position: relative;\n  z-index: 1;\n  max-width: 1240px;\n  margin: 0 auto;\n  animation: lc-section-in 480ms cubic-bezier(.34, 1.2, .64, 1) both;\n}\n@keyframes lc-section-in {\n  from {\n    opacity: 0;\n    transform: translateY(8px) scale(0.985);\n    filter: blur(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    filter: blur(0);\n  }\n}\n.lc-section-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 28px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--color-line);\n}\n.lc-section-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n}\n.lc-section-eyebrow-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 10px var(--color-fuchsia);\n  animation: lc-live-dot 1.8s ease-in-out infinite;\n}\n.lc-section-title {\n  font-family: var(--font-display);\n  font-size: 36px;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  line-height: 1.05;\n  margin: 10px 0 8px;\n  color: var(--color-ink);\n}\n.lc-section-subtitle {\n  font-size: 14px;\n  color: var(--color-ink-soft);\n  max-width: 64ch;\n}\n.lc-section-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 14px;\n}\n.lc-section-header[data-compact=\"engine\"] {\n  margin-bottom: 12px;\n  padding-bottom: 10px;\n}\n.lc-section-header[data-compact=\"engine\"] .lc-section-title {\n  font-size: 24px;\n  margin: 4px 0 2px;\n}\n.lc-section-header[data-compact=\"engine\"] .lc-section-subtitle {\n  display: none;\n}\n.lc-section-header[data-compact=\"engine\"] .lc-section-pills {\n  margin-top: 6px;\n}\n.lc-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 4px 10px;\n  border-radius: var(--radius-pill);\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n}\n.lc-pill-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-text-tertiary);\n}\n.lc-pill[data-tone=\"brand\"] {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n  background: var(--color-fuchsia-soft);\n}\n.lc-pill[data-tone=\"brand\"] .lc-pill-dot {\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 8px var(--color-fuchsia);\n}\n.lc-pill[data-tone=\"ok\"] {\n  border-color: rgba(255, 26, 140, 0.4);\n  color: var(--color-fuchsia-deep);\n}\n.lc-pill[data-tone=\"ok\"] .lc-pill-dot {\n  background: var(--color-fuchsia-deep);\n  box-shadow: 0 0 8px var(--color-fuchsia-deep);\n}\n.lc-pill[data-tone=\"warn\"] {\n  border-color: rgba(255, 176, 46, 0.4);\n  color: var(--color-warn);\n}\n.lc-pill[data-tone=\"warn\"] .lc-pill-dot {\n  background: var(--color-warn);\n  box-shadow: 0 0 8px var(--color-warn);\n}\n.lc-pill[data-tone=\"live\"] {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-pill[data-tone=\"live\"] .lc-pill-dot {\n  background: var(--color-fuchsia);\n  animation: lc-live-dot 1.6s ease-in-out infinite;\n}\n.lc-id-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: var(--radius-pill);\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  color: var(--color-ink-soft);\n}\n.lc-hud-card {\n  position: relative;\n  border-radius: var(--radius-card);\n  padding: 22px 24px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.78), rgba(11, 11, 16, 0.92));\n  border: 1px solid var(--color-line);\n  transition: border-color 220ms ease, transform 240ms cubic-bezier(.34, 1.56, .64, 1), box-shadow 240ms ease;\n  isolation: isolate;\n}\n.lc-hud-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  background: linear-gradient(to right, var(--color-fuchsia) 0 14px, transparent 14px) top left / 14px 1.5px no-repeat, linear-gradient(to bottom, var(--color-fuchsia) 0 14px, transparent 14px) top left / 1.5px 14px no-repeat, linear-gradient(to left, var(--color-fuchsia) 0 14px, transparent 14px) top right / 14px 1.5px no-repeat, linear-gradient(to bottom, var(--color-fuchsia) 0 14px, transparent 14px) top right / 1.5px 14px no-repeat, linear-gradient(to right, var(--color-fuchsia) 0 14px, transparent 14px) bottom left / 14px 1.5px no-repeat, linear-gradient(to top, var(--color-fuchsia) 0 14px, transparent 14px) bottom left / 1.5px 14px no-repeat, linear-gradient(to left, var(--color-fuchsia) 0 14px, transparent 14px) bottom right / 14px 1.5px no-repeat, linear-gradient(to top, var(--color-fuchsia) 0 14px, transparent 14px) bottom right / 1.5px 14px no-repeat;\n  opacity: 0.7;\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.45));\n}\n.lc-hud-card:hover {\n  border-color: var(--color-line-strong);\n  transform: translateY(-2px);\n  box-shadow: 0 0 0 1px rgba(255, 26, 140, 0.2), 0 18px 48px -22px rgba(255, 26, 140, 0.5), 0 8px 24px -8px rgba(0, 0, 0, 0.7);\n}\n.lc-hud-card.is-static {\n  cursor: default;\n}\n.lc-hud-card.is-static:hover {\n  border-color: var(--color-line);\n  transform: none;\n  box-shadow: none;\n}\n.lc-grid[role=\"list\"] {\n  list-style: none;\n  padding-inline-start: 0;\n  margin-block: 0;\n}\n.lc-hud-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-hud-title {\n  font-family: var(--font-display);\n  font-size: 17px;\n  font-weight: 600;\n  letter-spacing: -0.012em;\n  margin: 6px 0 4px;\n}\n.lc-hud-body {\n  font-size: 13px;\n  color: var(--color-ink-soft);\n}\n.lc-hero-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  margin-top: 24px;\n}\n.lc-hero-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 14px;\n  padding: 26px;\n  border-radius: 20px;\n  cursor: pointer;\n  text-align: left;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.88), rgba(11, 11, 16, 0.95));\n  border: 1px solid var(--color-line);\n  transition: border-color 240ms ease, transform 280ms cubic-bezier(.34, 1.56, .64, 1), box-shadow 280ms ease;\n  isolation: isolate;\n}\n.lc-hero-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  z-index: -1;\n  background: radial-gradient(ellipse 80% 40% at 50% -10%, rgba(255, 26, 140, 0.24), transparent 70%);\n  opacity: 0.7;\n  transition: opacity 280ms ease;\n}\n.lc-hero-card[data-variant=\"campaign\"]::after, .lc-hero-card[data-variant=\"agency\"]::after {\n  background: radial-gradient(ellipse 80% 40% at 50% -10%, rgba(140, 60, 255, 0.24), transparent 70%);\n}\n.lc-hero-card:hover {\n  border-color: var(--color-fuchsia);\n  transform: translateY(-4px);\n  box-shadow: 0 24px 60px -20px rgba(255, 26, 140, 0.5), 0 0 0 1px rgba(255, 26, 140, 0.4);\n}\n.lc-hero-card[data-variant=\"campaign\"]:hover, .lc-hero-card[data-variant=\"agency\"]:hover {\n  border-color: rgba(140, 60, 255, 0.85);\n  box-shadow: 0 24px 60px -20px rgba(140, 60, 255, 0.45), 0 0 0 1px rgba(140, 60, 255, 0.5);\n}\n.lc-hero-card:hover::after {\n  opacity: 1;\n}\n.lc-hero-card[data-selected=\"true\"] {\n  border-color: var(--color-fuchsia);\n  box-shadow: 0 24px 60px -20px rgba(255, 26, 140, 0.55), 0 0 0 1.5px var(--color-fuchsia);\n}\n.lc-hero-card[data-variant=\"campaign\"][data-selected=\"true\"], .lc-hero-card[data-variant=\"agency\"][data-selected=\"true\"] {\n  border-color: rgba(140, 60, 255, 0.95);\n  box-shadow: 0 24px 60px -20px rgba(140, 60, 255, 0.55), 0 0 0 1.5px rgba(140, 60, 255, 0.85);\n}\n.lc-hero-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n.lc-hero-icon {\n  width: 44px;\n  height: 44px;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.55));\n}\n.lc-hero-card[data-variant=\"campaign\"] .lc-hero-icon, .lc-hero-card[data-variant=\"agency\"] .lc-hero-icon {\n  filter: drop-shadow(0 0 8px rgba(140, 60, 255, 0.55));\n}\n.lc-hero-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n}\n.lc-hero-card[data-variant=\"campaign\"] .lc-hero-eyebrow, .lc-hero-card[data-variant=\"agency\"] .lc-hero-eyebrow {\n  color: rgba(180, 130, 255, 0.95);\n}\n.lc-hero-title {\n  font-family: var(--font-display);\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  line-height: 1.15;\n}\n.lc-hero-outcome {\n  font-size: 13px;\n  color: var(--color-ink-soft);\n}\n.lc-hero-steps {\n  display: grid;\n  gap: 6px;\n}\n.lc-hero-step {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n}\n.lc-hero-step::before {\n  content: \"\";\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 8px var(--color-fuchsia);\n}\n.lc-hero-card[data-variant=\"campaign\"] .lc-hero-step::before, .lc-hero-card[data-variant=\"agency\"] .lc-hero-step::before {\n  background: rgba(160, 110, 255, 0.95);\n  box-shadow: 0 0 8px rgba(160, 110, 255, 0.7);\n}\n.lc-hero-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 10px 14px;\n  border-radius: 12px;\n  background: var(--color-fuchsia-soft);\n  color: var(--color-fuchsia-deep);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n.lc-metric-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 14px;\n  margin-top: 24px;\n}\n.lc-metric {\n  position: relative;\n  padding: 18px 20px;\n  border-radius: 14px;\n  overflow: hidden;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.65), rgba(11, 11, 16, 0.85));\n  border: 1px solid var(--color-line);\n  cursor: pointer;\n  transition: transform 240ms cubic-bezier(.34, 1.56, .64, 1), border-color 200ms ease;\n  isolation: isolate;\n}\n.lc-metric::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: -1;\n  background: radial-gradient(circle at top right, rgba(255, 26, 140, 0.14), transparent 60%);\n}\n.lc-metric:hover {\n  transform: translateY(-2px);\n  border-color: var(--color-fuchsia);\n}\n.lc-metric-label {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-metric-value {\n  font-family: var(--font-display);\n  font-size: 30px;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  margin-top: 6px;\n  line-height: 1;\n  color: var(--color-ink);\n}\n.lc-metric-hint {\n  font-size: 11.5px;\n  color: var(--color-text-tertiary);\n  margin-top: 6px;\n}\n.lc-mission {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 6px;\n  padding: 22px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.6), rgba(11, 11, 16, 0.8));\n  border: 1px solid var(--color-line);\n  border-radius: 18px;\n  position: relative;\n}\n.lc-mission::before {\n  content: \"\";\n  position: absolute;\n  left: 10%;\n  right: 10%;\n  top: 50%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, var(--color-fuchsia), transparent);\n  opacity: 0.5;\n  pointer-events: none;\n}\n.lc-mission-step {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  padding: 8px;\n}\n.lc-mission-badge {\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  border: 2px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  transition: border-color 220ms ease, transform 240ms cubic-bezier(.34, 1.56, .64, 1), box-shadow 280ms ease;\n}\n.lc-mission-badge img {\n  width: 44px;\n  height: 44px;\n  object-fit: contain;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.35));\n}\n.lc-mission-step[data-state=\"active\"] .lc-mission-badge {\n  border-color: var(--color-fuchsia);\n  transform: scale(1.1);\n  box-shadow: 0 0 0 4px rgba(255, 26, 140, 0.2), 0 0 24px rgba(255, 26, 140, 0.55);\n  animation: lc-mission-pulse 2.4s ease-in-out infinite;\n}\n.lc-mission-step[data-state=\"done\"] .lc-mission-badge {\n  border-color: var(--color-fuchsia-deep);\n  background: rgba(255, 26, 140, 0.12);\n}\n@keyframes lc-mission-pulse {\n  0%, 100% {\n    box-shadow: 0 0 0 4px rgba(255, 26, 140, 0.18), 0 0 18px rgba(255, 26, 140, 0.4);\n  }\n  50% {\n    box-shadow: 0 0 0 8px rgba(255, 26, 140, 0.28), 0 0 32px rgba(255, 26, 140, 0.75);\n  }\n}\n.lc-mission-label {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n}\n.lc-mission-step[data-state=\"active\"] .lc-mission-label, .lc-mission-step[data-state=\"done\"] .lc-mission-label {\n  color: var(--color-ink);\n}\n.lc-btn {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 10px 16px;\n  font-family: var(--font-sans);\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: -0.005em;\n  border-radius: 12px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: background 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 220ms ease, transform 180ms ease;\n}\n.lc-btn[data-size=\"sm\"] {\n  padding: 7px 12px;\n  font-size: 12px;\n}\n.lc-btn[data-variant=\"primary\"] {\n  background: var(--color-fuchsia);\n  color: #fff;\n  box-shadow: 0 8px 24px -8px rgba(255, 26, 140, 0.6), 0 0 0 1px rgba(255, 26, 140, 0.35);\n}\n.lc-btn[data-variant=\"primary\"]:hover {\n  background: var(--color-fuchsia-bright);\n  transform: translateY(-1px);\n  box-shadow: 0 12px 32px -8px rgba(255, 26, 140, 0.8), 0 0 0 1px rgba(255, 26, 140, 0.55);\n}\n.lc-btn[data-variant=\"secondary\"] {\n  background: var(--color-paper-elev);\n  border-color: var(--color-line-strong);\n  color: var(--color-ink-soft);\n}\n.lc-btn[data-variant=\"secondary\"]:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n.lc-btn[data-variant=\"whop\"] {\n  background: linear-gradient(135deg, #ff1a8c, #c8126c);\n  color: #fff;\n  box-shadow: 0 8px 24px -8px rgba(255, 26, 140, 0.65);\n}\n.lc-btn[data-variant=\"whop\"]:hover {\n  transform: translateY(-1px);\n  filter: brightness(1.1);\n}\n.lc-btn[data-variant=\"ayrshare\"] {\n  background: linear-gradient(135deg, #00e5ff, #00b8ff);\n  color: #001a26;\n  box-shadow: 0 8px 24px -8px rgba(0, 229, 255, 0.45);\n}\n.lc-btn[data-variant=\"ghost\"] {\n  background: transparent;\n  border-color: var(--color-line);\n  color: var(--color-text-secondary);\n}\n.lc-btn[data-variant=\"ghost\"]:hover {\n  background: var(--color-paper-elev);\n  color: var(--color-ink);\n}\n.lc-grid {\n  display: grid;\n  gap: 14px;\n}\n.lc-grid-2 {\n  grid-template-columns: repeat(2, 1fr);\n}\n.lc-grid-3 {\n  grid-template-columns: repeat(3, 1fr);\n}\n.lc-grid-4 {\n  grid-template-columns: repeat(4, 1fr);\n}\n.cockpit-tile {\n  position: relative;\n  padding: 22px 22px;\n  border-radius: 18px;\n  background: linear-gradient(180deg, rgba(20, 20, 28, 0.85), rgba(11, 11, 16, 0.95));\n  border: 1px solid var(--color-line);\n  transform-style: preserve-3d;\n  transform: perspective(900px) rotateX(calc(var(--cockpit-py) * -3deg)) rotateY(calc(var(--cockpit-px) * 5deg));\n  transition: transform 280ms ease, box-shadow 280ms ease, border-color 220ms ease;\n  cursor: pointer;\n  overflow: hidden;\n  isolation: isolate;\n}\n.cockpit-tile::before, .cockpit-tile::after {\n  content: \"\";\n  position: absolute;\n  width: 22px;\n  height: 22px;\n  pointer-events: none;\n  border: 1.5px dashed var(--color-fuchsia);\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.55));\n}\n.cockpit-tile::before {\n  top: 6px;\n  left: 6px;\n  border-right: 0;\n  border-bottom: 0;\n}\n.cockpit-tile::after {\n  top: 6px;\n  right: 6px;\n  border-left: 0;\n  border-bottom: 0;\n}\n.cockpit-tile-corner-bl, .cockpit-tile-corner-br {\n  position: absolute;\n  width: 22px;\n  height: 22px;\n  pointer-events: none;\n  border: 1.5px dashed var(--color-fuchsia);\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.55));\n}\n.cockpit-tile-corner-bl {\n  bottom: 6px;\n  left: 6px;\n  border-right: 0;\n  border-top: 0;\n}\n.cockpit-tile-corner-br {\n  bottom: 6px;\n  right: 6px;\n  border-left: 0;\n  border-top: 0;\n}\n.cockpit-tile:hover {\n  border-color: var(--color-fuchsia);\n  transform: perspective(900px) rotateX(calc(var(--cockpit-py) * -3deg)) rotateY(calc(var(--cockpit-px) * 5deg)) translateZ(8px);\n  box-shadow: 0 24px 56px -20px rgba(255, 26, 140, 0.55);\n}\n.cockpit-tile-clipno {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  color: var(--color-fuchsia);\n}\n.cockpit-tile-title {\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.32;\n  letter-spacing: -0.01em;\n  margin-top: 8px;\n  min-height: 36px;\n}\n.cockpit-tile-meta {\n  margin-top: 8px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n.cockpit-tile-thumb {\n  margin: 12px -22px -22px;\n  aspect-ratio: 16 / 9;\n  background: radial-gradient(ellipse 70% 60% at 50% 35%, rgba(255, 26, 140, 0.18), transparent 70%), linear-gradient(135deg, #1c1c25, #0b0b10);\n  border-top: 1px solid var(--color-line);\n  position: relative;\n  overflow: hidden;\n}\n.cockpit-tile-thumb::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at 50% 50%, rgba(255, 26, 140, 0.12), transparent 60%);\n  mix-blend-mode: screen;\n}\n.cockpit-tile-thumb-label {\n  position: absolute;\n  left: 14px;\n  bottom: 12px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n  background: rgba(11, 11, 16, 0.6);\n  padding: 4px 8px;\n  border-radius: 6px;\n  border: 1px solid rgba(255, 26, 140, 0.3);\n}\n.cockpit-tile-strip {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 10px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 6px 8px;\n  border-radius: 4px;\n}\n.cockpit-tile-strip[data-state=\"bake\"] {\n  color: var(--color-cyan-cool);\n  border: 1px solid rgba(47, 233, 212, 0.4);\n  background: rgba(47, 233, 212, 0.06);\n}\n.cockpit-tile-strip-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-cyan-cool);\n  animation: blink 1.1s infinite;\n}\n@keyframes blink {\n  50% {\n    opacity: 0.25;\n  }\n}\n.engine-shell {\n  display: grid;\n  grid-template-columns: 1fr 280px;\n  gap: 18px;\n  align-items: start;\n  margin-top: 24px;\n}\n.engine-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  padding: 14px 18px;\n  border-radius: 14px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.8), rgba(11, 11, 16, 0.92));\n  border: 1px solid var(--color-line);\n  margin-bottom: 16px;\n}\n.engine-toolbar-label {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n  margin-right: 4px;\n}\n.engine-rail {\n  padding: 18px;\n  border-radius: 16px;\n  position: sticky;\n  top: 0;\n  background: linear-gradient(180deg, rgba(20, 20, 28, 0.92), rgba(11, 11, 16, 0.95));\n  border: 1px solid var(--color-line);\n}\n.engine-rail-title {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n  margin-bottom: 12px;\n}\n.engine-rail-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.engine-rail-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 12px;\n  border-radius: 10px;\n  cursor: pointer;\n  border: 1px solid transparent;\n  color: var(--color-ink-soft);\n  font-size: 12px;\n  transition: border-color 160ms ease, background 160ms ease, color 160ms ease;\n}\n.engine-rail-item:hover {\n  background: var(--color-paper-elev);\n  color: var(--color-ink);\n  border-color: var(--color-line);\n}\n.engine-rail-item[data-active=\"true\"] {\n  background: var(--color-fuchsia-soft);\n  color: var(--color-fuchsia-deep);\n  border-color: var(--color-fuchsia);\n}\n.engine-rail-key {\n  font-family: var(--font-mono);\n  font-size: 9px;\n  letter-spacing: 0.12em;\n  color: var(--color-text-tertiary);\n}\n.lc-conn {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 14px;\n  margin-top: 24px;\n}\n.lc-conn-card {\n  position: relative;\n  padding: 18px;\n  border-radius: 14px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.78), rgba(11, 11, 16, 0.92));\n  border: 1px solid var(--color-line);\n  display: grid;\n  gap: 12px;\n}\n.lc-conn-platform {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n}\n.lc-conn-handle {\n  font-family: var(--font-display);\n  font-size: 17px;\n  font-weight: 600;\n}\n.lc-conn-since {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n}\n.lc-signal-line {\n  position: fixed;\n  left: 112px;\n  right: 0;\n  bottom: 0;\n  height: 28px;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 0 24px;\n  pointer-events: none;\n  background: linear-gradient(180deg, transparent, rgba(11, 11, 16, 0.9));\n  border-top: 1px solid var(--color-line);\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n  z-index: 25;\n}\n.lc-sidenav[data-collapsed=\"true\"] ~ .lc-page .lc-signal-line {\n  left: 64px;\n}\n.lc-signal-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  transition: opacity 320ms ease;\n}\n.lc-signal-item.is-hidden {\n  opacity: 0;\n  display: none;\n}\n.lc-signal-item-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 8px var(--color-fuchsia);\n}\n.lc-signal-item b {\n  color: var(--color-ink);\n  font-weight: 700;\n  letter-spacing: 0.04em;\n}\n.lc-toast {\n  position: fixed;\n  right: 20px;\n  top: 78px;\n  display: flex;\n  width: 320px;\n  gap: 12px;\n  padding: 12px;\n  border-radius: 16px;\n  border: 1px solid rgba(255, 26, 140, 0.4);\n  background: rgba(28, 28, 37, 0.92);\n  backdrop-filter: blur(12px);\n  box-shadow: 0 18px 50px rgba(255, 26, 140, 0.32);\n  z-index: 200;\n  animation: lc-toast-slide-in 320ms ease-out;\n}\n.lc-toast.is-hidden {\n  display: none;\n}\n.lc-toast img {\n  width: 56px;\n  height: 56px;\n  object-fit: contain;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 4px 12px rgba(255, 26, 140, 0.45));\n}\n.lc-toast-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.lc-toast-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-toast-eyebrow::before {\n  content: \"\";\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 8px var(--color-fuchsia);\n}\n.lc-toast-title {\n  font-family: var(--font-display);\n  font-size: 16px;\n  font-weight: 700;\n  letter-spacing: -0.012em;\n}\n.lc-toast-blurb {\n  font-size: 11.5px;\n  color: var(--color-ink-soft);\n  line-height: 1.4;\n}\n@keyframes lc-toast-slide-in {\n  from {\n    opacity: 0;\n    transform: translateX(40px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n.lc-liquid-loader {\n  position: relative;\n  width: 64px;\n  height: 64px;\n  -webkit-mask: var(--liquid-mask) center / contain no-repeat;\n  mask: var(--liquid-mask) center / contain no-repeat;\n  background: rgba(255, 26, 140, 0.18);\n  overflow: hidden;\n  flex-shrink: 0;\n}\n.lc-liquid-loader::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, #ff66b8 0%, #ff1a8c 60%, #c70066 100%);\n  animation: lc-liquid-rise 1.8s ease-in-out infinite;\n  filter: drop-shadow(0 0 8px rgba(255, 26, 140, 0.55));\n}\n.lc-liquid-loader::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, transparent 80%, rgba(255, 143, 203, 0.9) 86%, transparent 92%);\n  animation: lc-liquid-rise 1.8s ease-in-out infinite;\n  mix-blend-mode: screen;\n}\n@keyframes lc-liquid-rise {\n  0% {\n    transform: translateY(100%);\n  }\n  15% {\n    transform: translateY(85%);\n  }\n  50% {\n    transform: translateY(12%);\n  }\n  85% {\n    transform: translateY(0%);\n  }\n  100% {\n    transform: translateY(-12%);\n  }\n}\n.lc-campaign {\n  display: grid;\n  gap: 18px;\n  padding: 24px;\n  border-radius: 18px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.88), rgba(11, 11, 16, 0.95));\n  border: 1px solid var(--color-line);\n  position: relative;\n  overflow: hidden;\n}\n.lc-campaign::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background: radial-gradient(ellipse 60% 30% at 50% -5%, rgba(255, 26, 140, 0.18), transparent 70%);\n}\n.lc-campaign-title {\n  font-family: var(--font-display);\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n.lc-campaign-stamp {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 14px;\n  border-radius: 12px;\n  border: 1px dashed var(--color-line-strong);\n  background: rgba(15, 15, 22, 0.6);\n}\n.lc-campaign-stamp-preview {\n  width: 78px;\n  height: 44px;\n  border-radius: 6px;\n  position: relative;\n  overflow: hidden;\n  background: linear-gradient(135deg, rgba(255, 26, 140, 0.5), rgba(255, 102, 184, 0.15));\n  flex-shrink: 0;\n}\n.lc-campaign-stamp-preview::after {\n  content: \"WM\";\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  color: #fff;\n  text-shadow: 0 0 8px rgba(255, 26, 140, 0.8);\n}\n.lc-campaign-stamp-meta {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--color-ink-soft);\n}\n.lc-campaign-row {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n.lc-row {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n.lc-mt-12 {\n  margin-top: 12px;\n}\n.lc-mt-16 {\n  margin-top: 16px;\n}\n.lc-mt-24 {\n  margin-top: 24px;\n}\n.lc-whop {\n  display: grid;\n  gap: 14px;\n  padding: 24px;\n  border-radius: 18px;\n  margin-top: 24px;\n  background: linear-gradient(135deg, rgba(255, 26, 140, 0.12), rgba(140, 60, 255, 0.06));\n  border: 1px solid rgba(255, 26, 140, 0.3);\n  position: relative;\n  overflow: hidden;\n}\n.lc-whop::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(circle at top right, rgba(255, 26, 140, 0.18), transparent 60%);\n}\n.lc-whop-title {\n  font-family: var(--font-display);\n  font-size: 26px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n}\n.lc-whop-body {\n  color: var(--color-ink-soft);\n}\n.lc-settings-tabs {\n  display: inline-flex;\n  gap: 6px;\n  padding: 6px;\n  border-radius: var(--radius-pill);\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n  flex-wrap: wrap;\n}\n.lc-settings-tab {\n  appearance: none;\n  border: 1px solid transparent;\n  background: transparent;\n  color: var(--color-ink-soft);\n  font-family: var(--font-sans);\n  font-size: 12px;\n  font-weight: 600;\n  height: 34px;\n  padding: 0 16px;\n  border-radius: var(--radius-pill);\n  cursor: pointer;\n  transition: background 180ms ease, color 180ms ease, box-shadow 180ms ease, transform 160ms var(--ease-spring);\n}\n.lc-settings-tab:hover {\n  color: var(--color-ink);\n}\n.lc-settings-tab[data-active=\"true\"] {\n  background: linear-gradient(135deg, var(--color-fuchsia), var(--color-fuchsia-bright));\n  color: #fff;\n  border-color: rgba(255, 255, 255, 0.12);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 4px 18px rgba(255, 26, 140, 0.35);\n}\n.lc-timeline {\n  margin-top: 18px;\n  padding: 18px;\n  border-radius: 14px;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.8), rgba(11, 11, 16, 0.92));\n  border: 1px solid var(--color-line);\n}\n.lc-timeline-tracks {\n  margin-top: 14px;\n  display: grid;\n  grid-template-rows: repeat(4, 26px);\n  gap: 4px;\n}\n.lc-timeline-track {\n  border-radius: 6px;\n  position: relative;\n  overflow: hidden;\n  background: var(--color-paper-elev);\n}\n.lc-timeline-track.waveform {\n  background: linear-gradient(90deg, var(--color-fuchsia-soft), rgba(255, 26, 140, 0.04));\n}\n.lc-timeline-block {\n  position: absolute;\n  top: 4px;\n  bottom: 4px;\n  border-radius: 4px;\n}\n.lc-timeline-block.wave {\n  background: var(--color-fuchsia);\n  opacity: 0.7;\n}\n.lc-timeline-block.caption {\n  background: var(--color-cyan-cool);\n  opacity: 0.45;\n}\n.lc-timeline-block.reaction {\n  background: linear-gradient(90deg, var(--color-fuchsia), var(--color-fuchsia-deep));\n}\n.lc-timeline-block.broll {\n  background: rgba(255, 200, 100, 0.4);\n}\n.lc-timeline-label {\n  position: absolute;\n  left: 8px;\n  top: 50%;\n  transform: translateY(-50%);\n  font-family: var(--font-mono);\n  font-size: 9px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--color-ink-soft);\n  pointer-events: none;\n  z-index: 1;\n}\n.lc-timeline-label.brand {\n  color: var(--color-fuchsia-deep);\n}\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n@media (max-width: 1100px) {\n  .lc-metric-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .lc-hero-grid {\n    grid-template-columns: 1fr;\n  }\n  .lc-conn {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .engine-shell {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 720px) {\n  .lc-metric-grid {\n    grid-template-columns: 1fr;\n  }\n  .lc-conn {\n    grid-template-columns: 1fr;\n  }\n  .lc-canvas {\n    padding: 20px 18px 80px;\n  }\n  .lc-section-header {\n    flex-direction: column;\n  }\n}\n.lc-scrim {\n  position: fixed;\n  inset: 0;\n  z-index: 90;\n  background: rgba(5, 5, 8, 0.65);\n  backdrop-filter: blur(4px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n}\n.lc-modal {\n  width: 420px;\n  max-width: 100%;\n  max-height: 88vh;\n  overflow-y: auto;\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line-strong);\n  border-radius: var(--radius-card);\n  padding: 24px;\n  box-shadow: var(--shadow-e2);\n}\n.lc-form-label {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--color-ink-soft);\n}\n.lc-form-input {\n  appearance: none;\n  background: var(--color-paper-elev);\n  border: 1px solid var(--color-line-strong);\n  border-radius: var(--radius-control);\n  color: var(--color-ink);\n  font-family: var(--font-sans);\n  font-size: 13px;\n  padding: 9px 12px;\n  outline: none;\n  transition: border-color 180ms ease, box-shadow 180ms ease;\n}\n.lc-form-input:focus {\n  border-color: var(--color-fuchsia);\n  box-shadow: 0 0 0 3px rgba(255, 26, 140, 0.12);\n}\n.lc2-engine-workstation {\n  align-items: stretch;\n  margin-top: 14px !important;\n  gap: 14px !important;\n}\n.lc2-engine-main {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  min-width: 0;\n}\n.lc2-engine-rail-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  position: sticky;\n  top: 16px;\n  align-self: start;\n  max-height: calc(100vh - 32px);\n  overflow-y: auto;\n}\n.lc2-engine-rail-empty {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  border-radius: 14px;\n  border: 1px dashed var(--color-line-strong);\n  color: var(--color-text-tertiary);\n  font-size: 13px;\n  text-align: center;\n}\n.lc2-engine-rail-handoffs {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.lc2-engine-timeline-wrap {\n  position: relative;\n  border-radius: 14px;\n  border: 1px solid var(--color-line);\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.8), rgba(11, 11, 16, 0.92));\n  padding: 12px;\n  box-shadow: inset 0 1px 0 rgba(255, 26, 140, 0.40);\n}\n.lc2-engine-selected-preview {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 8px 10px 10px;\n  margin: -4px -4px 8px;\n  border-bottom: 1px solid var(--color-line);\n}\n.lc2-engine-selected-thumb {\n  position: relative;\n  width: 64px;\n  height: 112px;\n  border-radius: 10px;\n  background: radial-gradient(ellipse 70% 50% at 50% 38%, rgba(255, 26, 140, 0.22), transparent 70%), linear-gradient(180deg, #2a2230 0%, #120e16 100%);\n  border: 1px solid var(--color-line-strong);\n  display: flex;\n  align-items: flex-end;\n  justify-content: flex-end;\n  padding: 5px;\n  flex-shrink: 0;\n  overflow: hidden;\n  box-shadow: inset 0 1px 0 rgba(255, 26, 140, 0.18);\n}\n.lc2-engine-selected-thumb::before {\n  content: \"\";\n  position: absolute;\n  inset: 12% 18% 28%;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n}\n.lc2-engine-selected-thumb::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 38%;\n  background: linear-gradient(180deg, transparent, rgba(11, 11, 16, 0.92));\n}\n.lc2-engine-selected-score {\n  position: relative;\n  z-index: 1;\n  padding: 2px 6px;\n  border-radius: 999px;\n  background: rgba(255, 26, 140, 0.92);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 700;\n  color: #fff;\n  letter-spacing: 0.04em;\n  text-shadow: 0 0 8px rgba(255, 26, 140, 0.70);\n}\n.lc2-engine-selected-text {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  flex: 1;\n}\n.lc2-engine-selected-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc2-engine-selected-title {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--color-ink);\n  line-height: 1.25;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.lc2-engine-selected-hl {\n  color: var(--color-fuchsia);\n}\n.lc2-engine-selected-rest {\n  color: var(--color-ink);\n}\n.lc2-engine-selected-meta {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.10em;\n}\n.lc2-engine-source-strip {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: 14px;\n  margin-bottom: 12px;\n}\n.lc2-engine-source-cell {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 12px;\n  border-radius: 14px;\n  border: 1px solid var(--color-line);\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.78), rgba(11, 11, 16, 0.92));\n}\n.lc2-engine-source-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.lc2-engine-url-input {\n  flex: 1 1 220px;\n  min-width: 180px;\n}\n.lc2-engine-script-tabs {\n  display: flex;\n  gap: 6px;\n}\n.lc2-engine-script-tabs button {\n  padding: 5px 10px;\n  border-radius: var(--radius-pill);\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--color-text-secondary);\n  border: 1px solid transparent;\n}\n.lc2-engine-script-tabs button.on {\n  background: var(--color-fuchsia-soft);\n  color: var(--color-fuchsia-deep);\n  border-color: var(--color-fuchsia);\n}\n.lc2-engine-script-area {\n  width: 100%;\n  min-height: 56px;\n  resize: vertical;\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.6), rgba(11, 11, 16, 0.85)), var(--color-paper-elev);\n  border: 1px solid var(--color-line-strong);\n  border-radius: var(--radius-control);\n  color: var(--color-ink);\n  font-size: 12px;\n  padding: 10px;\n  outline: none;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);\n}\n.lc2-engine-script-area:focus {\n  border-color: var(--color-fuchsia);\n}\n.lc2-engine-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc2-engine-btn {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 8px 13px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink-soft);\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n.lc2-engine-btn:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n.lc2-engine-btn-primary {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 8px 13px;\n  border-radius: 10px;\n  border: 1px solid transparent;\n  background: var(--color-fuchsia);\n  color: #fff;\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background 160ms ease, transform 160ms ease;\n}\n.lc2-engine-btn-primary:hover {\n  background: var(--color-fuchsia-bright);\n  transform: translateY(-1px);\n}\n.lc2-engine-btn-primary:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n  transform: none;\n}\n.lc2-engine-slider {\n  appearance: none;\n  width: 100%;\n  height: 4px;\n  border-radius: 2px;\n  background: var(--color-line-strong);\n  outline: none;\n}\n.lc2-engine-slider::-webkit-slider-thumb {\n  appearance: none;\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  cursor: pointer;\n  box-shadow: 0 0 8px rgba(255, 26, 140, 0.6);\n}\n.lc2-engine-note {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  line-height: 1.45;\n  margin-top: 8px;\n}\n.lc2-engine-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  padding: 12px 14px;\n  border-radius: 12px;\n  border: 1px solid var(--color-line);\n  background: linear-gradient(180deg, rgba(28, 28, 37, 0.8), rgba(11, 11, 16, 0.92));\n  margin-bottom: 14px;\n}\n.lc2-engine-chips {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.lc2-engine-chip {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 10px;\n  border-radius: var(--radius-pill);\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-text-secondary);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.lc2-engine-chip.on {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n  background: var(--color-fuchsia-soft);\n}\n.lc2-engine-chip:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n.lc2-engine-chip-ct {\n  color: var(--color-text-tertiary);\n  font-size: 10px;\n}\n.lc2-engine-search {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  min-width: 180px;\n}\n.lc2-engine-search input {\n  background: transparent;\n  border: 0;\n  outline: none;\n  color: var(--color-ink);\n  font-size: 12px;\n  width: 100%;\n}\n.lc2-engine-select {\n  appearance: none;\n  padding: 6px 10px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink-soft);\n  font-size: 12px;\n  outline: none;\n}\n.lc2-engine-master {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  padding: 10px 12px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line);\n  background: rgba(11, 11, 16, 0.5);\n  margin-bottom: 12px;\n}\n.lc2-engine-master-lbl {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n}\n.lc2-engine-mbtn {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 10px;\n  border-radius: 8px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink-soft);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.lc2-engine-mbtn:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n.lc2-engine-counts {\n  font-size: 12px;\n  color: var(--color-text-secondary);\n  margin-bottom: 12px;\n}\n.lc2-engine-counts b {\n  color: var(--color-ink);\n}\n.lc2-engine-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 14px;\n  margin-bottom: 14px;\n}\n.lc2-engine-card {\n  position: relative;\n  border-radius: 14px;\n  border: 1px solid var(--color-line);\n  background: linear-gradient(180deg, rgba(20, 20, 28, 0.9), rgba(11, 11, 16, 0.95));\n  overflow: hidden;\n  cursor: pointer;\n  transition: border-color 180ms ease, box-shadow 220ms ease, transform 220ms ease;\n}\n.lc2-engine-card:hover {\n  border-color: var(--color-fuchsia);\n  box-shadow: var(--glow-sm);\n  transform: translateY(-2px);\n}\n.lc2-engine-card.sel {\n  border-color: var(--color-fuchsia);\n  box-shadow: 0 0 0 2px var(--color-fuchsia), 0 0 18px 2px rgba(255, 26, 140, 0.55), 0 0 42px 8px rgba(255, 26, 140, 0.22);\n  transform: translateY(-2px);\n  animation: lc-card-selected-pulse 2.6s ease-in-out infinite;\n}\n.lc2-engine-card.fresh {\n  animation: lc-card-fresh 1.2s ease-out;\n}\n@keyframes lc-card-fresh {\n