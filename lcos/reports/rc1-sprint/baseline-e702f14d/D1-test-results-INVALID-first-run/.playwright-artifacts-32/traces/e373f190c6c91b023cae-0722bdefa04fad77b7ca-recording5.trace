der-radius: 50%;\n  background: var(--color-fuchsia);\n}\n.lc2-engine-scrub {\n  position: absolute;\n  left: 12px;\n  bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.lc2-engine-scrim {\n  position: fixed;\n  inset: 0;\n  z-index: 95;\n  background: rgba(5, 5, 8, 0.65);\n  backdrop-filter: blur(4px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 200ms ease;\n}\n.lc2-engine-scrim.open {\n  opacity: 1;\n  pointer-events: auto;\n}\n.lc2-engine-modal {\n  width: 380px;\n  max-width: 100%;\n  max-height: 88vh;\n  overflow-y: auto;\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line-strong);\n  border-radius: var(--radius-card);\n  padding: 22px;\n  box-shadow: var(--shadow-e2);\n}\n.lc2-engine-modal h3 {\n  font-family: var(--font-display);\n  font-size: 18px;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\n.lc2-engine-modal-sub {\n  font-size: 12px;\n  color: var(--color-ink-soft);\n  margin-bottom: 14px;\n}\n.lc2-engine-platrow {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  padding: 10px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink-soft);\n  cursor: pointer;\n  margin-bottom: 8px;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n.lc2-engine-platrow.on {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n  background: var(--color-fuchsia-soft);\n}\n.lc2-engine-platrow:hover {\n  border-color: var(--color-fuchsia);\n}\n.lc2-engine-platrow-pi {\n  width: 32px;\n  height: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n.lc2-engine-platrow-pn {\n  flex: 1;\n  text-align: left;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--color-ink);\n}\n.lc2-engine-platrow-ph {\n  font-size: 11px;\n  colo