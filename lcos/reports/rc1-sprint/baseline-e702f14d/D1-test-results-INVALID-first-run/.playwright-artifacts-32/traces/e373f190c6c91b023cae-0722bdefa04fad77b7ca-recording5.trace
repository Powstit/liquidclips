\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #f4f1ea;\n  padding: 6px 14px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .06);\n  border: 1px solid rgba(255, 255, 255, .15);\n  cursor: pointer;\n  margin-top: 8px;\n}\n.lc-rg-retry:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .3); }\n\n.lc-rg-section {\n  display: flex; flex-direction: column; gap: 12px;\n}\n\n.lc-rg-section-head {\n  display: flex; align-items: baseline; justify-content: space-between;\n  gap: 12px;\n  padding: 0 4px;\n}\n.lc-rg-section-name {\n  display: flex; flex-direction: column; gap: 2px;\n  min-width: 0;\n}\n.lc-rg-section-label {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 16px; letter-spacing: -.012em;\n  color: #f4f1ea;\n}\n.lc-rg-section-sub {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .1em;\n  color: #86837e;\n}\n.lc-rg-section-total {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #c8c4be;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  white-space: nowrap;\n}\n\n.lc-rg-row {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 12px;\n}\n\n.lc-rg-empty-row {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #86837e;\n  padding: 14px 16px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px dashed rgba(255, 255, 255, .08);\n}\n"],["STYLE",{},".lc-ann {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 12px;\n}\n\n.lc-ann-card {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 6px;\n}\n\n.lc-ann-head {\n  display: flex; align-items: center; justify-content: space-between;\n}\n.lc-ann-kind {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-ann-kind-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-ann-kind.is-mission_drop  { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-ann-kind.is-mission_drop  .lc-ann-kind-dot { background: #ff66b8; box-shadow: 0 0 4px rgba(255, 26, 140, .55); }\n.lc-ann-kind.is-payout        { color: #6ee7b7; background: rgba(110, 231, 183, .1); border-color: rgba(110, 231, 183, .45); }\n.lc-ann-kind.is-payout        .lc-ann-kind-dot { background: #6ee7b7; box-shadow: 0 0 4px rgba(110, 231, 183, .55); }\n.lc-ann-kind.is-rule_change   { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .4); }\n.lc-ann-kind.is-rule_change   .lc-ann-kind-dot { background: #fbbf24; box-shadow: 0 0 4px rgba(251, 191, 36, .55); }\n.lc-ann-kind.is-deadline      { color: #ff8b8b; background: rgba(255, 139, 139, .1); border-color: rgba(255, 139, 139, .45); }\n.lc-ann-kind.is-deadline      .lc-ann-kind-dot { background: #ff8b8b; box-shadow: 0 0 4px rgba(255, 139, 139, .55); }\n.lc-ann-kind.is-other         { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .35); }\n.lc-ann-kind.is-other         .lc-ann-kind-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n\n.lc-ann-time {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  color: #86837e;\n}\n\n.lc-ann-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 14px; letter-spacing: -.012em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-ann-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.45;\n  color: #b1aea8;\n  margin: 0;\n}\n\n.lc-ann-empty {\n  padding: 14px 16px !important;\n  display: flex; flex-direction: column; gap: 4px;\n  border-style: dashed !important;\n}\n.lc-ann-empty-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-ann-empty-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n}\n"],["STYLE",{},".lc-rdd {\n  display: flex; flex-direction: column; gap: 16px;\n}\n\n.lc-rdd-head {\n  display: flex; gap: 8px; align-items: center;\n  flex-wrap: wrap;\n}\n.lc-rdd-tier,\n.lc-rdd-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-rdd-tier-dot,\n.lc-rdd-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-rdd-tier.is-free,\n.lc-rdd-tier.is-free_paid { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .35); }\n.lc-rdd-tier.is-free      .lc-rdd-tier-dot,\n.lc-rdd-tier.is-free_paid .lc-rdd-tier-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n.lc-rdd-tier.is-paid       { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-rdd-tier.is-paid       .lc-rdd-tier-dot { background: #ff66b8; box-shadow: 0 0 4px rgba(255, 26, 140, .55); }\n.lc-rdd-tier.is-paid_admin { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .4); }\n.lc-rdd-tier.is-paid_admin .lc-rdd-tier-dot { background: #fbbf24; box-shadow: 0 0 4px rgba(251, 191, 36, .55); }\n\n.lc-rdd-status.is-open    { color: #7fd9e8; }\n.lc-rdd-status.is-open    .lc-rdd-status-dot { background: #7fd9e8; box-shadow: 0 0 5px rgba(7, 199, 224, .55); }\n.lc-rdd-status.is-coming  { color: #fbbf24; }\n.lc-rdd-status.is-coming  .lc-rdd-status-dot { background: #fbbf24; box-shadow: 0 0 5px rgba(251, 191, 36, .55); }\n.lc-rdd-status.is-locked  { color: #ff66b8; }\n.lc-rdd-status.is-locked  .lc-rdd-status-dot { background: #ff66b8; box-shadow: 0 0 5px rgba(255, 26, 140, .55); }\n.lc-rdd-status.is-admin   { color: #86837e; }\n.lc-rdd-status.is-admin   .lc-rdd-status-dot { background: #86837e; }\n\n.lc-rdd-purpose {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13.5px; line-height: 1.5;\n  color: #d8d4cd;\n  margin: 0;\n}\n\n.lc-rdd-meta {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-rdd-meta-row {\n  display: grid; grid-template-columns: 110px 1fr;\n  align-items: baseline; gap: 10px;\n}\n.lc-rdd-meta-k {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-rdd-meta-v {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px;\n  color: #f4f1ea;\n}\n.lc-rdd-meta-v.mono {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11.5px;\n  color: #7fd9e8;\n  word-break: break-all;\n}\n\n.lc-rdd-locked {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 8px;\n  background: rgba(255, 26, 140, .08) !important;\n  border-color: rgba(255, 102, 184, .45) !important;\n}\n.lc-rdd-locked-eb,\n.lc-rdd-coming-eb,\n.lc-rdd-admin-eb,\n.lc-rdd-perks-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-rdd-coming-eb { color: #fbbf24; }\n.lc-rdd-admin-eb  { color: #86837e; }\n.lc-rdd-perks-eb  { color: #ffa3d0; }\n.lc-rdd-locked-body,\n.lc-rdd-coming-body,\n.lc-rdd-admin-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; line-height: 1.45;\n  color: #f4f1ea;\n  margin: 0;\n}\n\n.lc-rdd-perks {\n  display: flex; flex-direction: column; gap: 6px;\n  margin-top: 4px;\n}\n.lc-rdd-perks-list {\n  margin: 0;\n  padding-left: 18px;\n  display: flex; flex-direction: column; gap: 4px;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #d8d4cd;\n}\n\n.lc-rdd-coming,\n.lc-rdd-admin {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 4px;\n}\n.lc-rdd-coming { background: rgba(251, 191, 36, .07) !important; border-color: rgba(251, 191, 36, .4) !important; }\n.lc-rdd-admin  { background: rgba(255, 255, 255, .03) !important; border-color: rgba(255, 255, 255, .15) !important; }\n\n.lc-rdd-nomirror {\n  padding: 10px 14px !important;\n  border-style: dashed !important;\n}\n.lc-rdd-nomirror-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n}\n\n.lc-rdd-visited {\n  display: inline-flex; align-items: center; gap: 8px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #c8c4be;\n  cursor: pointer;\n  user-select: none;\n  padding: 6px 0;\n}\n.lc-rdd-visited input { accent-color: #ff66b8; cursor: pointer; }\n.lc-rdd-visited-note { color: #555; text-transform: none; letter-spacing: .04em; font-size: 10.5px; }\n\n.lc-rdd-foot {\n  display: flex; gap: 10px; flex-wrap: wrap; align-items: center;\n  padding-top: 8px;\n  border-top: 1px solid rgba(255, 255, 255, .06);\n}\n\n.lc-rdd-btn {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 650; font-size: 12.5px;\n  padding: 9px 18px;\n  border-radius: 9999px;\n  cursor: pointer;\n  transition: all .14s;\n  border: 1px solid rgba(255, 255, 255, .15);\n  background: rgba(255, 255, 255, .04);\n  color: #f4f1ea;\n}\n.lc-rdd-btn:hover:not(:disabled) {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n}\n.lc-rdd-btn:disabled {\n  opacity: .4;\n  cursor: not-allowed;\n}\n.lc-rdd-btn-quiet { color: #c8c4be; }\n.lc-rdd-btn-primary {\n  border-color: rgba(255, 26, 140, .55);\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  color: white;\n}\n.lc-rdd-btn-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 22px rgba(255, 26, 140, .3);\n}\n\n.lc-rdd-mirror-note {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-rdd-mirror-sub {\n  text-transform: none; letter-spacing: .02em; font-size: 10.5px;\n  color: #6c6964;\n}\n"],["STYLE",{},".lc-fd {\n  padding: 18px 22px !important;\n  display: flex;\n  background: linear-gradient(135deg, rgba(255, 26, 140, .08), rgba(7, 199, 224, .05)) !important;\n  border-color: rgba(255, 102, 184, .35) !important;\n}\n\n.lc-fd-shell {\n  all: unset;\n  display: flex; flex-direction: column; gap: 10px;\n  cursor: pointer;\n  width: 100%;\n}\n.lc-fd-shell:focus-visible {\n  outline: 2px solid rgba(255, 26, 140, .55);\n  outline-offset: 4px;\n  border-radius: 8px;\n}\n\n.lc-fd-head {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 10px;\n}\n.lc-fd-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-fd-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 10px;\n  border-radius: 9999px;\n  background: rgba(7, 199, 224, .1);\n  border: 1px solid rgba(7, 199, 224, .35);\n  color: #7fd9e8;\n}\n.lc-fd-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #7fd9e8;\n  box-shadow: 0 0 5px rgba(7, 199, 224, .55);\n}\n\n.lc-fd-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 22px; letter-spacing: -.016em;\n  color: #f4f1ea;\n  margin: 0;\n}\n\n.lc-fd-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13.5px; line-height: 1.5;\n  color: #d8d4cd;\n  margin: 0;\n}\n\n.lc-fd-foot {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 12px;\n  margin-top: 6px;\n  padding-top: 10px;\n  border-top: 1px dashed rgba(255, 255, 255, .08);\n}\n\n.lc-fd-meta {\n  display: flex; gap: 6px; flex-wrap: wrap;\n}\n.lc-fd-meta-pill {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-fd-meta-pill.is-lane {\n  color: #ffa3d0;\n  background: rgba(255, 102, 184, .08);\n  border-color: rgba(255, 102, 184, .35);\n}\n\n.lc-fd-cta-group {\n  display: inline-flex; align-items: center; gap: 12px;\n}\n\n.lc-fd-cta-primary {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 13px;\n  padding: 8px 16px;\n  border-radius: 9999px;\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  color: white;\n  border: 1px solid rgba(255, 26, 140, .55);\n}\n\n.lc-fd-cta-secondary {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 12px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .15);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-fd-cta-secondary:hover {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n  color: #f4f1ea;\n}\n"],["STYLE",{},".lc-lbs {\n  padding: 16px 18px !important;\n  display: flex; flex-direction: column; gap: 12px;\n}\n\n.lc-lbs-empty {\n  padding: 16px 18px !important;\n  display: flex; flex-direction: column; gap: 6px;\n  border-style: dashed !important;\n}\n.lc-lbs-empty-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  color: #86837e;\n  text-transform: uppercase;\n}\n.lc-lbs-empty-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n}\n\n.lc-lbs-head {\n  display: flex; align-items: baseline; justify-content: space-between;\n  gap: 12px;\n}\n.lc-lbs-head-left {\n  display: flex; flex-direction: column; gap: 2px;\n  min-width: 0;\n}\n.lc-lbs-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-lbs-sub {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  color: #86837e;\n}\n.lc-lbs-refresh {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .16em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(7, 199, 224, .1);\n  border: 1px solid rgba(7, 199, 224, .35);\n  color: #7fd9e8;\n  white-space: nowrap;\n}\n\n.lc-lbs-rows {\n  display: flex; flex-direction: column; gap: 8px;\n}\n\n.lc-lbs-row {\n  display: grid;\n  grid-template-columns: 42px 1fr auto;\n  gap: 12px;\n  align-items: center;\n  padding: 10px 12px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px solid rgba(255, 255, 255, .06);\n  position: relative;\n}\n.lc-lbs-row.is-caller {\n  background: linear-gradient(90deg, rgba(255, 26, 140, .12), rgba(7, 199, 224, .06));\n  border-color: rgba(255, 102, 184, .55);\n  box-shadow: 0 0 0 1px rgba(255, 26, 140, .1), 0 4px 14px rgba(255, 26, 140, .08);\n}\n\n.lc-lbs-rank-wrap {\n  position: relative;\n  width: 38px; height: 38px;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.lc-lbs-rank-img {\n  width: 38px; height: 38px;\n  object-fit: contain;\n  display: block;\n}\n.lc-lbs-rank-num {\n  position: absolute;\n  inset: 0;\n  display: flex; align-items: center; justify-content: center;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 12px; font-weight: 700; letter-spacing: -.01em;\n  color: #f4f1ea;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, .6);\n}\n\n.lc-lbs-mid {\n  display: flex; flex-direction: column; gap: 2px;\n  min-width: 0;\n}\n.lc-lbs-handle {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 14px; letter-spacing: -.012em;\n  color: #f4f1ea;\n}\n.lc-lbs-row.is-caller .lc-lbs-handle { color: #ffa3d0; }\n.lc-lbs-sub {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  color: #86837e;\n  text-transform: uppercase;\n}\n\n.lc-lbs-earn {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 14px; font-weight: 700; letter-spacing: -.01em;\n  color: #6ee7b7;\n}\n.lc-lbs-row.is-caller .lc-lbs-earn { color: #ffd0e9; }\n\n.lc-lbs-caller-crown {\n  position: absolute;\n  top: -10px; right: 14px;\n  width: 22px; height: 22px;\n  filter: drop-shadow(0 4px 10px rgba(255, 26, 140, .55));\n}\n\n.lc-lbs-divider {\n  display: flex; align-items: center; gap: 10px;\n  margin: 6px 0;\n}\n.lc-lbs-divider-line {\n  flex: 1;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .12), transparent);\n}\n.lc-lbs-divider-label {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #86837e;\n  white-space: nowrap;\n}\n"],["STYLE",{},".lc-cb {\n  padding: 14px 16px !important;\n  display: flex;\n  background: linear-gradient(120deg,\n    rgba(255, 26, 140, .12) 0%,\n    rgba(7, 199, 224, .06) 65%,\n    rgba(20, 20, 28, .55) 100%) !important;\n  border-color: rgba(255, 102, 184, .35) !important;\n}\n\n.lc-cb-body {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  gap: 14px;\n  align-items: center;\n  width: 100%;\n}\n\n.lc-cb-art-wrap {\n  width: 56px; height: 56px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 12px;\n  background: rgba(0, 0, 0, .25);\n  border: 1px solid rgba(255, 255, 255, .08);\n}\n.lc-cb-art {\n  width: 48px; height: 48px;\n  object-fit: contain;\n}\n\n.lc-cb-text {\n  display: flex; flex-direction: column; gap: 3px;\n  min-width: 0;\n}\n.lc-cb-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-cb-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 15px; letter-spacing: -.012em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-cb-sub {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.45;\n  color: #d8d4cd;\n  margin: 0;\n}\n\n.lc-cb-cta {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 12.5px;\n  padding: 8px 16px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 26, 140, .55);\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  color: white;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: all .14s;\n}\n.lc-cb-cta:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 22px rgba(255, 26, 140, .3);\n}\n"],["STYLE",{},".lc-ach-toast {\n  position: fixed;\n  top: 24px; right: 24px;\n  z-index: 9000;\n  display: grid;\n  grid-template-columns: 64px 1fr auto;\n  gap: 14px;\n  align-items: center;\n  width: 380px;\n  max-width: calc(100vw - 48px);\n  padding: 14px 16px;\n  border-radius: 16px;\n  background: linear-gradient(135deg, rgba(20, 8, 24, .92), rgba(8, 8, 14, .92));\n  border: 1px solid rgba(255, 102, 184, .55);\n  box-shadow:\n    0 0 0 1px rgba(255, 26, 140, .15),\n    0 18px 48px rgba(255, 26, 140, .35),\n    0 0 80px rgba(255, 26, 140, .18);\n  -webkit-backdrop-filter: blur(14px);\n          backdrop-filter: blur(14px);\n}\n\n.lc-ach-toast-art-wrap {\n  position: relative;\n  width: 64px; height: 64px;\n  display: flex; align-items: center; justify-content: center;\n}\n.lc-ach-toast-art {\n  width: 56px; height: 56px;\n  object-fit: contain;\n  filter: drop-shadow(0 4px 14px rgba(255, 26, 140, .55));\n  position: relative; z-index: 1;\n}\n.lc-ach-toast-burst {\n  position: absolute;\n  inset: -6px;\n  border-radius: 50%;\n  background: radial-gradient(circle at center,\n    rgba(255, 26, 140, .35) 0%,\n    rgba(255, 26, 140, 0) 60%);\n  pointer-events: none;\n  animation: lc-ach-pulse 2.4s ease-out infinite;\n}\n\n@keyframes lc-ach-pulse {\n  0%, 100% { transform: scale(1); opacity: .85; }\n  50%      { transform: scale(1.18); opacity: .55; }\n}\n\n.lc-ach-toast-body {\n  display: flex; flex-direction: column; gap: 3px;\n  min-width: 0;\n}\n.lc-ach-toast-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-ach-toast-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 16px; letter-spacing: -.012em;\n  color: #fff5fb;\n}\n.lc-ach-toast-blurb {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.45;\n  color: #d8d4cd;\n}\n\n.lc-ach-toast-close {\n  width: 24px; height: 24px;\n  display: inline-flex; align-items: center; justify-content: center;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n  font-size: 16px; line-height: 1;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-ach-toast-close:hover {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n  color: #f4f1ea;\n}\n"],["STYLE",{},".lc-cal-row {\n  padding: 12px 14px !important;\n}\n.lc-cal-row.is-note {\n  border-style: dashed !important;\n  background: rgba(255, 255, 255, .02) !important;\n}\n\n.lc-cal-row-body {\n  display: flex; flex-direction: column; gap: 6px;\n  cursor: pointer;\n}\n.lc-cal-row.is-note .lc-cal-row-body { cursor: default; }\n.lc-cal-row-body:focus-visible {\n  outline: 2px solid rgba(255, 26, 140, .55);\n  outline-offset: 4px;\n  border-radius: 8px;\n}\n\n.lc-cal-row-head {\n  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;\n}\n\n.lc-cal-type {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 255, 255, .14);\n  background: rgba(255, 255, 255, .04);\n  color: #c8c4be;\n}\n.lc-cal-type.is-google_drive { color: #6ee7b7; background: rgba(110, 231, 183, .1); border-color: rgba(110, 231, 183, .45); }\n.lc-cal-type.is-dropbox      { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .45); }\n.lc-cal-type.is-whop         { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-cal-type.is-direct_url   { color: #d8d4cd; }\n.lc-cal-type.is-upload_note  { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .45); }\n\n.lc-cal-required {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .1);\n  border: 1px solid rgba(255, 102, 184, .55);\n  color: #ffa3d0;\n}\n\n.lc-cal-visibility {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .03);\n  border: 1px solid rgba(255, 255, 255, .1);\n  color: #86837e;\n}\n.lc-cal-visibility.is-joined   { color: #c8c4be; border-color: rgba(255, 255, 255, .25); }\n.lc-cal-visibility.is-approved { color: #fbbf24; border-color: rgba(251, 191, 36, .4); }\n\n.lc-cal-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 14px; letter-spacing: -.008em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-cal-url {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11px; letter-spacing: .04em;\n  color: #7fd9e8;\n}\n.lc-cal-notes {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n.lc-cal-foot {\n  display: flex; justify-content: flex-end;\n  padding-top: 2px;\n}\n.lc-cal-open {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n"],["STYLE",{},".lc-cal-list {\n  display: flex; flex-direction: column; gap: 8px;\n}\n\n.lc-cal-list-safe {\n  display: flex; flex-direction: column; gap: 4px;\n  padding: 14px 16px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px dashed rgba(255, 255, 255, .12);\n}\n.lc-cal-list-safe.is-error  { background: rgba(255, 139, 139, .06); border-style: solid; border-color: rgba(255, 139, 139, .35); }\n.lc-cal-list-safe.is-empty  { background: rgba(255, 255, 255, .02); }\n.lc-cal-list-safe-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-cal-list-safe.is-error .lc-cal-list-safe-eb { color: #ff8b8b; }\n.lc-cal-list-safe-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n"],["STYLE",{},".lc-wrc {\n  padding: 14px 16px !important;\n  display: flex; flex-direction: column; gap: 10px;\n}\n.lc-wrc-unlinked { border-style: dashed !important; }\n/* URL-first patch · \"no enrichment\" is NEUTRAL, not failure.\n   The URL is still the source of truth · we just don't have a Whop\n   snapshot to enrich the card with. */\n.lc-wrc-unreachable, .lc-wrc-not_visible {\n  background: rgba(255, 255, 255, .03) !important;\n  border-color: rgba(255, 255, 255, .14) !important;\n  border-style: dashed !important;\n}\n\n.lc-wrc-head {\n  display: flex; justify-content: space-between; align-items: flex-start;\n  gap: 12px;\n}\n.lc-wrc-head-left {\n  display: flex; gap: 6px; flex-wrap: wrap; align-items: center;\n}\n\n.lc-wrc-pill {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 3px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n}\n.lc-wrc-pill.is-live, .lc-wrc-pill.is-funded {\n  color: #6ee7b7;\n  background: rgba(110, 231, 183, .1);\n  border-color: rgba(110, 231, 183, .45);\n}\n.lc-wrc-pill.is-partially_funded {\n  color: #fbbf24;\n  background: rgba(251, 191, 36, .1);\n  border-color: rgba(251, 191, 36, .45);\n}\n.lc-wrc-pill.is-connected, .lc-wrc-pill.is-pending_reward {\n  color: #7fd9e8;\n  background: rgba(7, 199, 224, .1);\n  border-color: rgba(7, 199, 224, .35);\n}\n.lc-wrc-pill.is-capacity_reached, .lc-wrc-pill.is-closed {\n  color: #86837e;\n}\n/* URL-first patch · neutral \"no enrichment\" pill. Not red. */\n.lc-wrc-pill.is-unreachable, .lc-wrc-pill.is-not_visible {\n  color: #c8c4be;\n  background: rgba(255, 255, 255, .04);\n  border-color: rgba(255, 255, 255, .14);\n}\n.lc-wrc-pill.is-unlinked { color: #86837e; }\n.lc-wrc-pill.is-stale { color: #fbbf24; }\n\n.lc-wrc-meta {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .16em;\n  text-transform: uppercase;\n  color: #86837e;\n  padding: 3px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .03);\n  border: 1px solid rgba(255, 255, 255, .08);\n}\n\n.lc-wrc-refresh-icon {\n  font-size: 16px;\n  color: #c8c4be;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  border-radius: 9999px;\n  width: 28px; height: 28px;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-wrc-refresh-icon:hover:not(:disabled) {\n  color: #f4f1ea;\n  border-color: rgba(255, 255, 255, .3);\n  transform: rotate(180deg);\n}\n.lc-wrc-refresh-icon:disabled { opacity: .5; cursor: wait; animation: lc-wrc-spin 1s linear infinite; }\n@keyframes lc-wrc-spin { to { transform: rotate(360deg); } }\n\n.lc-wrc-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 18px; letter-spacing: -.014em;\n  color: #f4f1ea;\n  margin: 0;\n}\n\n.lc-wrc-id-row {\n  display: flex; align-items: center; gap: 8px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n}\n.lc-wrc-id-label {\n  font-size: 9px; letter-spacing: .18em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-wrc-id-code {\n  font-size: 11.5px;\n  color: #7fd9e8;\n  padding: 3px 8px;\n  border-radius: 6px;\n  background: rgba(7, 199, 224, .06);\n  border: 1px solid rgba(7, 199, 224, .25);\n}\n.lc-wrc-copy {\n  display: inline-flex; align-items: center; gap: 5px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #c8c4be;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-wrc-copy:hover {\n  color: #f4f1ea;\n  border-color: rgba(255, 255, 255, .3);\n  background: rgba(255, 255, 255, .08);\n}\n.lc-wrc-copy.is-copied {\n  color: #6ee7b7;\n  border-color: rgba(110, 231, 183, .55);\n  background: rgba(110, 231, 183, .08);\n}\n\n.lc-wrc-stats {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n  gap: 8px;\n}\n.lc-wrc-stat {\n  display: flex; flex-direction: column; gap: 2px;\n  padding: 8px 10px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px solid rgba(255, 255, 255, .06);\n}\n.lc-wrc-stat-label {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-wrc-stat-value {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 13px; font-weight: 700;\n  color: #f4f1ea;\n}\n\n.lc-wrc-desc {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n\n.lc-wrc-foot {\n  display: flex; justify-content: space-between; align-items: center;\n  gap: 10px;\n  padding-top: 6px;\n  border-top: 1px dashed rgba(255, 255, 255, .08);\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-wrc-source { color: #ffa3d0; }\n\n.lc-wrc-error {\n  display: flex; flex-direction: column; gap: 8px;\n}\n/* URL-first patch · neutral body copy for \"no enrichment\" empty state. */\n.lc-wrc-error-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n.lc-wrc-open-whop {\n  align-self: flex-start;\n  display: inline-flex; align-items: center; gap: 5px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 14px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .08);\n  border: 1px solid rgba(255, 102, 184, .35);\n  color: #ffa3d0;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-wrc-open-whop:hover {\n  background: rgba(255, 102, 184, .14);\n  color: #ffd0e7;\n  border-color: rgba(255, 102, 184, .55);\n}\n.lc-wrc-error-detail {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px;\n  color: #86837e;\n  margin: 0;\n}\n.lc-wrc-refresh {\n  align-self: flex-start;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 14px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .25);\n  color: #c8c4be;\n  cursor: pointer;\n}\n.lc-wrc-empty {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n  margin: 0;\n}\n"],["STYLE",{},".lc-camp-shell {\n  display: flex; flex-direction: column; gap: 16px;\n}\n\n/* Hero */\n.lc-camp-shell-hero {\n  position: relative;\n  height: 160px;\n  border-radius: 14px;\n  overflow: hidden;\n  background: rgba(20, 20, 28, .5);\n  border: 1px solid rgba(255, 255, 255, .08);\n}\n.lc-camp-shell-hero.is-featured  { border-color: rgba(255, 102, 184, .45); }\n.lc-camp-shell-hero.is-sponsored { border-color: rgba(255, 165, 0, .45); }\n.lc-camp-shell-hero-art {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  object-fit: cover;\n}\n.lc-camp-shell-hero-overlay {\n  position: absolute; inset: 0;\n  display: flex; flex-direction: column; justify-content: flex-end;\n  gap: 6px;\n  padding: 14px 16px;\n  background: linear-gradient(0deg, rgba(8, 8, 14, .82) 0%, rgba(8, 8, 14, .35) 50%, transparent 100%);\n}\n.lc-camp-shell-hero-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ffa3d0;\n}\n.lc-camp-shell-hero-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  align-self: flex-start;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(0, 0, 0, .55);\n  border: 1px solid rgba(255, 255, 255, .15);\n  color: #c8c4be;\n}\n.lc-camp-shell-hero-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-camp-shell-hero-status.is-live          { color: #6ee7b7; border-color: rgba(110, 231, 183, .45); }\n.lc-camp-shell-hero-status.is-live          .lc-camp-shell-hero-status-dot { background: #6ee7b7; }\n.lc-camp-shell-hero-status.is-coming_soon   { color: #fbbf24; border-color: rgba(251, 191, 36, .45); }\n.lc-camp-shell-hero-status.is-coming_soon   .lc-camp-shell-hero-status-dot { background: #fbbf24; }\n.lc-camp-shell-hero-status.is-funded        { color: #7fd9e8; border-color: rgba(7, 199, 224, .45); }\n.lc-camp-shell-hero-status.is-funded        .lc-camp-shell-hero-status-dot { background: #7fd9e8; }\n\n/* Sections */\n.lc-camp-shell-section {\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-camp-shell-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-camp-shell-desc {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13.5px; line-height: 1.5;\n  color: #d8d4cd;\n  margin: 0;\n}\n\n/* Card-style blocks */\n.lc-camp-shell-card {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-camp-shell-row {\n  display: grid;\n  grid-template-columns: 130px 1fr;\n  align-items: baseline;\n  gap: 10px;\n}\n.lc-camp-shell-row-k {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-camp-shell-row-v {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; color: #f4f1ea;\n}\n.lc-camp-shell-row-sub {\n  grid-column: 2 / -1;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .08em;\n  color: #86837e;\n  margin-top: -4px;\n}\n.lc-camp-shell-row-summary {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 14px; font-weight: 700; letter-spacing: -.01em;\n  color: #6ee7b7;\n  margin: 0;\n}\n\n.lc-camp-shell-empty {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n}\n\n/* Asset list */\n.lc-camp-shell-assets {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-camp-shell-asset {\n  display: flex; flex-direction: column; gap: 4px;\n  padding: 10px 12px;\n  border-radius: 10px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px solid rgba(255, 255, 255, .08);\n}\n.lc-camp-shell-asset-head {\n  display: flex; align-items: center; justify-content: space-between;\n}\n.lc-camp-shell-asset-kind {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  color: #7fd9e8;\n}\n.lc-camp-shell-asset-status {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 2px 8px;\n  border-radius: 9999px;\n  background: rgba(110, 231, 183, .1);\n  border: 1px solid rgba(110, 231, 183, .45);\n  color: #6ee7b7;\n}\n.lc-camp-shell-asset-status.is-pending_link { background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .45); color: #fbbf24; }\n.lc-camp-shell-asset-status.is-stale        { background: rgba(255, 165, 0, .1); border-color: rgba(255, 165, 0, .45); color: #ffd591; }\n.lc-camp-shell-asset-status.is-error        { background: rgba(255, 139, 139, .1); border-color: rgba(255, 139, 139, .45); color: #ff8b8b; }\n.lc-camp-shell-asset-label {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; color: #f4f1ea;\n}\n.lc-camp-shell-asset-manifest {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .08em;\n  color: #86837e;\n}\n\n/* Discussion CTA */\n.lc-camp-shell-discussion-btn {\n  align-self: flex-start;\n  margin-top: 4px;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600; font-size: 12.5px;\n  padding: 8px 14px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .15);\n  color: #f4f1ea;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-camp-shell-discussion-btn:hover {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n}\n\n/* Footer */\n.lc-camp-shell-foot {\n  display: flex; gap: 10px; flex-wrap: wrap;\n  padding-top: 8px;\n  border-top: 1px solid rgba(255, 255, 255, .06);\n}\n.lc-camp-shell-btn {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 650; font-size: 12.5px;\n  padding: 9px 18px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .15);\n  color: #f4f1ea;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-camp-shell-btn:hover {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n}\n.lc-camp-shell-btn-quiet { color: #c8c4be; }\n.lc-camp-shell-btn-primary {\n  border-color: rgba(255, 26, 140, .55);\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  color: white;\n}\n.lc-camp-shell-btn-primary:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 22px rgba(255, 26, 140, .3);\n}\n\n/* 6N-G · §8 snapshot qualifier · italic suffix on Reward/Payout eyebrows. */\n.lc-camp-shell-qualifier {\n  font-style: italic;\n  font-weight: 400;\n  font-size: 9.5px;\n  letter-spacing: .14em;\n  color: #ffa3d0;\n  text-transform: none;\n}\n"],["STYLE",{},"/* UpdateReadyIndicator · Wave D1 · j015-runtime-update\n *\n * Bottom-right pill · non-blocking · matches the visual language of\n * UpdateBeacon.css (which we're replacing) so the pill still fits in\n * the brand vocabulary.\n */\n\n.lc-update-indicator {\n  position: fixed;\n  right: 16px;\n  bottom: 16px;\n  z-index: 40;\n  contain: layout paint style;\n  animation: lc-update-indicator-fade-in 220ms ease-out both;\n}\n\n@keyframes lc-update-indicator-fade-in {\n  from { opacity: 0; transform: translateY(6px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n.lc-update-indicator-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 14px;\n  border-radius: 999px;\n  background: rgba(20, 4, 34, 0.94);\n  color: #f6f3ff;\n  border: 1px solid rgba(255, 92, 232, 0.4);\n  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.4);\n  font-size: 13px;\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  cursor: pointer;\n  transition: background 100ms ease-out, border-color 100ms ease-out;\n}\n\n.lc-update-indicator-btn:hover {\n  background: rgba(30, 6, 48, 0.98);\n  border-color: rgba(255, 92, 232, 0.7);\n}\n\n.lc-update-indicator-btn:focus-visible {\n  outline: 2px solid #ff5ce8;\n  outline-offset: 2px;\n}\n\n.lc-update-indicator-dot {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #ff5ce8;\n  box-shadow: 0 0 8px rgba(255, 92, 232, 0.65);\n}\n\n.lc-update-indicator[data-deferred=\"true\"] .lc-update-indicator-dot {\n  background: #ffd166;\n  box-shadow: 0 0 8px rgba(255, 209, 102, 0.5);\n}\n\n.lc-update-indicator-copy {\n  white-space: nowrap;\n}\n"],["STYLE",{},"/* RestartGate · Wave D1 · j015-runtime-update\n *\n * Full-viewport blocker · matches the visual language of the\n * HardUpdateGate (which handles security updates) so the two gates\n * feel like part of the same family.\n */\n\n.lc-restart-gate-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 90000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  background: radial-gradient(circle at 50% 30%, rgba(255, 92, 232, 0.15), transparent 55%),\n              rgba(4, 0, 14, 0.94);\n  contain: layout paint style;\n  animation: lc-restart-gate-fade-in 180ms ease-out both;\n}\n\n@keyframes lc-restart-gate-fade-in {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\n\n.lc-restart-gate-card {\n  max-width: 460px;\n  width: 100%;\n  padding: 28px 28px 24px;\n  border-radius: 20px;\n  background: rgba(14, 2, 30, 0.98);\n  border: 1px solid rgba(255, 92, 232, 0.45);\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);\n  color: #f6f3ff;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  text-align: left;\n}\n\n.lc-restart-gate-eb {\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: rgba(255, 92, 232, 0.85);\n  font-weight: 600;\n}\n\n.lc-restart-gate-title {\n  font-size: 22px;\n  line-height: 1.15;\n  margin: 0;\n  font-weight: 600;\n  letter-spacing: -0.005em;\n}\n\n.lc-restart-gate-body {\n  font-size: 14px;\n  line-height: 1.5;\n  margin: 0;\n  color: rgba(246, 243, 255, 0.86);\n}\n\n.lc-restart-gate-versions {\n  font-size: 12px;\n  color: rgba(246, 243, 255, 0.6);\n  margin: 4px 0 0;\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.lc-restart-gate-cta {\n  margin-top: 6px;\n  padding: 12px 18px;\n  border-radius: 12px;\n  background: linear-gradient(180deg, #ff5ce8 0%, #d64bc7 100%);\n  color: #fff;\n  border: none;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: transform 100ms ease-out, box-shadow 100ms ease-out;\n  box-shadow: 0 6px 22px rgba(255, 92, 232, 0.35);\n}\n\n.lc-restart-gate-cta:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 28px rgba(255, 92, 232, 0.45);\n}\n\n.lc-restart-gate-cta:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 2px;\n}\n\n.lc-restart-gate-cta:disabled {\n  opacity: 0.6;\n  cursor: progress;\n}\n"],["STYLE",{},"