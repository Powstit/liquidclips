sform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;\n}\n.lc-home-task-card:hover {\n  transform: translateY(-2px);\n  border-color: rgba(255, 26, 140, 0.4);\n  box-shadow: var(--shadow-e2), 0 0 0 1px rgba(255, 26, 140, 0.2);\n}\n.lc-home-task-card::before {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  background: radial-gradient(circle at 50% 50%, rgba(255, 26, 140, 0.18), transparent 65%);\n  opacity: 0;\n  transition: opacity 260ms ease;\n  pointer-events: none;\n}\n.lc-home-task-card:hover::before {\n  opacity: 1;\n}\n.lc-home-task-corner {\n  position: absolute;\n  width: 14px;\n  height: 14px;\n  border-color: rgba(255, 26, 140, 0.55);\n  pointer-events: none;\n  z-index: 2;\n}\n.lc-home-task-corner.tl {\n  top: 10px;\n  left: 10px;\n  border-top: 1.5px solid;\n  border-left: 1.5px solid;\n}\n.lc-home-task-corner.tr {\n  top: 10px;\n  right: 10px;\n  border-top: 1.5px solid;\n  border-right: 1.5px solid;\n}\n.lc-home-task-corner.bl {\n  bottom: 10px;\n  left: 10px;\n  border-bottom: 1.5px solid;\n  border-left: 1.5px solid;\n}\n.lc-home-task-corner.br {\n  bottom: 10px;\n  right: 10px;\n  border-bottom: 1.5px solid;\n  border-right: 1.5px solid;\n}\n.lc-home-task-card:hover .lc-home-task-corner {\n  border-color: var(--color-fuchsia);\n}\n.lc-home-task-badge {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  padding: 3px 8px;\n  border-radius: var(--radius-pill);\n  background: var(--color-paper);\n  border: 1px solid rgba(255, 26, 140, 0.3);\n  font-family: var(--font-mono);\n  font-size: 9px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n  z-index: 3;\n}\n.lc-home-task-icon {\n  width: 52px;\n  height: 52px;\n  display: grid;\n  place-items: center;\n  color: var(--color-fuchsia);\n  filter: drop-shadow(0 0 12px rgba(255, 26, 140, 0.45));\n}\n.lc-home-task-title {\n  font-size: 20px;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n  color: var(--color-ink);\n  line-height: 1.1;\n  z-index: 1;\n}\n.lc-home-task-subtitle {\n  font-size: 13px;\n  line-height: 1.45;\n  color: var(--color-text-tertiary);\n  z-index: 1;\n  min-height: 38px;\n}\n.lc-home-task-actions {\n  margin-top: auto;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  width: 100%;\n  z-index: 1;\n}\n.lc-home-task-action {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 11px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line);\n  background: rgba(255, 255, 255, 0.04);\n  color: var(--color-text-secondary);\n  font-size: 12px;\n  font-weight: 500;\n  transition: all 160ms ease;\n}\n.lc-home-task-action:hover {\n  border-color: rgba(255, 26, 140, 0.45);\n  color: var(--color-ink);\n  background: rgba(255, 255, 255, 0.07);\n}\n.lc-home-task-action.primary {\n  background: var(--color-fuchsia);\n  border-color: var(--color-fuchsia);\n  color: #fff;\n  box-shadow: 0 6px 16px rgba(255, 26, 140, 0.25);\n}\n.lc-home-task-action.primary:hover {\n  filter: brightness(1.05);\n}\n.lc-home-task-action.input {\n  flex: 1 1 100%;\n  padding: 0;\n  border: none;\n  background: transparent;\n}\n.lc-home-task-input {\n  width: 100%;\n  padding: 8px 11px;\n  border-radius: 10px;\n  border: 1px solid var(--color-line);\n  background: var(--color-paper);\n  color: var(--color-ink);\n  font-size: 12px;\n  outline: none;\n}\n.lc-home-task-input:focus {\n  border-color: var(--color-fuchsia);\n}\n.lc-home-task-input::placeholder {\n  color: var(--color-text-tertiary);\n}\n.lc-home-connect-strip, .lc-home-campaign-strip {\n  margin-top: 18px;\n  padding: 12px 16px;\n  border-radius: var(--radius-card);\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.lc-home-strip-label {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n  margin-right: auto;\n}\n.lc-home-campaign-strip {\n  gap: 16px;\n}\n.lc-home-campaign-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 12px;\n  border-radius: 12px;\n  background: var(--color-paper-elev);\n  border: 1px solid var(--color-line);\n}\n.lc-home-campaign-title {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--color-ink);\n}\n.lc-home-campaign-meta {\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  font-family: var(--font-mono);\n}\n.lc-home-recents {\n  margin-top: 22px;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n}\n@media (max-width: 900px) {\n  .lc-home-recents {\n    grid-template-columns: 1fr;\n  }\n}\n.lc-home-recent-col {\n  border-radius: var(--radius-card);\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n  padding: 16px;\n}\n.lc-home-recent-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n.lc-home-recent-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--color-fuchsia-deep);\n  font-weight: 500;\n}\n.lc-home-recent-link:hover {\n  color: var(--color-ink);\n}\n.lc-home-recent-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.lc-home-recent-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: all 160ms ease;\n}\n.lc-home-recent-item:hover {\n  border-color: rgba(255, 26, 140, 0.35);\n  background: rgba(255, 255, 255, 0.05);\n}\n.lc-home-recent-thumb {\n  width: 44px;\n  height: 44px;\n  border-radius: 8px;\n  background: linear-gradient(135deg, #2a1432, #4a1a55, #1a0f25);\n  flex-shrink: 0;\n}\n.lc-home-recent-title {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-ink);\n}\n.lc-home-recent-meta {\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  font-family: var(--font-mono);\n}\n.lc-home-persona-row {\n  margin-top: 18px;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n}\n@media (max-width: 640px) {\n  .lc-home-persona-row {\n    grid-template-columns: 1fr;\n  }\n}\n.lc-home-persona-row .lc-hero-card {\n  min-height: auto;\n  padding: 18px;\n}\n.lc-home-persona-row .lc-hero-card .lc-hero-icon {\n  width: 36px;\n  height: 36px;\n}\n.lc2-engine-source-chipbar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin-top: 8px;\n  margin-bottom: 10px;\n  padding: 7px 12px;\n  border-radius: var(--radius-card);\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n}\n.lc2-engine-source-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 12px;\n  border-radius: 12px;\n  background: var(--color-paper-elev);\n  border: 1px solid var(--color-line-strong);\n}\n.lc2-engine-source-thumb {\n  width: 44px;\n  height: 28px;\n  border-radius: 6px;\n  background: linear-gradient(135deg, #2a2230, #120e16);\n  border: 1px solid var(--color-line-strong);\n  position: relative;\n  overflow: hidden;\n}\n.lc2-engine-source-thumb::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at 70% 30%, rgba(255, 26, 140, 0.25), transparent 60%);\n}\n.lc2-engine-source-title {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--color-ink);\n}\n.lc2-engine-source-dur {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n}\n.lc2-engine-campaign-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  padding: 6px 12px 6px 6px;\n  border-radius: 12px;\n  background: linear-gradient(135deg, rgba(255, 26, 140, 0.12), var(--color-paper-elev));\n  border: 1px solid rgba(255, 26, 140, 0.25);\n}\n.lc2-engine-campaign-avatar {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--grad-fuchsia);\n  display: grid;\n  place-items: center;\n  font-size: 10px;\n  font-weight: 800;\n  color: #fff;\n}\n.lc2-engine-campaign-name {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: var(--color-ink);\n}\n.lc2-engine-campaign-meta {\n  font-size: 10px;\n  color: var(--color-fuchsia-deep);\n  font-family: var(--font-mono);\n}\n.lc-launcher-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 22px;\n  margin-top: 18px;\n}\n@media (max-width: 1200px) {\n  .lc-launcher-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@media (max-width: 640px) {\n  .lc-launcher-grid {\n    grid-template-columns: 1fr;\n  }\n}\n.lc-launcher-card {\n  position: relative;\n  min-height: 300px;\n  padding: 28px 24px 24px;\n  border-radius: var(--radius-card);\n  background: var(--color-paper-warm);\n  border: 1px solid var(--color-line);\n  box-shadow: var(--shadow-e1);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  gap: 14px;\n  overflow: hidden;\n  cursor: pointer;\n  transition: transform 220ms cubic-bezier(.2,.8,.2,1), border-color 220ms ease, box-shadow 220ms ease, background 220ms ease;\n}\n.lc-launcher-card:hover {\n  transform: scale(1.03);\n  background: rgba(28, 28, 37, 0.7);\n  border-color: rgba(255, 26, 140, 0.45);\n  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 26, 140, 0.3), 0 0 36px rgba(255, 26, 140, 0.25);\n}\n.lc-launcher-card::before {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  background: radial-gradient(circle at 50% 50%, rgba(255, 26, 140, 0.18), transparent 65%);\n  opacity: 0;\n  transition: opacity 280ms ease;\n  pointer-events: none;\n}\n.lc-launcher-card:hover::before {\n  opacity: 1;\n}\n.lc-launcher-card.expanded {\n  grid-column: 1 / -1;\n  border-color: rgba(255, 26, 140, 0.55);\n  box-shadow: var(--shadow-e2), 0 0 0 1px rgba(255, 26, 140, 0.35), 0 0 48px rgba(255, 26, 140, 0.22);\n}\n.lc-launcher-corner {\n  position: absolute;\n  width: 14px;\n  height: 14px;\n  border-color: rgba(255, 26, 140, 0.55);\n  pointer-events: none;\n  z-index: 2;\n}\n.lc-launcher-corner.tl {\n  top: 10px;\n  left: 10px;\n  border-top: 1.5px solid;\n  border-left: 1.5px solid;\n}\n.lc-launcher-corner.tr {\n  top: 10px;\n  right: 10px;\n  border-top: 1.5px solid;\n  border-right: 1.5px solid;\n}\n.lc-launcher-corner.bl {\n  bottom: 10px;\n  left: 10px;\n  border-bottom: 1.5px solid;\n  border-left: 1.5px solid;\n}\n.lc-launcher-corner.br {\n  bottom: 10px;\n  right: 10px;\n  border-bottom: 1.5px solid;\n  border-right: 1.5px solid;\n}\n.lc-launcher-card:hover .lc-launcher-corner {\n  border-color: var(--color-fuchsia);\n}\n.lc-launcher-card > .lc-launcher-icon {\n  width: 72px;\n  height: 72px;\n  display: grid;\n  place-items: center;\n  color: var(--color-fuchsia);\n  filter: drop-shadow(0 0 14px rgba(255, 26, 140, 0.55));\n  z-index: 1;\n}\n.lc-launcher-card > .lc-launcher-title {\n  font-size: 24px;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n  color: var(--color-ink);\n  line-height: 1.1;\n  z-index: 1;\n}\n.lc-launcher-card > .lc-launcher-subtitle {\n  font-size: 13px;\n  line-height: 1.45;\n  color: var(--color-text-tertiary);\n  z-index: 1;\n  max-width: 240px;\n}\n.lc-launcher-card > .lc-btn {\n  margin-top: 8px;\n  z-index: 1;\n}\n.lc-launcher-panel {\n  width: 100%;\n  z-index: 1;\n}\n.lc-launcher-panel-inner {\n  padding-top: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  text-align: left;\n}\n.lc-launcher-input-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.lc-launcher-input-row > input {\n  flex: 1;\n}\n.lc-launcher-action-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 10px;\n}\n@media (max-width: 1200px) {\n  .lc-launcher-action-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@media (max-width: 640px) {\n  .lc-launcher-action-grid {\n    grid-template-columns: 1fr;\n  }\n}\n.lc-launcher-mode-extras {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 10px;\n  padding-top: 12px;\n  border-top: 1px solid var(--color-line);\n}\n.lc-home-connect-strip.compact, .lc-home-campaign-strip.compact {\n  margin-top: 18px;\n  padding: 12px 16px;\n  flex-direction: row;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.lc-home-connect-strip.compact .lc-home-strip-label {\n  margin-right: auto;\n}\n.lc-home-strip-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.lc-home-campaign-handoffs {\n  margin-left: auto;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.lc-import-dropzone {\n  border: 2px dashed rgba(255, 26, 140, 0.35);\n  border-radius: var(--radius-card);\n  background: rgba(255, 26, 140, 0.05);\n  padding: 36px 24px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: var(--color-fuchsia);\n  transition: border-color 160ms ease, background 160ms ease;\n}\n.lc-import-dropzone:hover {\n  border-color: rgba(255, 26, 140, 0.6);\n  background: rgba(255, 26, 140, 0.09);\n}\n.lc-import-drop-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-ink);\n}\n.lc-import-drop-sub {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  text-align: center;\n}\n.lc-import-drop-formats {\n  display: flex;\n  gap: 6px;\n  margin-top: 4px;\n}\n.lc-import-actions {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 8px;\n  margin-top: 16px;\n}\n.lc-import-url-row {\n  margin-top: 12px;\n}\n.lc-drawer-lead {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 16px;\n  color: var(--color-fuchsia);\n}\n.lc-drawer-lead-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-ink);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.lc-drawer-lead-sub {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n}\n.lc-mb-16 {\n  margin-bottom: 16px;\n}\n.lc-browse-rail-tab {\n  position: fixed;\n  top: 50%;\n  right: 0;\n  transform: translate(0, -50%);\n  z-index: 60;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 16px 9px 18px;\n  min-height: 168px;\n  border: 1px solid rgba(255, 26, 140, 0.42);\n  border-right: none;\n  border-radius: 14px 0 0 14px;\n  background: linear-gradient( 180deg, rgba(26, 17, 38, 0.94) 0%, rgba(17, 12, 28, 0.96) 100% );\n  color: var(--color-ink, #f5edff);\n  cursor: pointer;\n  box-shadow: -6px 0 22px rgba(0, 0, 0, 0.55), -1px 0 0 rgba(255, 26, 140, 0.25) inset, 0 0 18px rgba(255, 26, 140, 0.32);\n  transition: transform 180ms cubic-bezier(0.2, 0.6, 0.25, 1), box-shadow 180ms ease, border-color 180ms ease, color 180ms ease;\n  font-family: var(--font-mono);\n  text-align: center;\n  -webkit-tap-highlight-color: transparent;\n}\n.lc-browse-rail-tab:hover, .lc-browse-rail-tab:focus-visible {\n  transform: translate(-6px, -50%);\n  border-color: rgba(255, 26, 140, 0.7);\n  color: var(--color-fuchsia-bright, #ff48a4);\n  box-shadow: -10px 0 28px rgba(0, 0, 0, 0.65), -1px 0 0 rgba(255, 26, 140, 0.55) inset, 0 0 26px rgba(255, 26, 140, 0.55);\n  outline: none;\n}\n.lc-browse-rail-tab:active {\n  transform: translate(-2px, -50%);\n}\n.lc-browse-rail-tab-label {\n  writing-mode: vertical-rl;\n  transform: rotate(180deg);\n  font-size: 10.5px;\n  letter-spacing: 0.28em;\n  text-transform: uppercase;\n  color: inherit;\n}\n.lc-browse-rail-tab-glow {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  background: radial-gradient( 120% 80% at 0% 50%, rgba(255, 26, 140, 0.22) 0%, transparent 70% );\n  opacity: 0.85;\n}\n.lc-browse-scrim {\n  position: fixed;\n  inset: 0;\n  z-index: 70;\n  background: rgba(0, 0, 0, 0.55);\n  backdrop-filter: blur(6px);\n  -webkit-backdrop-filter: blur(6px);\n  animation: lc-browse-scrim-in 200ms ease-out;\n}\n@keyframes lc-browse-scrim-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n.lc-browse-overlay {\n  position: fixed;\n  width: 90vw;\n  height: 88vh;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 75;\n  display: flex;\n  flex-direction: column;\n  border-radius: 20px;\n  background: var(--color-paper);\n  border: 1px solid rgba(255, 26, 140, 0.25);\n  box-shadow: 0 0 0 1px rgba(255, 26, 140, 0.18) inset, 0 24px 90px -24px rgba(255, 26, 140, 0.35), 0 60px 120px -40px rgba(0, 0, 0, 0.85);\n  overflow: hidden;\n  animation: lc-browse-overlay-in 320ms cubic-bezier(.2, .8, .2, 1);\n}\n@keyframes lc-browse-overlay-in {\n  from {\n    opacity: 0;\n    transform: translate(-50%, -45%) scale(0.985);\n  }\n  to {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n}\n.lc-browse-chrome {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px 14px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  background: linear-gradient(180deg, rgba(255, 26, 140, 0.06), transparent 70%), rgba(11, 11, 16, 0.92);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n}\n.lc-browse-chrome-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.lc-browse-icon-btn {\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-text-secondary);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: border-color .15s ease, color .15s ease;\n  flex-shrink: 0;\n}\n.lc-browse-icon-btn:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-icon-btn:disabled {\n  opacity: 0.35;\n  cursor: not-allowed;\n}\n.lc-browse-close {\n  margin-left: 4px;\n}\n.lc-browse-url {\n  flex: 1;\n  min-width: 0;\n  height: 30px;\n  padding: 0 12px;\n  border-radius: 999px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink);\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  outline: none;\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\n.lc-browse-url:focus {\n  border-color: var(--color-fuchsia);\n  box-shadow: 0 0 0 3px rgba(255, 26, 140, 0.16);\n}\n.lc-browse-url::placeholder {\n  color: var(--color-text-tertiary);\n}\n.lc-browse-chrome-quick {\n  display: inline-flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n}\n.lc-browse-quick-label {\n  text-transform: uppercase;\n  letter-spacing: 0.16em;\n  color: var(--color-text-tertiary);\n  padding-right: 4px;\n}\n.lc-browse-quick-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 3px 9px;\n  border-radius: 999px;\n  border: 1px solid var(--color-line-strong);\n  background: rgba(0, 0, 0, 0.25);\n  color: var(--color-text-secondary);\n  font-family: var(--font-mono);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: border-color .15s ease, color .15s ease;\n}\n.lc-browse-quick-chip:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-quick-hint {\n  margin-left: auto;\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n}\n.lc-browse-loading-dot {\n  color: var(--color-fuchsia-deep);\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n.lc-browse-loading-pulse {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 8px var(--color-fuchsia);\n  animation: lc-live-dot 1.4s ease-in-out infinite;\n}\n.lc-browse-loading-err {\n  color: #ff7e7e;\n}\n.lc-browse-loading-hint {\n  color: var(--color-text-tertiary);\n}\n.lc-browse-body {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  background: var(--color-paper);\n  position: relative;\n}\n.lc-browse-iframe {\n  flex: 1;\n  width: 100%;\n  height: 100%;\n  border: 0;\n  background: var(--color-paper);\n}\n.lc-browse-webview-slot {\n  flex: 1;\n  width: 100%;\n  height: 100%;\n  background: var(--color-paper);\n  pointer-events: none;\n}\n.lc-browse-blocked {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  padding: 40px 24px;\n  text-align: center;\n}\n.lc-browse-blocked-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-blocked-title {\n  font-family: var(--font-display);\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: var(--color-ink);\n}\n.lc-browse-blocked-body {\n  max-width: 520px;\n  font-size: 13.5px;\n  line-height: 1.5;\n  color: var(--color-text-secondary);\n}\n.lc-browse-blocked-actions {\n  display: inline-flex;\n  gap: 10px;\n  margin-top: 4px;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n.lc-browse-blocked-url {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  padding: 6px 12px;\n  border-radius: 999px;\n  border: 1px solid var(--color-line);\n  background: rgba(0, 0, 0, 0.30);\n  max-width: 72%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.lc-browse-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 14px;\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  background: rgba(11, 11, 16, 0.85);\n  flex-wrap: wrap;\n}\n.lc-browse-footer-meta {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: var(--color-text-tertiary);\n}\n.lc-browse-footer-actions {\n  display: inline-flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.lc2-engine-handoff-chip {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 14px;\n  margin: 0 0 10px;\n  border-radius: 12px;\n  border: 1px solid rgba(255, 26, 140, 0.40);\n  background: linear-gradient(180deg, rgba(255, 26, 140, 0.10), transparent 70%), var(--color-paper-elev);\n  box-shadow: 0 12px 28px -18px rgba(255, 26, 140, 0.40);\n}\n.lc2-engine-handoff-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc2-engine-handoff-body {\n  flex: 1;\n  font-size: 12.5px;\n  color: var(--color-ink);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.lc2-engine-handoff-body b {\n  color: var(--color-fuchsia-deep);\n}\n@media (max-width: 980px) {\n  .lc-browse-overlay {\n    width: 96vw;\n    height: 92vh;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-browse-scrim, .lc-browse-overlay {\n    animation: none !important;\n  }\n}\n.lc-browse-overlay[data-expanded=\"1\"] {\n  width: 100vw;\n  height: 100vh;\n  border-radius: 0;\n}\n.lc-browse-with-rail {\n  flex: 1;\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: 76px 1fr;\n  overflow: hidden;\n}\n.lc-browse-main {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n.lc-browse-rail {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  padding: 14px 8px;\n  background: color-mix(in srgb, #15151c 82%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper-warm) 82%, transparent);\n  }\n  backdrop-filter: blur(12px) saturate(1.4);\n  -webkit-backdrop-filter: blur(12px) saturate(1.4);\n  border-right: 1px solid rgba(255, 255, 255, 0.10);\n  overflow: hidden;\n}\n.lc-browse-rail-operator {\n  position: relative;\n  width: 60px;\n  height: 60px;\n  border-radius: 14px;\n  border: 1.5px dashed rgba(255, 255, 255, 0.18);\n  background: color-mix(in srgb, #1c1c25 60%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper-elev) 60%, transparent);\n  }\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  cursor: default;\n  transition: border-color 180ms ease;\n}\n.lc-browse-rail-operator:hover {\n  border-color: var(--color-fuchsia-deep);\n}\n.lc-browse-rail-operator img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.lc-browse-rail-operator-glyph {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--font-mono);\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--color-ink-soft);\n  letter-spacing: -0.02em;\n  pointer-events: none;\n}\n.lc-browse-rail-operator-caption {\n  font-family: var(--font-mono);\n  font-size: 8.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n  margin-top: -2px;\n}\n.lc-browse-rail-divider {\n  width: 40px;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.10);\n  margin: 2px 0;\n}\n.lc-browse-rail-icon {\n  position: relative;\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: color-mix(in srgb, #0b0b10 75%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper) 75%, transparent);\n  }\n  border: 1px solid rgba(255, 255, 255, 0.10);\n  color: var(--color-ink-soft);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  transition: transform 140ms cubic-bezier(0.32, 0.72, 0.15, 1), background 160ms ease, border-color 160ms ease, color 160ms ease, box-shadow 200ms ease;\n}\n.lc-browse-rail-icon:hover {\n  transform: translateX(2px);\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 60%, #0b0b10 40%);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 60%, var(--color-paper) 40%);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n  box-shadow: 0 0 22px -4px var(--color-fuchsia-soft);\n}\n.lc-browse-rail-icon:active {\n  transform: translateX(2px) scale(0.97);\n}\n.lc-browse-rail-icon:focus-visible {\n  outline: 2px solid var(--color-fuchsia);\n  outline-offset: 2px;\n}\n.lc-browse-rail-icon svg {\n  width: 26px;\n  height: 26px;\n  display: block;\n}\n.lc-browse-rail-icon[data-tone=\"red\"]:hover svg {\n  color: #FF3B3B;\n}\n.lc-browse-rail-icon[data-tone=\"amber\"]:hover svg {\n  color: #FFB05C;\n}\n.lc-browse-rail-user-glyph {\n  font-family: var(--font-mono);\n  font-size: 18px;\n  font-weight: 700;\n  color: currentColor;\n  letter-spacing: -0.01em;\n  line-height: 1;\n}\n.lc-browse-rail-icon-user-wrap {\n  position: relative;\n  width: 52px;\n  height: 52px;\n}\n.lc-browse-rail-icon-user {\n  color: var(--color-ink);\n}\n.lc-browse-rail-user-remove {\n  position: absolute;\n  top: -6px;\n  right: -6px;\n  width: 18px;\n  height: 18px;\n  border-radius: 999px;\n  background: var(--color-paper);\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  color: var(--color-ink-soft);\n  display: none;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  z-index: 5;\n  transition: background 140ms ease, border-color 140ms ease, color 140ms ease;\n}\n.lc-browse-rail-icon-user-wrap:hover .lc-browse-rail-user-remove, .lc-browse-rail-icon-user-wrap:focus-within .lc-browse-rail-user-remove {\n  display: grid;\n}\n.lc-browse-rail-user-remove:hover {\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 90%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 90%, transparent);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-rail-add {\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: transparent;\n  border: 1.5px dashed rgba(255, 255, 255, 0.18);\n  color: var(--color-ink-soft);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n.lc-browse-rail-add:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 40%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 40%, transparent);\n  }\n}\n.lc-browse-rail-add:focus-visible {\n  outline: 2px solid var(--color-fuchsia);\n  outline-offset: 2px;\n}\n.lc-browse-rail-count {\n  margin-top: auto;\n  padding-top: 6px;\n  border-top: 1px solid rgba(255, 255, 255, 0.10);\n  font-family: var(--font-mono);\n  font-size: 8.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n  width: 40px;\n  text-align: center;\n}\n.lc-browse-rail-count[data-full=\"1\"] {\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-expand-btn {\n  color: var(--color-ink-soft);\n}\n.lc-browse-expand-btn[aria-pressed=\"true\"] {\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 55%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 55%, transparent);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-browse-rail-icon, .lc-browse-rail-add, .lc-browse-rail-operator {\n    transition: none !important;\n  }\n}\n.lc-browse-add-form {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  background: radial-gradient( circle at 50% 30%, color-mix(in srgb, #ff1a8c 12%, transparent), transparent 60% ), color-mix(in srgb, #0b0b10 88%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: radial-gradient( circle at 50% 30%, color-mix(in srgb, var(--color-fuchsia) 12%, transparent), transparent 60% ), color-mix(in srgb, var(--color-paper) 88%, transparent);\n  }\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  z-index: 2;\n}\n.lc-browse-add-form-card {\n  width: min(420px, 100%);\n  padding: 22px 22px 18px;\n  background: var(--color-paper-elev);\n  border: 1px solid var(--color-line);\n  border-radius: 14px;\n  box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 1px color-mix(in srgb, #ff1a8c 22%, transparent), 0 0 40px -12px color-mix(in srgb, #ff1a8c 40%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 1px color-mix(in srgb, var(--color-fuchsia) 22%, transparent), 0 0 40px -12px color-mix(in srgb, var(--color-fuchsia) 40%, transparent);\n  }\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.lc-browse-add-form-header {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.lc-browse-add-form-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--color-ink);\n  letter-spacing: -0.01em;\n}\n.lc-browse-add-form-hint {\n  font-size: 12px;\n  color: var(--color-ink-soft);\n  line-height: 1.45;\n}\n.lc-browse-add-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.lc-browse-add-form-field > span {\n  font-family: var(--font-mono);\n  font-size: 9.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n}\n.lc-browse-add-form-field > input {\n  width: 100%;\n  padding: 9px 12px;\n  font-size: 13px;\n  font-family: inherit;\n  color: var(--color-ink);\n  background: color-mix(in srgb, #0b0b10 60%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper) 60%, transparent);\n  }\n  border: 1px solid