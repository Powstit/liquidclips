ann-head {\n  display: flex; align-items: center; justify-content: space-between;\n}\n.lc-ann-kind {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-ann-kind-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-ann-kind.is-mission_drop  { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-ann-kind.is-mission_drop  .lc-ann-kind-dot { background: #ff66b8; box-shadow: 0 0 4px rgba(255, 26, 140, .55); }\n.lc-ann-kind.is-payout        { color: #6ee7b7; background: rgba(110, 231, 183, .1); border-color: rgba(110, 231, 183, .45); }\n.lc-ann-kind.is-payout        .lc-ann-kind-dot { background: #6ee7b7; box-shadow: 0 0 4px rgba(110, 231, 183, .55); }\n.lc-ann-kind.is-rule_change   { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .4); }\n.lc-ann-kind.is-rule_change   .lc-ann-kind-dot { background: #fbbf24; box-shadow: 0 0 4px rgba(251, 191, 36, .55); }\n.lc-ann-kind.is-deadline      { color: #ff8b8b; background: rgba(255, 139, 139, .1); border-color: rgba(255, 139, 139, .45); }\n.lc-ann-kind.is-deadline      .lc-ann-kind-dot { background: #ff8b8b; box-shadow: 0 0 4px rgba(255, 139, 139, .55); }\n.lc-ann-kind.is-other         { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .35); }\n.lc-ann-kind.is-other         .lc-ann-kind-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n\n.lc-ann-time {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  color: #86837e;\n}\n\n.lc-ann-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 14px; letter-spacing: -.012em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-ann-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.45;\n  color: #b1aea8;\n  margin: 0;\n}\n\n.lc-ann-empty {\n  padding: 14px 16px !important;\n  display: flex; flex-direction: column; gap: 4px;\n  border-style: dashed !important;\n}\n.lc-ann-empty-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-ann-empty-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  color: #b1aea8;\n}\n"],["STYLE",{},".lc-rdd {\n  display: flex; flex-direction: column; gap: 16px;\n}\n\n.lc-rdd-head {\n  display: flex; gap: 8px; align-items: center;\n  flex-wrap: wrap;\n}\n.lc-rdd-tier,\n.lc-rdd-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-rdd-tier-dot,\n.lc-rdd-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-rdd-tier.is-free,\n.lc-rdd-tier.is-free_paid { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .35); }\n.lc-rdd-tier.is-free      .lc-rdd-tier-dot,\n.lc-rdd-tier.is-free_paid .lc-rdd-tier-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n.lc-rdd-tier.is-paid       { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-rdd-tier.is-paid       .lc-rdd-tier-dot { background: #ff66b8; box-shadow: 0 0 4px rgba(255, 26, 140, .55); }\n.lc-rdd-tier.is-paid_admin { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(2