ft: 0;\n}\n.lc2-engine-trim.r {\n  right: 0;\n}\n.lc2-engine-split-mark {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  background: var(--color-cyan-cool);\n  transform: translateX(-50%);\n  pointer-events: none;\n  z-index: 2;\n}\n.lc2-engine-capblock {\n  height: 22px;\n  border-radius: 4px;\n  background: rgba(0, 229, 255, 0.22);\n  border: 1px solid rgba(0, 229, 255, 0.35);\n  color: var(--color-ink-soft);\n  font-size: 10px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0 6px;\n  white-space: nowrap;\n}\n.lc2-engine-reactblock {\n  height: 22px;\n  border-radius: 4px;\n  background: rgba(255, 26, 140, 0.25);\n  border: 1px solid rgba(255, 26, 140, 0.4);\n  color: var(--color-fuchsia-deep);\n  font-size: 10px;\n  display: inline-flex;\n  align-items: center;\n  padding: 0 8px;\n}\n.lc2-engine-broll-block {\n  position: absolute;\n  top: 4px;\n  bottom: 4px;\n  border-radius: 4px;\n  background: rgba(255, 200, 100, 0.35);\n  border: 1px solid rgba(255, 200, 100, 0.5);\n  color: var(--color-ink-soft);\n  font-size: 10px;\n  display: inline-flex;\n  align-items: center;\n  padding: 0 8px;\n}\n.lc2-engine-playhead {\n  position: absolute;\n  top: 34px;\n  bottom: 34px;\n  width: 3px;\n  background: var(--color-fuchsia);\n  border-radius: 2px;\n  transform: translateX(-50%);\n  cursor: pointer;\n  z-index: 5;\n  box-shadow: 0 0 10px var(--color-fuchsia);\n}\n.lc2-engine-tl-playbar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 4px;\n}\n.lc2-engine-pp {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: var(--color-fuchsia);\n  cursor: pointer;\n  position: relative;\n  flex-shrink: 0;\n  transition: background 160ms ease;\n}\n.lc2-engine-pp:hover {\n  background: var(--color-fuchsia-bright);\n}\n.lc2-engine-pp::before {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-30%, -50%);\n  width: 0;\n  height: 0;\n  border-