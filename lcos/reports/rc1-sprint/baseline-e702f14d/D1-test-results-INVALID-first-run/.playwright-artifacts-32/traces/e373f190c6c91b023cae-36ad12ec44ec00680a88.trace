home--agency {\n  --mode-accent: var(--color-fuchsia);\n  --mode-accent-soft: rgba(255, 198, 73, 0.16);\n  --mode-accent-glow: rgba(255, 198, 73, 0.30);\n  --mode-edge: rgba(255, 198, 73, 0.50);\n  --mode-bg-tint: radial-gradient(900px 380px at 12% -10%, rgba(255, 26, 140, 0.10), transparent 70%),\n                  radial-gradient(700px 320px at 92% -10%, rgba(255, 198, 73, 0.10), transparent 70%);\n  --mode-step-1: var(--color-fuchsia);\n  --mode-step-2: #ffc649;\n  --mode-step-3: #ffffff;\n  --mode-step-4: #b07bff;\n}\n.lc-home::before {\n  content: \"\";\n  position: absolute;\n  inset: -40px -40px auto -40px;\n  height: 280px;\n  background: var(--mode-bg-tint);\n  pointer-events: none;\n  z-index: 0;\n  transition: opacity .35s ease, background .35s ease;\n}\n.lc-home > * {\n  position: relative;\n  z-index: 1;\n}\n.lc-home-mode-skin {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin: 12px 0 6px;\n  padding: 14px 18px;\n  border: 1px solid var(--mode-edge);\n  border-radius: 14px;\n  background: linear-gradient(180deg, var(--mode-accent-soft), transparent 70%), var(--color-paper);\n  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.02) inset, 0 18px 40px -28px var(--mode-accent-glow);\n  flex-wrap: wrap;\n}\n.lc-home-mode-skin-headline {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 240px;\n}\n.lc-home-mode-skin-title {\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--mode-accent);\n  text-shadow: 0 0 12px var(--mode-accent-glow);\n}\n.lc-home-mode-skin-sub {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-ink);\n  letter-spacing: 0.01em;\n}\n.lc-home-mode-path {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  flex-wrap: wrap;\n}\n.lc-home-mode-path-step {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n}\n.lc-home-mode-path-label {\n  display: inline-flex;\n  align-items: center;\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  padding: 6px 12px;\n  border-radius: 999px;\n  border: 1px solid var(--mode-edge);\n  background: rgba(0, 0, 0, 0.35);\n  color: var(--color-ink);\n}\n.lc-home-mode-path-step:nth-child(1) .lc-home-mode-path-label {\n  color: var(--mode-step-1);\n  border-color: var(--mode-step-1);\n  box-shadow: 0 0 14px -6px var(--mode-step-1);\n}\n.lc-home-mode-path-step:nth-child(2) .lc-home-mode-path-label {\n  color: var(--mode-step-2);\n  border-color: var(--mode-step-2);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--mode-step-2) 70%, transparent);\n  }\n}\n.lc-home-mode-path-step:nth-child(3) .lc-home-mode-path-label {\n  color: var(--mode-step-3);\n  border-color: var(--mode-step-3);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--mode-step-3) 70%, transparent);\n  }\n}\n.lc-home-mode-path-step:nth-child(4) .lc-home-mode-path-label {\n  color: var(--mode-step-4);\n  border-color: var(--mode-step-4);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--mode-step-4) 70%, transparent);\n  }\n}\n.lc-home-mode-path-arrow {\n  font-size: 13px;\n  color: var(--mode-edge);\n  @supports (color: color-mix(in lab, red, red)) {\n    color: color-mix(in srgb, var(--mode-edge) 70%, white);\n  }\n  opacity: 0.85;\n}\n.lc-home .lc-launcher-card:hover {\n  border-color: var(--mode-edge) !important;\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--mode-edge) 80%, var(--color-fuchsia)) !important;\n  }\n}\n.lc-home--agency .lc-launcher-card:hover .lc-launcher-corner {\n  border-color: #ffc649;\n}\n.lc-home .lc-home-mode-strip-wrap {\n  border-radius: 16px;\n  padding: 2px;\n  background: linear-gradient(90deg, transparent, var(--mode-accent-glow), transparent);\n}\n.lc-home-partner-strip {\n  display: grid;\n  grid-template-columns: minmax(260px, 1.4fr) minmax(220px, 1fr) auto;\n  align-items: center;\n  gap: 14px 22px;\n  padding: 14px 18px;\n  margin: 14px 0;\n  border: 1px solid rgba(255, 198, 73, 0.40);\n  border-radius: 16px;\n  background: linear-gradient(180deg, rgba(255, 198, 73, 0.08), transparent 70%), var(--color-paper);\n  box-shadow: 0 18px 40px -28px rgba(255, 198, 73, 0.30);\n}\n@media (max-width: 980px) {\n  .lc-home-partner-strip {\n    grid-template-columns: 1fr;\n  }\n}\n.lc-home-partner-head {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.lc-home-partner-eyebrow {\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  color: #ffc649;\n  text-shadow: 0 0 12px rgba(255, 198, 73, 0.35);\n}\n.lc-home-partner-headline {\n  font-size: 13px;\n  line-height: 1.45;\n  font-weight: 500;\n  color: var(--color-ink);\n}\n.lc-home-partner-meta {\n  display: inline-flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.lc-home-partner-pill {\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 10px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n  padding: 4px 8px;\n  border: 1px dashed rgba(255, 255, 255, 0.18);\n  border-radius: 999px;\n}\n.lc-home-partner-tier {\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.10em;\n  padding: 5px 10px;\n  border-radius: 999px;\n  color: var(--color-ink);\n  border: 1px solid rgba(255, 198, 73, 0.45);\n  background: rgba(255, 198, 73, 0.08);\n}\n.lc-home-partner-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  justify-self: end;\n}\n@media (max-width: 980px) {\n  .lc-home-partner-actions {\n    justify-self: start;\n  }\n}\n.lc-home-partner-note {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n.lc-home-banner-wrap {\n  display: block;\n  width: 100%;\n  margin: 18px 0 6px;\n}\n.lc-home-banner-wrap [data-home-banner=\"root\"] {\n  width: 100%;\n}\n.lc-home-banner-wrap [data-home-banner=\"carousel\"] {\n  width: 100%;\n}\n.lc-home-banner-wrap [data-home-banner=\"slide\"] {\n  width: 100%;\n  min-width: 100%;\n}\n.lc-home-banner-wrap [data-home-banner=\"slide\"] + [data-home-banner=\"slide\"] {\n  margin-left: 12px;\n}\n.lc-home-banner-wrap [data-home-banner=\"carousel\"] > div > div::-webkit-scrollbar {\n  display: none;\n}\n.lc-gem-toggle {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n  padding: 18px;\n  border-radius: 22px;\n  border: 1px solid var(--color-line);\n  background: radial-gradient(900px 200px at 50% 0%, rgba(255, 26, 140, 0.10), transparent 70%), var(--color-paper);\n  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.02) inset, 0 24px 60px -36px rgba(255, 26, 140, 0.40);\n  overflow: hidden;\n}\n.lc-gem-toggle-rail {\n  position: absolute;\n  left: 18%;\n  right: 18%;\n  top: 50%;\n  height: 1px;\n  transform: translateY(-50%);\n  background: linear-gradient(90deg, transparent, rgba(255, 26, 140, 0.45), transparent);\n  pointer-events: none;\n}\n.lc-gem-node {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 14px 12px;\n  background: transparent;\n  border: 0;\n  cursor: pointer;\n  color: var(--color-text-tertiary);\n  border-radius: 16px;\n  transition: color .25s ease, transform .25s ease;\n}\n.lc-gem-node:hover {\n  transform: translateY(-1px);\n}\n.lc-gem-halo {\n  position: absolute;\n  top: 8px;\n  left: 50%;\n  width: 96px;\n  height: 96px;\n  margin-left: -48px;\n  border-radius: 999px;\n  background: radial-gradient(circle, rgba(255, 26, 140, 0.55), rgba(255, 26, 140, 0.0) 65%);\n  filter: blur(4px);\n  opacity: 0;\n  transition: opacity .25s ease;\n  pointer-events: none;\n}\n.lc-gem-face {\n  position: relative;\n  width: 72px;\n  height: 72px;\n  border-radius: 999px;\n  display: grid;\n  place-items: center;\n  background: radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.08), transparent 55%), linear-gradient(180deg, #1a1320, #0e0a14);\n  border: 1.5px solid rgba(255, 255, 255, 0.10);\n  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.65) inset, 0 10px 24px -10px rgba(0, 0, 0, 0.80);\n  color: var(--color-text-secondary);\n  transition: border-color .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;\n}\n.lc-gem-label {\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n  transition: color .25s ease, text-shadow .25s ease;\n}\n.lc-gem-caption {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n.lc-gem-node[data-active=\"true\"] {\n  color: var(--color-ink);\n}\n.lc-gem-node[data-active=\"true\"] .lc-gem-halo {\n  opacity: 1;\n}\n.lc-gem-node[data-active=\"true\"] .lc-gem-face {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia);\n  box-shadow: 0 0 0 1px rgba(255, 26, 140, 0.30) inset, 0 0 22px rgba(255, 26, 140, 0.55), 0 18px 40px -16px rgba(255, 26, 140, 0.55);\n  transform: scale(1.04);\n}\n.lc-gem-node[data-active=\"true\"] .lc-gem-label {\n  color: var(--color-fuchsia);\n  text-shadow: 0 0 12px rgba(255, 26, 140, 0.45);\n}\n@media (max-width: 640px) {\n  .lc-gem-toggle {\n    grid-template-columns: 1fr;\n    gap: 12px;\n  }\n  .lc-gem-toggle-rail {\n    display: none;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-gem-node, .lc-gem-node:hover, .lc-gem-face, .lc-gem-halo, .lc-gem-label {\n    transition: none !important;\n    transform: none !important;\n  }\n}\n.lc-launcher-divider {\n  height: 1px;\n  background: linear-gradient(90deg, transparent, var(--color-line), transparent);\n  opacity: 0.6;\n  margin: 4px 0 2px;\n}\n.lc-launcher-mode-extras[data-size=\"sm\"] {\n  gap: 8px;\n}\n.lc-launcher-mode-extras[data-size=\"sm\"] .lc-action-pill, .lc-launcher-mode-extras[data-size=\"sm\"] button {\n  padding: 6px 10px !important;\n  font-size: 11px !important;\n}\n.lc-launcher-mode-extras[data-size=\"sm\"] .lc-action-pill-icon {\n  transform: scale(0.9);\n}\n.lc-home-partner-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(255, 255, 255, 0.10);\n  background: rgba(0, 0, 0, 0.40);\n  font-family: var(--font-mono, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 10px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n  cursor: default;\n}\n.lc-home-partner-chip svg {\n  color: rgba(255, 198, 73, 0.85);\n}\n.lc2-engine-source-invader {\n  position: absolute;\n  inset: 0;\n  margin: auto;\n  width: 28px;\n  height: 18px;\n  fill: rgba(255, 26, 140, 0.75);\n  filter: drop-shadow(0 0 6px rgba(255, 26, 140, 0.45));\n  z-index: 1;\n}\n.lc-workwindow {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.lc-workwindow-lead {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--color-line);\n}\n.lc-workwindow-lead-icon {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  border: 1px solid rgba(255, 26, 140, 0.30);\n  background: linear-gradient(180deg, rgba(255, 26, 140, 0.12), transparent);\n  color: var(--color-fuchsia);\n  flex-shrink: 0;\n}\n.lc-workwindow-lead-text {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n.lc-workwindow-lead-title {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-display);\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-ink);\n}\n.lc-workwindow-lead-sub {\n  font-size: 12.5px;\n  color: var(--color-text-secondary);\n  line-height: 1.4;\n}\n.lc-workwindow-body {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.lc-workwindow-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding-top: 12px;\n  border-top: 1px solid var(--color-line);\n  flex-wrap: wrap;\n}\n.lc-workwindow-footer-left {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n.lc-workwindow-footer-right {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  margin-left: auto;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n.lc-workwindow .lc-import-dropzone {\n  padding: 18px;\n  border: 1.5px dashed rgba(94, 234, 255, 0.35);\n  border-radius: 14px;\n  background: rgba(94, 234, 255, 0.04);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  color: var(--color-text-secondary);\n}\n.lc-workwindow .lc-import-drop-formats {\n  display: inline-flex;\n  gap: 6px;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n.lc-workwindow .lc-import-url-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.lc-campaign-context-strip {\n  position: sticky;\n  top: 0;\n  z-index: 4;\n  padding: 10px 12px 12px;\n  background: linear-gradient( 180deg, rgba(28, 28, 37, 0.96) 0%, rgba(11, 11, 16, 0.92) 100% );\n  border-bottom: 1px solid var(--color-line-strong);\n  box-shadow: inset 0 1px 0 rgba(255, 26, 140, 0.32);\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.lc-ccs-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-ccs-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.lc-ccs-avatar {\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  background: linear-gradient(135deg, rgba(255, 26, 140, 0.36), rgba(140, 60, 255, 0.22));\n  border: 1px solid rgba(255, 26, 140, 0.5);\n  color: #fff;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n}\n.lc-ccs-body {\n  min-width: 0;\n  flex: 1;\n}\n.lc-ccs-name {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: var(--color-ink);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.lc-ccs-stamp-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 2px;\n}\n.lc-ccs-stamp-mark {\n  width: 14px;\n  height: 14px;\n  border-radius: 3px;\n  background: linear-gradient(135deg, rgba(255, 26, 140, 0.7), rgba(140, 60, 255, 0.35));\n  box-shadow: 0 0 6px rgba(255, 26, 140, 0.45);\n}\n.lc-ccs-stamp {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  color: var(--color-text-secondary);\n  letter-spacing: 0.04em;\n}\n.lc-ccs-foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.lc-ccs-locked {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 8px;\n  border-radius: 999px;\n  background: rgba(255, 26, 140, 0.10);\n  border: 1px solid rgba(255, 26, 140, 0.42);\n  font-family: var(--font-mono);\n  font-size: 9.5px;\n  font-weight: 700;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia);\n}\n.lc-ccs-lock-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 999px;\n  background: var(--color-fuchsia);\n  box-shadow: 0 0 6px rgba(255, 26, 140, 0.85);\n}\n.lc-ccs-rules {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  color: var(--color-cyan, #5EEAFF);\n  text-decoration: none;\n}\n.lc-ccs-rules[aria-disabled=\"true\"] {\n  color: var(--color-text-tertiary);\n  opacity: 0.6;\n  cursor: default;\n}\n.lc-dropzone {\n  position: absolute;\n  inset: 0;\n  z-index: 30;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 160ms ease;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n}\n.lc-dropzone.on {\n  opacity: 1;\n}\n.lc-dropzone-frame {\n  position: relative;\n  width: min(560px, 90%);\n  padding: 36px 32px 32px;\n  border-radius: 18px;\n  border: 2.5px dashed rgba(94, 234, 255, 0.68);\n  background: radial-gradient(ellipse 70% 60% at 50% 38%, rgba(94, 234, 255, 0.18), transparent 70%), rgba(11, 11, 16, 0.78);\n  box-shadow: 0 0 0 1px rgba(94, 234, 255, 0.22), 0 0 60px 8px rgba(94, 234, 255, 0.18) inset;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n  backdrop-filter: blur(2px);\n}\n.lc-dropzone-invader {\n  width: 96px;\n  height: auto;\n  image-rendering: pixelated;\n  filter: drop-shadow(0 0 12px rgba(94, 234, 255, 0.55));\n  animation: lc-dropzone-hover 1.6s ease-in-out infinite;\n}\n@keyframes lc-dropzone-hover {\n  0%, 100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-6px);\n  }\n}\n.lc-dropzone-title {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 800;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  color: var(--color-cyan, #5EEAFF);\n  text-shadow: 0 0 12px rgba(94, 234, 255, 0.45);\n}\n.lc-dropzone-formats {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--color-text-secondary);\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-dropzone-invader {\n    animation: none;\n  }\n}\n.lc-publish-scrim {\n  z-index: 95;\n}\n.lc-publish-modal {\n  width: min(720px, 96vw);\n  max-height: 92vh;\n  padding: 22px 24px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.lc-publish-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n}\n.lc-publish-title-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.lc-publish-title {\n  margin: 0;\n}\n.lc-publish-sim-chip {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.10em;\n  text-transform: lowercase;\n  color: var(--color-fuchsia, #ff1a8c);\n  padding: 2px 8px;\n  border: 1px solid rgba(255, 26, 140, 0.4);\n  border-radius: 999px;\n  background: rgba(255, 26, 140, 0.08);\n}\n.lc-publish-close {\n  background: transparent;\n  border: 1px solid var(--color-line-strong);\n  border-radius: 999px;\n  width: 28px;\n  height: 28px;\n  font-size: 18px;\n  line-height: 1;\n  color: var(--color-ink-soft);\n  cursor: pointer;\n}\n.lc-publish-close:hover {\n  color: var(--color-ink);\n}\n.lc-publish-eyebrow-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.lc-publish-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11.5px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  padding: 5px 10px;\n  border-radius: 999px;\n  border: 1px solid var(--color-line-strong);\n  background: var(--color-paper-elev);\n  color: var(--color-ink-soft);\n}\n.lc-publish-chip-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--color-fuchsia, #ff1a8c);\n  box-shadow: 0 0 6px rgba(255, 26, 140, 0.5);\n}\n.lc-publish-campaign .lc-publish-chip-dot {\n  background: var(--color-cyan, #5EEAFF);\n  box-shadow: 0 0 6px rgba(94, 234, 255, 0.5);\n}\n.lc-publish-watermark {\n  color: var(--color-fuchsia, #ff1a8c);\n  border-color: rgba(255, 26, 140, 0.35);\n}\n.lc-publish-section {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.lc-publish-section-label-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.lc-publish-section-label {\n  font-family: var(--font-mono);\n  font-size: 10.5px;\n  letter-spacing: 0.12em;\n