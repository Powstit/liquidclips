c-browse-rail-operator {\n  position: relative;\n  width: 60px;\n  height: 60px;\n  border-radius: 14px;\n  border: 1.5px dashed rgba(255, 255, 255, 0.18);\n  background: color-mix(in srgb, #1c1c25 60%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper-elev) 60%, transparent);\n  }\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  cursor: default;\n  transition: border-color 180ms ease;\n}\n.lc-browse-rail-operator:hover {\n  border-color: var(--color-fuchsia-deep);\n}\n.lc-browse-rail-operator img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.lc-browse-rail-operator-glyph {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--font-mono);\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--color-ink-soft);\n  letter-spacing: -0.02em;\n  pointer-events: none;\n}\n.lc-browse-rail-operator-caption {\n  font-family: var(--font-mono);\n  font-size: 8.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n  margin-top: -2px;\n}\n.lc-browse-rail-divider {\n  width: 40px;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.10);\n  margin: 2px 0;\n}\n.lc-browse-rail-icon {\n  position: relative;\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: color-mix(in srgb, #0b0b10 75%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper) 75%, transparent);\n  }\n  border: 1px solid rgba(255, 255, 255, 0.10);\n  color: var(--color-ink-soft);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  transition: transform 140ms cubic-bezier(0.32, 0.72, 0.15, 1), background 160ms ease, border-color 160ms ease, color 160ms ease, box-shadow 200ms ease;\n}\n.lc-browse-rail-icon:hover {\n  transform: translateX(2px);\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 60%, #0b0b10 40%);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 60%, var(--color-paper) 40%);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n  box-shadow: 0 0 22px -4px var(--color-fuchsia-soft);\n}\n.lc-browse-rail-icon:active {\n  transform: translateX(2px) scale(0.97);\n}\n.lc-browse-rail-icon:focus-visible {\n  outline: 2px solid var(--color-fuchsia);\n  outline-offset: 2px;\n}\n.lc-browse-rail-icon svg {\n  width: 26px;\n  height: 26px;\n  display: block;\n}\n.lc-browse-rail-icon[data-tone=\"red\"]:hover svg {\n  color: #FF3B3B;\n}\n.lc-browse-rail-icon[data-tone=\"amber\"]:hover svg {\n  color: #FFB05C;\n}\n.lc-browse-rail-user-glyph {\n  font-family: var(--font-mono);\n  font-size: 18px;\n  font-weight: 700;\n  color: currentColor;\n  letter-spacing: -0.01em;\n  line-height: 1;\n}\n.lc-browse-rail-icon-user-wrap {\n  position: relative;\n  width: 52px;\n  height: 52px;\n}\n.lc-browse-rail-icon-user {\n  color: var(--color-ink);\n}\n.lc-browse-rail-user-remove {\n  position: absolute;\n  top: -6px;\n  right: -6px;\n  width: 18px;\n  height: 18px;\n  border-radius: 999px;\n  background: var(--color-paper);\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  color: var(--color-ink-soft);\n  display: none;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  z-index: 5;\n  transition: background 140ms ease, border-color 140ms ease, color 140ms ease;\n}\n.lc-browse-rail-icon-user-wrap:hover .lc-browse-rail-user-remove, .lc-browse-rail-icon-user-wrap:focus-within .lc-browse-rail-user-remove {\n  display: grid;\n}\n.lc-browse-rail-user-remove:hover {\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 90%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 90%, transparent);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-rail-add {\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: transparent;\n  border: 1.5px dashed rgba(255, 255, 255, 0.18);\n  color: var(--color-ink-soft);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n.lc-browse-rail-add:hover {\n  border-color: var(--color-fuchsia);\n  color: var(--color-fuchsia-deep);\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 40%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 40%, transparent);\n  }\n}\n.lc-browse-rail-add:focus-visible {\n  outline: 2px solid var(--color-fuchsia);\n  outline-offset: 2px;\n}\n.lc-browse-rail-count {\n  margin-top: auto;\n  padding-top: 6px;\n  border-top: 1px solid rgba(255, 255, 255, 0.10);\n  font-family: var(--font-mono);\n  font-size: 8.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n  width: 40px;\n  text-align: center;\n}\n.lc-browse-rail-count[data-full=\"1\"] {\n  color: var(--color-fuchsia-deep);\n}\n.lc-browse-expand-btn {\n  color: var(--color-ink-soft);\n}\n.lc-browse-expand-btn[aria-pressed=\"true\"] {\n  background: color-mix(in srgb, rgba(255, 26, 140, 0.16) 55%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-fuchsia-soft) 55%, transparent);\n  }\n  border-color: var(--color-fuchsia);\n  color: var(--color-ink);\n}\n@media (prefers-reduced-motion: reduce) {\n  .lc-browse-rail-icon, .lc-browse-rail-add, .lc-browse-rail-operator {\n    transition: none !important;\n  }\n}\n.lc-browse-add-form {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  background: radial-gradient( circle at 50% 30%, color-mix(in srgb, #ff1a8c 12%, transparent), transparent 60% ), color-mix(in srgb, #0b0b10 88%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: radial-gradient( circle at 50% 30%, color-mix(in srgb, var(--color-fuchsia) 12%, transparent), transparent 60% ), color-mix(in srgb, var(--color-paper) 88%, transparent);\n  }\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  z-index: 2;\n}\n.lc-browse-add-form-card {\n  width: min(420px, 100%);\n  padding: 22px 22px 18px;\n  background: var(--color-paper-elev);\n  border: 1px solid var(--color-line);\n  border-radius: 14px;\n  box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 1px color-mix(in srgb, #ff1a8c 22%, transparent), 0 0 40px -12px color-mix(in srgb, #ff1a8c 40%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 1px color-mix(in srgb, var(--color-fuchsia) 22%, transparent), 0 0 40px -12px color-mix(in srgb, var(--color-fuchsia) 40%, transparent);\n  }\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.lc-browse-add-form-header {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.lc-browse-add-form-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--color-ink);\n  letter-spacing: -0.01em;\n}\n.lc-browse-add-form-hint {\n  font-size: 12px;\n  color: var(--color-ink-soft);\n  line-height: 1.45;\n}\n.lc-browse-add-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.lc-browse-add-form-field > span {\n  font-family: var(--font-mono);\n  font-size: 9.5px;\n  letter-spacing: 0.16em;\n  color: var(--color-ink-soft);\n  text-transform: uppercase;\n}\n.lc-browse-add-form-field > input {\n  width: 100%;\n  padding: 9px 12px;\n  font-size: 13px;\n  font-family: inherit;\n  color: var(--color-ink);\n  background: color-mix(in srgb, #0b0b10 60%, transparent);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color-mix(in srgb, var(--color-paper) 60%, transparent);\n  }\