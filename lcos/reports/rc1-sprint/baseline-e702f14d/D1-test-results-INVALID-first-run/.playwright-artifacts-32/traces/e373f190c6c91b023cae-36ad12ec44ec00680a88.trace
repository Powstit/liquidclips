{"type":"frame-snapshot","snapshot":{"callId":"call@40","snapshotName":"after@call@40","pageId":"page@6759484d39fcf707af34c9dc4cb31a14","frameId":"frame@19b535383d061c23af0efc0ae98ad694","frameUrl":"http://localhost:1420/#/campaigns","doctype":"html","html":["HTML",{"lang":"en","data-nav-collapsed":"0"},["HEAD",{},[[4,0]],[[4,1]],[[4,2]],[[4,3]],[[4,4]],[[4,5]],[[4,6]],[[4,7]],[[4,9]],[[4,10]],[[4,11]],[[4,13]],[[4,15]],[[4,17]],[[4,19]],[[4,21]],[[4,23]],[[4,25]],[[4,27]],[[4,29]],[[4,31]],[[4,33]],[[4,35]],[[4,37]],[[4,39]],[[4,41]],[[4,43]],[[4,45]],[[4,47]],[[4,49]],[[4,51]],[[4,53]],[[4,55]],[[4,57]],[[4,59]],[[4,61]],[[4,63]],[[4,65]],[[4,67]],[[4,69]],[[4,71]],[[4,73]],[[4,75]],[[4,77]],[[4,79]],[[4,81]],[[4,83]],[[4,85]],[[4,87]],[[4,89]],[[4,91]],[[4,93]],[[4,95]],[[2,1]],[[2,3]],[[2,5]],[[2,7]],[[2,9]],[[2,11]],[[2,13]],[[2,15]],[[2,17]],[[2,19]],[[2,21]],[[2,23]],[[2,25]],[[2,27]],[[2,29]],[[2,31]],[[2,33]],["STYLE",{},"/* CampaignLifecyclePill · UI-3 · small inline pill + Manage popover */\n\n.lc-clp-wrap { position: relative; display: inline-flex; }\n\n.lc-clp {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 4px 9px;\n  border-radius: 9999px;\n  border: 1px solid currentColor;\n  background: rgba(8, 6, 12, .45);\n}\n.lc-clp-dim     { color: #c8c4be; border-color: rgba(255, 255, 255, .25); }\n.lc-clp-fuchsia { color: #ff66b8; border-color: rgba(255, 26, 140, .55); background: rgba(40, 8, 30, .55); }\n.lc-clp-amber   { color: #fbbf24; border-color: rgba(245, 158, 11, .55); background: rgba(36, 22, 6, .45); }\n.lc-clp-muted   { color: var(--dim, #86837e); border-color: rgba(255, 255, 255, .18); background: rgba(8, 6, 12, .35); opacity: .85; }\n\n.lc-clp-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: currentColor;\n  box-shadow: 0 0 6px currentColor;\n  flex: 0 0 auto;\n}\n.lc-clp-dot-dim     { color: #c8c4be; }\n.lc-clp-dot-fuchsia { color: #ff66b8; }\n.lc-clp-dot-amber   { color: #fbbf24; }\n.lc-clp-dot-muted   { color: var(--dim, #86837e); }\n\n.lc-clp-mng {\n  cursor: pointer;\n  transition: filter 160ms ease;\n}\n.lc-clp-mng:hover { filter: brightness(1.15); }\n\n.lc-clp-caret {\n  font-size: 9px;\n  margin-left: 1px;\n  opacity: .8;\n}\n\n/* Popover */\n.lc-clp-pop {\n  position: absolute;\n  top: calc(100% + 6px);\n  left: 0;\n  z-index: 10;\n  min-width: 180px;\n  padding: 8px 6px 8px 6px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  background: rgba(18, 12, 24, .98);\n  border: 1px solid rgba(255, 26, 140, .35);\n  border-radius: 10px;\n  box-shadow: 0 16px 36px rgba(0, 0, 0, .55), 0 0 18px rgba(255, 26, 140, .18);\n}\n.lc-clp-pop-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  color: var(--dim, #86837e);\n  padding: 4px 10px 6px;\n  border-bottom: 1px dashed rgba(255, 255, 255, .08);\n  margin-bottom: 4px;\n}\n.lc-clp-pop-row {\n  display: grid;\n  grid-template-columns: 12px minmax(0, 1fr) 14px;\n  gap: 8px;\n  align-items: center;\n  padding: 7px 10px;\n  border-radius: 8px;\n  background: transparent;\n  border: 0;\n  color: #f4f1ea;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px;\n  cursor: pointer;\n  text-align: left;\n  transition: background 160ms ease;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.lc-clp-pop-row:hover { background: rgba(255, 255, 255, .05); }\n.lc-clp-pop-row.on { color: #ff66b8; background: rgba(255, 26, 140, .08); }\n.lc-clp-pop-check {\n  font-size: 12px;\n  color: #ff66b8;\n  text-align: right;\n}\n"],["STYLE",{},".lc-camp-card {\n  padding: 14px 16px !important;\n  display: flex;\n}\n.lc-camp-card.is-sponsored { border-color: rgba(255, 165, 0, .35) !important; background: rgba(255, 165, 0, .04) !important; }\n.lc-camp-card.is-featured  { border-color: rgba(255, 102, 184, .5) !important; background: linear-gradient(135deg, rgba(255, 26, 140, .08), rgba(7, 199, 224, .04)) !important; }\n\n.lc-camp-card-body {\n  all: unset;\n  display: flex; flex-direction: column; gap: 10px;\n  cursor: pointer;\n  width: 100%;\n}\n.lc-camp-card-body:focus-visible {\n  outline: 2px solid rgba(255, 26, 140, .55);\n  outline-offset: 4px;\n  border-radius: 8px;\n}\n\n.lc-camp-card-head {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 8px;\n}\n\n.lc-camp-type {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-camp-type-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-camp-type.is-clip          { color: #7fd9e8; background: rgba(7, 199, 224, .1); border-color: rgba(7, 199, 224, .35); }\n.lc-camp-type.is-clip          .lc-camp-type-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n.lc-camp-type.is-coordination  { color: #fbbf24; background: rgba(251, 191, 36, .1); border-color: rgba(251, 191, 36, .4); }\n.lc-camp-type.is-coordination  .lc-camp-type-dot { background: #fbbf24; box-shadow: 0 0 4px rgba(251, 191, 36, .55); }\n.lc-camp-type.is-affiliate     { color: #6ee7b7; background: rgba(110, 231, 183, .1); border-color: rgba(110, 231, 183, .45); }\n.lc-camp-type.is-affiliate     .lc-camp-type-dot { background: #6ee7b7; box-shadow: 0 0 4px rgba(110, 231, 183, .55); }\n.lc-camp-type.is-submission    { color: #ffa3d0; background: rgba(255, 26, 140, .1); border-color: rgba(255, 102, 184, .45); }\n.lc-camp-type.is-submission    .lc-camp-type-dot { background: #ff66b8; box-shadow: 0 0 4px rgba(255, 26, 140, .55); }\n\n.lc-camp-placement {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .2em;\n  text-transform: uppercase;\n  padding: 2px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-camp-placement.is-featured  { color: #ffa3d0; background: rgba(255, 26, 140, .12); border-color: rgba(255, 102, 184, .55); }\n.lc-camp-placement.is-sponsored { color: #ffd591; background: rgba(255, 165, 0, .12); border-color: rgba(255, 165, 0, .55); }\n.lc-camp-placement.is-category_spotlight { color: #7fd9e8; background: rgba(7, 199, 224, .12); border-color: rgba(7, 199, 224, .55); }\n\n.lc-camp-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 17px; letter-spacing: -.014em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-camp-sub {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.45;\n  color: #b1aea8;\n  margin: 0;\n}\n\n.lc-camp-meta-row {\n  display: flex; align-items: baseline; justify-content: space-between;\n  gap: 10px;\n}\n.lc-camp-payout {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 14px; font-weight: 700; letter-spacing: -.01em;\n  color: #6ee7b7;\n}\n.lc-camp-pool {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px; letter-spacing: .08em;\n  color: #b1aea8;\n  text-transform: uppercase;\n}\n\n.lc-camp-funded {\n  position: relative;\n  height: 6px;\n  border-radius: 4px;\n  background: rgba(255, 255, 255, .06);\n  overflow: hidden;\n}\n.lc-camp-funded-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #ff1a8c 0%, #ff66b8 100%);\n  box-shadow: 0 0 8px rgba(255, 26, 140, .55);\n  transition: width .28s cubic-bezier(.2, .7, .2, 1);\n}\n.lc-camp-funded-fill.is-full {\n  background: linear-gradient(90deg, #6ee7b7 0%, #7fd9e8 100%);\n  box-shadow: 0 0 8px rgba(110, 231, 183, .55);\n}\n.lc-camp-funded-label {\n  position: absolute;\n  inset: 0;\n  display: none;\n}\n\n.lc-camp-foot {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 8px;\n  padding-top: 2px;\n  border-top: 1px dashed rgba(255, 255, 255, .06);\n}\n.lc-camp-foot-left  { display: inline-flex; align-items: center; gap: 8px; }\n.lc-camp-foot-right { display: inline-flex; align-items: center; gap: 8px; }\n\n.lc-camp-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #c8c4be;\n}\n.lc-camp-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-camp-status.is-live              { color: #6ee7b7; }\n.lc-camp-status.is-live              .lc-camp-status-dot { background: #6ee7b7; box-shadow: 0 0 4px rgba(110, 231, 183, .55); }\n.lc-camp-status.is-coming_soon       { color: #fbbf24; }\n.lc-camp-status.is-coming_soon       .lc-camp-status-dot { background: #fbbf24; box-shadow: 0 0 4px rgba(251, 191, 36, .55); }\n.lc-camp-status.is-partially_funded  { color: #fbbf24; }\n.lc-camp-status.is-funded            { color: #7fd9e8; }\n.lc-camp-status.is-funded            .lc-camp-status-dot { background: #7fd9e8; box-shadow: 0 0 4px rgba(7, 199, 224, .55); }\n\n.lc-camp-brand {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .08em;\n  color: #86837e;\n}\n\n.lc-camp-capacity,\n.lc-camp-deadline {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .08em;\n  color: #d8d4cd;\n  padding: 2px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .1);\n  white-space: nowrap;\n}\n"],["STYLE",{},".lc-camp-banner {\n  padding: 18px 20px !important;\n  background: linear-gradient(120deg, rgba(255, 26, 140, .1) 0%, rgba(7, 199, 224, .06) 60%, rgba(20, 20, 28, .55) 100%) !important;\n  border-color: rgba(255, 102, 184, .45) !important;\n}\n.lc-camp-banner.is-sponsored {\n  background: linear-gradient(120deg, rgba(255, 165, 0, .1) 0%, rgba(255, 26, 140, .06) 100%) !important;\n  border-color: rgba(255, 165, 0, .4) !important;\n}\n\n.lc-camp-banner-body {\n  all: unset;\n  display: grid;\n  grid-template-columns: 120px 1fr auto;\n  gap: 16px;\n  align-items: center;\n  cursor: pointer;\n  width: 100%;\n}\n.lc-camp-banner-body:focus-visible {\n  outline: 2px solid rgba(255, 26, 140, .55);\n  outline-offset: 4px;\n  border-radius: 8px;\n}\n\n.lc-camp-banner-art-wrap {\n  width: 120px; height: 120px;\n  border-radius: 14px;\n  overflow: hidden;\n  border: 1px solid rgba(255, 255, 255, .08);\n  background: rgba(0, 0, 0, .25);\n  display: flex; align-items: center; justify-content: center;\n}\n.lc-camp-banner-art {\n  width: 100%; height: 100%;\n  object-fit: cover;\n}\n\n.lc-camp-banner-text {\n  display: flex; flex-direction: column; gap: 6px;\n  min-width: 0;\n}\n\n.lc-camp-banner-head {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 12px;\n}\n.lc-camp-banner-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-camp-banner-status {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 3px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-camp-banner-status-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: #c8c4be;\n}\n.lc-camp-banner-status.is-live          { color: #6ee7b7; border-color: rgba(110, 231, 183, .45); }\n.lc-camp-banner-status.is-live          .lc-camp-banner-status-dot { background: #6ee7b7; box-shadow: 0 0 5px rgba(110, 231, 183, .55); }\n.lc-camp-banner-status.is-coming_soon   { color: #fbbf24; border-color: rgba(251, 191, 36, .45); }\n.lc-camp-banner-status.is-coming_soon   .lc-camp-banner-status-dot { background: #fbbf24; }\n.lc-camp-banner-status.is-funded        { color: #7fd9e8; border-color: rgba(7, 199, 224, .45); }\n.lc-camp-banner-status.is-funded        .lc-camp-banner-status-dot { background: #7fd9e8; }\n\n.lc-camp-banner-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 24px; letter-spacing: -.018em;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-camp-banner-sub {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13.5px; line-height: 1.5;\n  color: #d8d4cd;\n  margin: 0;\n}\n\n.lc-camp-banner-meta {\n  display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11px; letter-spacing: .06em;\n  color: #b1aea8;\n}\n.lc-camp-banner-payout {\n  font-size: 14px; font-weight: 700;\n  color: #6ee7b7;\n  letter-spacing: -.01em;\n}\n.lc-camp-banner-pool { color: #d8d4cd; }\n.lc-camp-banner-deadline { color: #ffa3d0; text-transform: uppercase; letter-spacing: .14em; font-size: 10px; }\n.lc-camp-banner-dot { color: #555; }\n\n.lc-camp-banner-cta-wrap {\n  display: flex; align-items: center; justify-content: flex-end;\n}\n.lc-camp-banner-cta {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 13px;\n  padding: 10px 20px;\n  border-radius: 9999px;\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  color: white;\n  border: 1px solid rgba(255, 26, 140, .55);\n  white-space: nowrap;\n}\n\n/* 6N-G · §8 \"via Whop snapshot\" pill on the banner meta row. */\n.lc-camp-banner-snap-pill {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #ffa3d0;\n  padding: 2px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .08);\n  border: 1px solid rgba(255, 102, 184, .3);\n}\n"],["STYLE",{},".lc-camp-filters {\n  display: flex; flex-wrap: wrap; gap: 8px; align-items: center;\n}\n\n.lc-camp-filter-chip {\n  display: inline-flex; align-items: center; gap: 8px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 12px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-camp-filter-chip:hover { color: #f4f1ea; border-color: rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .07); }\n.lc-camp-filter-chip.is-active {\n  background: linear-gradient(135deg, rgba(255, 26, 140, .15), rgba(7, 199, 224, .10));\n  border-color: rgba(255, 102, 184, .65);\n  color: #ffa3d0;\n  box-shadow: 0 0 14px rgba(255, 26, 140, .18);\n}\n.lc-camp-filter-count {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: 18px; height: 16px;\n  padding: 0 5px;\n  border-radius: 9999px;\n  background: rgba(0, 0, 0, .35);\n  border: 1px solid rgba(255, 255, 255, .12);\n  font-size: 9.5px; letter-spacing: .04em;\n  color: #d8d4cd;\n}\n.lc-camp-filter-chip.is-active .lc-camp-filter-count {\n  background: rgba(255, 26, 140, .25);\n  border-color: rgba(255, 102, 184, .55);\n  color: #fff5fb;\n}\n\n/* Per-type active accents */\n.lc-camp-filter-chip.is-clip.is-active          { border-color: rgba(7, 199, 224, .65); color: #c8ecf3; background: rgba(7, 199, 224, .1); }\n.lc-camp-filter-chip.is-coordination.is-active  { border-color: rgba(251, 191, 36, .65); color: #ffe9b0; background: rgba(251, 191, 36, .1); }\n.lc-camp-filter-chip.is-affiliate.is-active     { border-color: rgba(110, 231, 183, .65); color: #c8f3e0; background: rgba(110, 231, 183, .1); }\n.lc-camp-filter-chip.is-submission.is-active    { border-color: rgba(255, 102, 184, .65); color: #ffd0e9; background: rgba(255, 26, 140, .1); }\n"],["STYLE",{},"/* PaywallGate · commitment-point paywall styling. */\n\n.lc-paywall-inline {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n  opacity: 0.85;\n}\n.lc-paywall-inline:hover { opacity: 1; }\n.lc-paywall-inline > :first-child {\n  opacity: 0.6;\n  pointer-events: none;\n}\n.lc-paywall-inline-badge {\n  font-family: sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: #FF1A8C;\n  background: rgba(255, 26, 140, 0.12);\n  border: 1px solid rgba(255, 26, 140, 0.45);\n  padding: 4px 8px;\n  border-radius: 9999px;\n}\n\n.lc-paywall-overlay {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 120px;\n}\n.lc-paywall-overlay-dim {\n  position: absolute;\n  inset: 0;\n  filter: blur(2px) saturate(0.6) brightness(0.55);\n  pointer-events: none;\n  z-index: 1;\n}\n.lc-paywall-overlay-card {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 24px 28px;\n  border-radius: 16px;\n  border: 1px solid rgba(255, 26, 140, 0.6);\n  background: rgba(11, 11, 16, 0.85);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  box-shadow:\n    0 0 18px rgba(255, 26, 140, 0.22),\n    inset 0 0 10px rgba(255, 26, 140, 0.08);\n  max-width: 420px;\n}\n.lc-paywall-card-eb {\n  font-family: sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.16em;\n  color: #FF1A8C;\n}\n.lc-paywall-card-title {\n  font-family: sans-serif;\n  font-size: 20px;\n  font-weight: 700;\n  color: #F4F1EA;\n  line-height: 1.2;\n}\n.lc-paywall-card-body {\n  font-family: sans-serif;\n  font-size: 13px;\n  color: rgba(244, 241, 234, 0.7);\n  line-height: 1.4;\n}\n.lc-paywall-card-cta {\n  margin-top: 4px;\n  padding: 10px 18px;\n  border-radius: 9999px;\n  border: 1px solid #FF1A8C;\n  background: #FF1A8C;\n  color: #FFFFFF;\n  font-family: sans-serif;\n  font-size: 13px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  cursor: pointer;\n  box-shadow: 0 0 12px rgba(255, 26, 140, 0.4);\n  transition: background 0.15s ease-out, box-shadow 0.15s ease-out;\n}\n.lc-paywall-card-cta:hover {\n  background: #FF3DA5;\n  box-shadow: 0 0 18px rgba(255, 26, 140, 0.6);\n}\n.lc-paywall-card-sim {\n  font-family: monospace;\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: rgba(244, 241, 234, 0.35);\n}\n\n/* 2026-06-23 · checkout_failed visual surface.\n   Shown when billing.lastCheckoutFailed is true · single tag, not a\n   modal · user retries via the same Upgrade CTA. */\n\n.lc-paywall-card-checkout-failed {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 10px;\n  border-radius: 6px;\n  background: rgba(248, 113, 113, 0.10);\n  border: 1px solid rgba(248, 113, 113, 0.35);\n  font-family: monospace;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: #F87171;\n  margin-bottom: 8px;\n}\n\n.lc-paywall-inline-checkout-failed {\n  display: block;\n  margin-top: 4px;\n  font-family: monospace;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  color: #F87171;\n  text-transform: uppercase;\n}\n"],["STYLE",{},".lc-step-body {\n  display: flex; flex-direction: column; gap: 16px;\n  padding: 4px 0;\n}\n.lc-step-head { display: flex; flex-direction: column; gap: 4px; }\n.lc-step-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 800; font-size: 20px; letter-spacing: -.014em;\n  color: #f4f1ea; margin: 0;\n}\n.lc-step-sub {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; line-height: 1.5; color: #b1aea8; margin: 0;\n}\n\n/* Two-option layout · Step 1 */\n.lc-step-options {\n  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;\n}\n@media (max-width: 760px) { .lc-step-options { grid-template-columns: 1fr; } }\n.lc-step-option {\n  padding: 16px 18px !important;\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-step-option-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase; color: #ff66b8;\n}\n.lc-step-option-h {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 15px; color: #f4f1ea; margin: 0;\n}\n.lc-step-option-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5; color: #b1aea8; margin: 0;\n}\n.lc-step-option-note {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .12em;\n  color: #86837e; margin-top: 4px;\n}\n.lc-step-option.is-create {\n  border-color: rgba(7, 199, 224, .35) !important;\n  background: rgba(7, 199, 224, .04) !important;\n}\n\n.lc-step-input-row {\n  display: flex; gap: 6px; align-items: center;\n}\n.lc-step-input {\n  flex: 1;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 12.5px;\n  background: rgba(0, 0, 0, .35);\n  border: 1px solid rgba(255, 255, 255, .15);\n  border-radius: 8px;\n  padding: 9px 12px;\n  color: #f4f1ea;\n  color-scheme: dark;\n}\n.lc-step-input:focus {\n  outline: none;\n  border-color: rgba(255, 26, 140, .55);\n  box-shadow: 0 0 0 2px rgba(255, 26, 140, .15);\n}\n.lc-step-textarea {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; line-height: 1.5;\n  background: rgba(0, 0, 0, .35);\n  border: 1px solid rgba(255, 255, 255, .15);\n  border-radius: 8px;\n  padding: 10px 12px;\n  color: #f4f1ea;\n  resize: vertical;\n  min-height: 90px;\n}\n.lc-step-textarea:focus {\n  outline: none;\n  border-color: rgba(255, 26, 140, .55);\n  box-shadow: 0 0 0 2px rgba(255, 26, 140, .15);\n}\n\n.lc-step-paste {\n  display: inline-flex; align-items: center; gap: 5px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 8px 12px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .15);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n  white-space: nowrap;\n}\n.lc-step-paste:hover {\n  color: #f4f1ea;\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n}\n.lc-step-paste.is-pasted {\n  color: #6ee7b7;\n  border-color: rgba(110, 231, 183, .55);\n  background: rgba(110, 231, 183, .08);\n}\n\n.lc-step-cta-primary {\n  align-self: flex-start;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 650; font-size: 12.5px;\n  padding: 9px 18px;\n  border-radius: 9999px;\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  border: 1px solid rgba(255, 26, 140, .55);\n  color: white;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-cta-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 22px rgba(255, 26, 140, .3);\n}\n.lc-step-cta-primary:disabled { opacity: .4; cursor: not-allowed; }\n\n.lc-step-result { margin-top: 8px; }\n\n/* Form fields · steps 2-7 */\n.lc-step-field {\n  display: flex; flex-direction: column; gap: 6px;\n}\n.lc-step-label {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase; color: #86837e;\n}\n.lc-step-hint {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 11.5px; color: #86837e;\n}\n.lc-step-hint strong { color: #ffa3d0; font-weight: 700; }\n\n.lc-step-type-row, .lc-step-tier-row, .lc-step-platform-row {\n  display: flex; gap: 6px; flex-wrap: wrap;\n}\n.lc-step-type-chip, .lc-step-tier-chip, .lc-step-platform-chip {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 12px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  cursor: pointer;\n}\n.lc-step-type-chip.is-active, .lc-step-tier-chip.is-active {\n  background: linear-gradient(135deg, rgba(255, 26, 140, .15), rgba(7, 199, 224, .10));\n  border-color: rgba(255, 102, 184, .65);\n  color: #ffa3d0;\n}\n.lc-step-platform-chip { color: #7fd9e8; background: rgba(7, 199, 224, .08); border-color: rgba(7, 199, 224, .35); }\n\n.lc-step-banner-grid {\n  display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px;\n}\n.lc-step-banner {\n  display: flex; flex-direction: column; gap: 4px;\n  padding: 4px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .03);\n  border: 1px solid rgba(255, 255, 255, .08);\n  cursor: pointer;\n}\n.lc-step-banner img {\n  width: 100%; height: 80px; object-fit: cover;\n  border-radius: 6px;\n}\n.lc-step-banner span {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase; color: #c8c4be;\n  text-align: center;\n}\n.lc-step-banner.is-selected {\n  border-color: rgba(255, 102, 184, .65);\n  background: rgba(255, 26, 140, .08);\n}\n\n.lc-step-channels {\n  display: flex; flex-direction: column; gap: 6px;\n}\n.lc-step-channel {\n  display: flex; justify-content: space-between; align-items: center;\n  padding: 10px 12px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .03);\n  border: 1px solid rgba(255, 255, 255, .08);\n  cursor: pointer;\n}\n.lc-step-channel.is-selected {\n  border-color: rgba(255, 102, 184, .65);\n  background: rgba(255, 26, 140, .08);\n}\n.lc-step-channel-name {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; color: #f4f1ea;\n}\n.lc-step-channel-tier {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase; color: #86837e;\n}\n\n.lc-step-link-list {\n  display: flex; flex-direction: column; gap: 6px;\n}\n.lc-step-link-row {\n  display: flex; gap: 8px; align-items: center;\n  padding: 8px 12px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px solid rgba(255, 255, 255, .06);\n}\n.lc-step-link-type {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase; padding: 3px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n}\n.lc-step-link-type.is-google_drive { color: #6ee7b7; border-color: rgba(110, 231, 183, .45); }\n.lc-step-link-type.is-dropbox      { color: #7fd9e8; border-color: rgba(7, 199, 224, .45); }\n.lc-step-link-type.is-whop         { color: #ffa3d0; border-color: rgba(255, 102, 184, .45); }\n.lc-step-link-type.is-upload_note  { color: #fbbf24; border-color: rgba(251, 191, 36, .45); }\n.lc-step-link-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; color: #f4f1ea;\n}\n.lc-step-link-required {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase; padding: 2px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .1);\n  border: 1px solid rgba(255, 102, 184, .55);\n  color: #ffa3d0;\n}\n\n.lc-step-review-grid {\n  display: flex; flex-direction: column; gap: 6px;\n  padding: 12px 14px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px solid rgba(255, 255, 255, .08);\n}\n.lc-step-review-row {\n  display: grid; grid-template-columns: 130px 1fr; gap: 10px;\n}\n.lc-step-review-label {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  text-transform: uppercase; color: #86837e;\n}\n.lc-step-review-value {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px; color: #f4f1ea;\n}\n\n.lc-step-publish-errors {\n  display: flex; flex-direction: column; gap: 6px;\n  padding: 12px 14px;\n  border-radius: 12px;\n  background: rgba(255, 139, 139, .08);\n  border: 1px solid rgba(255, 139, 139, .45);\n}\n.lc-step-publish-errors-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase; color: #ff8b8b;\n}\n.lc-step-publish-errors ul {\n  list-style: disc; padding-left: 20px; margin: 0;\n}\n.lc-step-publish-errors li {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; color: #f4f1ea;\n}\n\n.lc-step-foot { display: flex; justify-content: flex-end; padding-top: 4px; }\n.lc-step-loading, .lc-step-empty, .lc-step-error {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; color: #b1aea8;\n  padding: 14px 16px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, .02);\n  border: 1px dashed rgba(255, 255, 255, .12);\n}\n.lc-step-error { color: #ff8b8b; background: rgba(255, 139, 139, .06); border-color: rgba(255, 139, 139, .35); border-style: solid; }\n\n/* ───── URL-first patch (6N-E correction §8) ───────────────────────── */\n\n/* Validate + \"Use this URL anyway\" co-equal pair · neither path is a\n   failure; the second simply skips bonus enrichment. */\n.lc-step-cta-row {\n  display: flex; flex-wrap: wrap; gap: 8px; align-items: center;\n}\n.lc-step-cta-secondary {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11px; letter-spacing: .12em;\n  text-transform: uppercase;\n  padding: 9px 16px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .25);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-cta-secondary:hover:not(:disabled) {\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .4);\n  color: #f4f1ea;\n}\n.lc-step-cta-secondary:disabled { opacity: .45; cursor: not-allowed; }\n\n/* \"Mirror the Whop reward rules\" subsection on Step 2 */\n.lc-step-mirror {\n  display: flex; flex-direction: column; gap: 6px;\n  padding: 12px 14px;\n  border-radius: 10px;\n  background: rgba(255, 102, 184, .05);\n  border: 1px solid rgba(255, 102, 184, .28);\n}\n.lc-step-mirror-head {\n  display: flex; justify-content: space-between; align-items: center;\n  gap: 10px; flex-wrap: wrap;\n}\n.lc-step-mirror-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-step-mirror-link {\n  display: inline-flex; align-items: center; gap: 4px;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  text-transform: uppercase;\n  padding: 5px 12px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .08);\n  border: 1px solid rgba(255, 102, 184, .35);\n  color: #ffa3d0;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-mirror-link:hover {\n  background: rgba(255, 102, 184, .14);\n  color: #ffd0e7;\n  border-color: rgba(255, 102, 184, .55);\n}\n.lc-step-mirror-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12.5px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n\n/* ───── P1-4 · Step 4 brief-link inline CRUD ─────────────────────── */\n\n.lc-step-bl-add {\n  padding: 14px 16px !important;\n  display: flex; flex-direction: column; gap: 12px;\n}\n.lc-step-bl-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: #ffa3d0;\n}\n.lc-step-bl-row-grid {\n  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\n}\n@media (max-width: 720px) { .lc-step-bl-row-grid { grid-template-columns: 1fr; } }\n.lc-step-bl-field {\n  display: flex; flex-direction: column; gap: 4px;\n}\n.lc-step-bl-label {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #86837e;\n}\n.lc-step-bl-chip-row {\n  display: flex; flex-wrap: wrap; gap: 5px;\n}\n.lc-step-bl-chip {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  text-transform: uppercase;\n  padding: 5px 11px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-bl-chip:hover {\n  background: rgba(255, 255, 255, .08);\n  color: #f4f1ea;\n}\n.lc-step-bl-chip.is-active {\n  background: rgba(255, 26, 140, .12);\n  border-color: rgba(255, 26, 140, .5);\n  color: #ffa3d0;\n}\n\n.lc-step-bl-toggle {\n  align-self: flex-start;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 6px 12px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-bl-toggle.is-on {\n  background: rgba(255, 26, 140, .12);\n  border-color: rgba(255, 26, 140, .5);\n  color: #ffa3d0;\n}\n\n.lc-step-bl-error {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12px;\n  color: #ff8b8b;\n  margin: 0;\n  padding: 6px 10px;\n  border-left: 3px solid rgba(255, 139, 139, .5);\n  background: rgba(255, 139, 139, .05);\n  border-radius: 4px;\n}\n\n.lc-step-bl-list {\n  display: flex; flex-direction: column; gap: 8px;\n}\n.lc-step-bl-row {\n  padding: 12px 14px !important;\n  display: flex; flex-direction: column; gap: 6px;\n}\n.lc-step-bl-row.is-editing {\n  border-color: rgba(255, 26, 140, .4) !important;\n  background: rgba(255, 26, 140, .04) !important;\n}\n.lc-step-bl-row-head {\n  display: flex; flex-wrap: wrap; gap: 6px; align-items: center;\n}\n.lc-step-bl-type-pill,\n.lc-step-bl-required-pill,\n.lc-step-bl-vis-pill {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .14em;\n  text-transform: uppercase;\n  padding: 2px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n}\n.lc-step-bl-type-pill.is-google_drive { color: #7fd9e8; border-color: rgba(7, 199, 224, .35); background: rgba(7, 199, 224, .08); }\n.lc-step-bl-type-pill.is-dropbox      { color: #87b7ff; border-color: rgba(135, 183, 255, .35); background: rgba(135, 183, 255, .08); }\n.lc-step-bl-type-pill.is-whop         { color: #ffa3d0; border-color: rgba(255, 102, 184, .35); background: rgba(255, 102, 184, .08); }\n.lc-step-bl-type-pill.is-direct_url   { color: #c8c4be; }\n.lc-step-bl-type-pill.is-upload_note  { color: #fbbf24; border-color: rgba(251, 191, 36, .35); background: rgba(251, 191, 36, .08); }\n.lc-step-bl-required-pill { color: #ffa3d0; border-color: rgba(255, 102, 184, .4); }\n.lc-step-bl-vis-pill.is-joined   { color: #fbbf24; }\n.lc-step-bl-vis-pill.is-approved { color: #6ee7b7; }\n\n.lc-step-bl-row-title {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 14px;\n  color: #f4f1ea;\n  margin: 0;\n}\n.lc-step-bl-row-url {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px;\n  color: #7fd9e8;\n  word-break: break-all;\n}\n.lc-step-bl-row-notes {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12px; line-height: 1.5;\n  color: #b1aea8;\n  margin: 0;\n}\n\n.lc-step-bl-row-actions {\n  display: flex; gap: 4px; flex-wrap: wrap;\n  padding-top: 4px;\n  border-top: 1px dashed rgba(255, 255, 255, .08);\n}\n.lc-step-bl-icon-btn {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, .04);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  cursor: pointer;\n  transition: all .14s;\n}\n.lc-step-bl-icon-btn:hover:not(:disabled) {\n  background: rgba(255, 255, 255, .08);\n  color: #f4f1ea;\n  border-color: rgba(255, 255, 255, .3);\n}\n.lc-step-bl-icon-btn:disabled {\n  opacity: .35;\n  cursor: not-allowed;\n}\n.lc-step-bl-icon-btn.is-danger {\n  color: #ff8b8b;\n  border-color: rgba(255, 139, 139, .3);\n}\n.lc-step-bl-icon-btn.is-danger:hover:not(:disabled) {\n  background: rgba(255, 139, 139, .1);\n  color: #ffd0d0;\n  border-color: rgba(255, 139, 139, .55);\n}\n"],["STYLE",{},".lc-acf {\n  display: flex; flex-direction: column; gap: 16px;\n}\n\n.lc-acf-steps {\n  display: flex; gap: 4px; overflow-x: auto;\n  list-style: none; margin: 0; padding: 0 0 8px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, .06);\n}\n.lc-acf-step button {\n  display: inline-flex; align-items: center; gap: 6px;\n  padding: 6px 10px;\n  background: transparent;\n  border: none;\n  color: #86837e;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: color .14s;\n}\n.lc-acf-step button:disabled { cursor: not-allowed; opacity: .5; }\n.lc-acf-step-n {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 20px; height: 20px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, .06);\n  border: 1px solid rgba(255, 255, 255, .14);\n  color: #c8c4be;\n  font-size: 10px;\n}\n.lc-acf-step.is-current button { color: #ffa3d0; }\n.lc-acf-step.is-current .lc-acf-step-n {\n  background: rgba(255, 26, 140, .15);\n  border-color: rgba(255, 102, 184, .65);\n  color: #ffa3d0;\n}\n.lc-acf-step.is-done button { color: #7fd9e8; }\n.lc-acf-step.is-done .lc-acf-step-n {\n  background: rgba(7, 199, 224, .12);\n  border-color: rgba(7, 199, 224, .45);\n  color: #7fd9e8;\n}\n\n.lc-acf-body {\n  min-height: 320px;\n}\n\n.lc-acf-foot {\n  display: flex; gap: 10px; align-items: center;\n  padding-top: 8px;\n  border-top: 1px solid rgba(255, 255, 255, .06);\n}\n.lc-acf-foot .lc-acf-btn-primary { margin-left: auto; }\n\n.lc-acf-btn-quiet, .lc-acf-btn-primary {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 650; font-size: 12.5px;\n  padding: 9px 18px;\n  border-radius: 9999px;\n  cursor: pointer;\n  transition: all .14s;\n  border: 1px solid rgba(255, 255, 255, .15);\n  background: rgba(255, 255, 255, .04);\n  color: #c8c4be;\n}\n.lc-acf-btn-quiet:hover:not(:disabled) {\n  color: #f4f1ea;\n  background: rgba(255, 255, 255, .08);\n  border-color: rgba(255, 255, 255, .3);\n}\n.lc-acf-btn-quiet:disabled { opacity: .4; cursor: not-allowed; }\n\n.lc-acf-btn-primary {\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  border-color: rgba(255, 26, 140, .55);\n  color: white;\n}\n.lc-acf-btn-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 22px rgba(255, 26, 140, .3);\n}\n.lc-acf-btn-primary:disabled { opacity: .4; cursor: not-allowed; }\n"],["STYLE",{},"/* BUG-031 Patch C · `max-width: calc(100vw - 460px)` removed. The cap was a\n   UI-1 reading-column compromise from when the editor lived in a sidebar.\n   With the cockpit docked at the bottom (UI-2), the cap floats content in\n   the centre of the viewport and creates the dead bands Daniel called out.\n   Stage now fills the `1fr` content column of `.lc-app` (244px nav + 1fr\n   — see AppShell.css:11). Home (CommandRoom) does NOT use .sim-stage so\n   its card grid is untouched. .sim-welcome / .sim-sub caps below preserve\n   paragraph readability. */\n.sim-stage { display: flex; flex-direction: column; gap: 26px; }\n\n/* Runtime-honesty tag rendered inline with the route eyebrow.\n   Mock-pipeline routes show \"Engine preview\" so users never mistake mock\n   progress for production reality. */\n.lc-runtime-tag {\n  display: inline-block;\n  margin-left: 10px;\n  padding: 2px 9px;\n  border-radius: 9999px;\n  background: rgba(245, 158, 11, .14);\n  border: 1px solid rgba(245, 158, 11, .4);\n  color: #fbbf24;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  vertical-align: 1px;\n}\n/* Live · backend variant · cyan/green palette so users see at-a-glance\n   when the route is reading from a real endpoint rather than mock. */\n.lc-runtime-tag.is-live {\n  background: rgba(110, 231, 183, .1);\n  border-color: rgba(110, 231, 183, .45);\n  color: #6ee7b7;\n}\n\n.sim-welcome { display: flex; flex-direction: column; gap: 8px; padding: 4px 4px 12px; max-width: 1100px; }\n.sim-eb { font-family: \"Geist Mono\", ui-monospace, monospace; font-size: 11px; letter-spacing: .15em; color: #86837e; text-transform: uppercase; }\n.sim-h1 {\n  margin: 0;\n  /* LC-UI-P0-BOOT · Patch B · 2026-06-26\n   * Was: 80px / .98 / -.038em — that computed to -3.04px tracking at\n   * 80px which squashed every glyph and made the auth heading look\n   * compressed at all widths. App-scale headings should use neutral\n   * tracking (0). Size is now a responsive clamp so narrow widths get\n   * 42px and wide widths cap at 64px instead of overflowing at 80px. */\n  font-weight: 800;\n  font-size: clamp(42px, 6vw, 64px);\n  line-height: 1.05;\n  letter-spacing: 0;\n  background: linear-gradient(180deg, #ffffff 0%, #d8d4ce 70%, #b6b2ac 100%);\n  -webkit-background-clip: text; background-clip: text; color: transparent;\n}\n.sim-sub { color: #c8c4be; margin: 4px 0 0; font-size: 14.5px; max-width: 580px; }\n\n.sim-section-h { margin: 0 0 14px; font-size: 18px; font-weight: 700; letter-spacing: -.015em; color: #f4f1ea; }\n\n.sim-states { padding: 8px 4px 0; }\n\n.sim-state-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }\n.sim-state {\n  background: rgba(14, 14, 22, .62);\n  border: 1px solid rgba(255, 255, 255, .13);\n  border-radius: 14px;\n  padding: 14px 12px;\n  display: flex; flex-direction: column; gap: 6px;\n  min-height: 160px;\n  -webkit-backdrop-filter: blur(14px) saturate(140%);\n          backdrop-filter: blur(14px) saturate(140%);\n}\n.sim-state-lbl {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  color: var(--lc-state-tone, #86837e);\n}\n.sim-state-title { font-size: 14px; font-weight: 600; color: #f4f1ea; letter-spacing: -.01em; }\n.sim-state-body  { font-size: 12px; line-height: 1.5; color: #c8c4be; }\n\n.sim-tone-fx     { --lc-state-tone: #ff1a8c; }\n.sim-tone-fxd    { --lc-state-tone: #ff66b8; }\n.sim-tone-amber  { --lc-state-tone: #f59e0b; }\n.sim-tone-danger { --lc-state-tone: #dc2626; }\n.sim-tone-dim    { --lc-state-tone: #86837e; }\n\n.sim-tone-fx     { border-color: rgba(255,26,140,.32); }\n.sim-tone-fxd    { border-color: rgba(255,102,184,.28); }\n.sim-tone-amber  { border-color: rgba(245,158,11,.32); }\n.sim-tone-danger { border-color: rgba(220,38,38,.32); }\n\n/* Key panel — the single \"what this route is for\" tile per stub. */\n.sim-key {\n  padding: 20px 24px 22px;\n  display: flex; flex-direction: column; gap: 12px;\n  align-self: flex-start;\n  min-width: 320px; max-width: 560px;\n}\n.sim-key-head { display: flex; align-items: center; justify-content: space-between; }\n.sim-key-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .18em;\n  color: #ff66b8;\n  text-transform: uppercase;\n}\n.sim-key-tag {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9px; letter-spacing: .18em;\n  padding: 3px 8px;\n  border-radius: 9999px;\n  background: rgba(255, 26, 140, .14);\n  color: #ff66b8;\n  text-transform: uppercase;\n}\n.sim-key-headline {\n  font-weight: 800; font-size: 34px; line-height: 1.05; letter-spacing: -.022em;\n  color: #f4f1ea;\n  margin-top: 2px;\n}\n.sim-key-sub { margin: 0; color: #c8c4be; font-size: 13px; line-height: 1.5; }\n.sim-key-chips { display: flex; gap: 6px; flex-wrap: wrap; }\n.sim-key-chip {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .12em;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, .06);\n  border: 1px solid rgba(255, 255, 255, .12);\n  color: #c8c4be;\n  text-transform: uppercase;\n}\n.sim-key-bar {\n  height: 6px; border-radius: 4px;\n  background: rgba(255, 255, 255, .07);\n  overflow: hidden;\n}\n.sim-key-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #ff1a8c 0%, #ff66b8 100%);\n  box-shadow: 0 0 12px rgba(255, 26, 140, .55);\n}\n\n/* Micro strip */\n.sim-micro { padding: 18px 22px; display: flex; flex-direction: column; gap: 12px; }\n.sim-micro-sub { color: #c8c4be; font-size: 13px; margin: 0; }\n.sim-micro-row { display: flex; gap: 8px; flex-wrap: wrap; }\n\n.sim-btn {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600; font-size: 13px;\n  padding: 10px 14px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 255, 255, .13);\n  background: rgba(20, 20, 28, .55);\n  color: #f4f1ea;\n  cursor: pointer;\n  transition: all .22s cubic-bezier(.2, .7, .2, 1);\n}\n.sim-btn:hover {\n  transform: translateY(-1px);\n  border-color: rgba(255, 26, 140, .55);\n  box-shadow: 0 0 0 1px rgba(255, 26, 140, .35), 0 10px 28px rgba(255, 26, 140, .18);\n}\n.sim-btn:disabled { opacity: .5; cursor: not-allowed; }\n"],["STYLE",{},".lc-campaigns-stage {\n  gap: 14px;\n  padding: 0 clamp(16px, 2.5vw, 32px) 72px;\n}\n\n.lc-campaigns-stage .lc-route-head {\n  justify-content: space-between;\n  margin-bottom: 2px;\n}\n\n.lc-campaigns-heading {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  min-width: 0;\n}\n\n.lc-campaigns-heading-copy {\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.lc-campaigns-tier-tag {\n  display: inline-block;\n  margin-left: 8px;\n  padding: 2px 9px;\n  border-radius: 9999px;\n  background: rgba(7, 199, 224, .14);\n  border: 1px solid rgba(7, 199, 224, .4);\n  color: #7fd9e8;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  vertical-align: 1px;\n}\n.lc-campaigns-count-tag {\n  display: inline-block;\n  margin-left: 8px;\n  padding: 2px 9px;\n  border-radius: 9999px;\n  background: rgba(255, 102, 184, .1);\n  border: 1px solid rgba(255, 102, 184, .35);\n  color: #ffa3d0;\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 9.5px; letter-spacing: .14em;\n  text-transform: uppercase;\n  vertical-align: 1px;\n}\n\n.lc-campaigns-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 14px;\n}\n\n.lc-campaigns-loading {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11px; letter-spacing: .12em;\n  color: #86837e;\n  text-align: center;\n  padding: 60px 0;\n}\n\n.lc-campaigns-empty {\n  display: flex; flex-direction: column; gap: 6px;\n  padding: 28px 24px;\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--color-paper) 82%, transparent);\n  border: 1px solid color-mix(in srgb, var(--color-fuchsia-deep) 24%, transparent);\n  -webkit-backdrop-filter: blur(12px);\n          backdrop-filter: blur(12px);\n}\n.lc-campaigns-empty-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10px; letter-spacing: .2em;\n  text-transform: uppercase;\n  color: var(--color-fuchsia-deep);\n}\n.lc-campaigns-empty-body {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 13px;\n  color: var(--color-text-secondary);\n  max-width: 680px;\n}\n\n.lc-campaigns-retry {\n  align-self: flex-start;\n  margin-top: 8px;\n  padding: 8px 14px;\n  border-radius: 8px;\n  border: 1px solid color-mix(in srgb, var(--color-fuchsia) 55%, transparent);\n  background: color-mix(in srgb, var(--color-fuchsia) 14%, transparent);\n  color: var(--color-ink);\n  font: 700 12px/1 var(--font-sans);\n  cursor: pointer;\n}\n.lc-campaigns-retry:hover {\n  background: color-mix(in srgb, var(--color-fuchsia) 25%, transparent);\n}\n\n/* The owned activation reward is a useful campaign, not a page hero. */\n.lc-campaigns-sponsored-slot {\n  max-width: 680px;\n}\n.lc-campaigns-sponsored-slot .lc-src-body {\n  display: grid;\n  grid-template-columns: 240px minmax(0, 1fr);\n}\n.lc-campaigns-sponsored-slot .lc-src-banner {\n  aspect-ratio: auto;\n  min-height: 190px;\n}\n.lc-campaigns-sponsored-slot .lc-src-meta {\n  justify-content: center;\n}\n\n@media (max-width: 820px) {\n  .lc-campaigns-heading {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .lc-campaigns-sponsored-slot .lc-src-body {\n    grid-template-columns: 1fr;\n  }\n  .lc-campaigns-sponsored-slot .lc-src-banner {\n    min-height: 170px;\n  }\n}\n\n/* Phase 6N-E v1 · floating Create-campaign CTA (agency tier only). */\n.lc-campaigns-create-cta {\n  position: fixed;\n  bottom: 28px;\n  right: 28px;\n  z-index: 50;\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700; font-size: 13.5px;\n  padding: 12px 22px;\n  border-radius: 9999px;\n  background: linear-gradient(135deg, #ff1a8c 0%, #c70066 55%, #ff66b8 100%);\n  border: 1px solid rgba(255, 26, 140, .55);\n  color: white;\n  cursor: pointer;\n  transition: all .14s;\n  box-shadow: 0 12px 28px rgba(255, 26, 140, .35);\n}\n.lc-campaigns-create-cta:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 16px 36px rgba(255, 26, 140, .45);\n}\n/* P1-1G-c · locked state · agency tier without trusted source.\n * Visible to the user with explanatory title attribute · cannot click. */\n.lc-campaigns-create-cta.is-locked,\n.lc-campaigns-create-cta:disabled {\n  background: rgba(255, 255, 255, .06);\n  border-color: rgba(255, 255, 255, .2);\n  color: #b1aea8;\n  cursor: not-allowed;\n  box-shadow: none;\n  transform: none;\n}\n.lc-campaigns-create-cta.is-locked:hover,\n.lc-campaigns-create-cta:disabled:hover {\n  transform: none;\n  box-shadow: none;\n  background: rgba(255, 255, 255, .06);\n}\n\n/* ============================================================\n   UI-3 · Agency manage strip\n   ============================================================ */\n.lc-camp-manage {\n  border: 1px solid rgba(255, 26, 140, .25);\n  background: rgba(16, 12, 22, .55);\n  border-radius: 14px;\n  padding: 16px 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.lc-camp-manage-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n}\n.lc-camp-manage-eb {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 11px;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  color: #ff66b8;\n}\n.lc-camp-manage-sub {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-size: 12px;\n  color: var(--soft, #c8c4be);\n}\n.lc-camp-manage-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.lc-camp-manage-row {\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 14px;\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, .06);\n  background: rgba(8, 6, 12, .35);\n}\n.lc-camp-manage-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n.lc-camp-manage-name {\n  font-family: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  font-weight: 700;\n  font-size: 13.5px;\n  color: #f4f1ea;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.lc-camp-manage-clippers {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--dim, #86837e);\n}\n.lc-camp-manage-invite {\n  font-family: \"Geist Mono\", ui-monospace, monospace;\n  font-size: 10.5px;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  padding: 7px 14px;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 255, 255, .14);\n  background: rgba(20, 16, 28, .55);\n  color: var(--soft, #c8c4be);\n  cursor: pointer;\n  transition: all 160ms ease;\n}\n.lc-camp-manage-invite:hover {\n  color: #f4f1ea;\n  border-color: rgba(255, 26, 140, .45);\n  background: rgba(255, 26, 140, .08);\n}\n\n@media (max-width: 700px) {\n  .lc-camp-manage-row { grid-template-columns: 1fr; align-items: flex-start; }\n}\n"]],[[4,97]],["BODY",{"data-app-mode":"agency","data-design-os":"active"},[[4,98]],["DIV",{"id":"root"},["DIV",{"class":"lc-shell","data-outer-nav":"hidden"},[[2,38]],["MAIN",{"class":"lc-page"},[[2,45]],["DIV",{"class":"lc-canvas"},[[2,46]],["SECTION",{"class":"lc-section","data-route":"home","data-active":"true"},["DIV",{"class":"lc-design-os-boundary"},["DIV",{"class":"lc-app","data-route":"campaigns","data-world":"cockpit-home","data-testid":"app-shell"},[[2,47]],[[2,53]],[[1,4]],["SECTION",{"class":"lc-main"},[[2,121]],[[2,154]],["DIV",{"class":"lc-scroll"},["DIV",{"class":"sim-stage lc-campaigns-stage","data-testid":"campaigns-stage","data-campaigns-source":"mock","data-campaigns-visible-count":"0","data-campaigns-featured-count":"0","style":"opacity: 1;"},["DIV",{"class":"lc-route-head","data-kade-anchor":"true","data-route-title":"Mission pedestal room"},["DIV",{"class":"lc-campaigns-heading"},["H1",{"class":"lc-route-head-eb"},"Campaigns"],["SPAN",{"class":"lc-campaigns-heading-copy"},"Browse paid Content Rewards or manage campaigns you own."]],["DIV",{"class":"lc-route-head-pills"},["SPAN",{"data-testid":"campaigns-source-pill","data-source":"mock","class":"lc-runtime-tag","title":"Campaigns backend not reachable · install the desktop app or wire a backend URL to see real campaigns.","style":"text-transf