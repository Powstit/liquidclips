# Clerk auth + billing (Liquid Clips production)
# Copy to .env.local for local dev. Set on Vercel for production.

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk billing plan IDs — defaults are pinned in PricingCards.tsx, but
# overriding here lets Vercel swap to test-mode plans without a redeploy.
# Confirm the IDs match the live plans in https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_SOLO_PLAN_ID=cplan_3E4VBeiWtZP0CJsvPwrIz91uDFk
NEXT_PUBLIC_CLERK_PRO_PLAN_ID=cplan_3EV9Jjn8qLG130iSSRpAUOmqAfm
NEXT_PUBLIC_CLERK_AGENCY_PLAN_ID=cplan_3E4VBfKWkQlIuYRQG0YE5LfJPjx
NEXT_PUBLIC_CLERK_ACCOUNT_PACK_PLAN_ID=cplan_3EV9znSsguzmwoQoEr5kXpumkfM

# Junior Backend (license issuance + tier resolution)
NEXT_PUBLIC_JUNIOR_BACKEND_URL=https://api.jnremployee.com

# Optional: PostHog (signup funnel telemetry)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# HQ — Agent lane API keys (source of truth for bug-command-centre only).
# Leave empty for local dev. The UI shows Configured / Missing — never the value.
# Do not commit real secrets.
KIMI_AUTH_AGENT_API_KEY=
KIMI_PROJECTS_AGENT_API_KEY=
KIMI_EARN_AGENT_API_KEY=
KIMI_UI_AGENT_API_KEY=
OPENAI_CODEX_AGENT_API_KEY=
CLAUDE_AGENT_API_KEY=
HQ_INTERNAL_SECRET=

# HQ — Security Gate (IRON GATE IG-HQ-001 in middleware.ts).
# Both are CSVs and BOTH are required for the admin surface to be reachable.
# ADMIN_ALLOWED_IPS: comma-separated list of IPs Vercel sees on `x-forwarded-for`
#   first hop. An empty value locks /admin/* and /api/admin/* out entirely.
# ADMIN_MASTER_EMAILS: comma-separated list of 5 master admin emails. Used by
#   the security landing AND by the recovery flow (Agent 5).
ADMIN_ALLOWED_IPS=  # e.g. 203.0.113.42,198.51.100.7
ADMIN_MASTER_EMAILS=  # e.g. a@x.com,b@x.com,c@x.com,d@x.com,e@x.com
